<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        x:Class="GitExtensions.Xplat.App.CreateBranchWindow"
        Title="Create branch"
        Width="570" SizeToContent="Height" MinWidth="570" WindowStartupLocation="CenterOwner" CanResize="True">
  <!-- Upstream's FormCreateBranch (a GitExtensionsDialog): the name, the commit with its summary, checkout after create and
       the orphan options; Create branch in the strip at the bottom. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CreateButton" MinWidth="107" IsDefault="True" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Image Source="{local:UpstreamImage BranchCreate}" Width="16" Height="16" />
            <AccessText Text="_Create branch" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Grid Margin="12" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <AccessText Text="_Branch name" VerticalAlignment="Center" Margin="3" />
      <TextBox x:Name="BranchNameBox" Grid.Column="1" Margin="3" />
      <AccessText x:Name="CreateAtLabel" Grid.Row="1" Text="Create b_ranch at this revision" VerticalAlignment="Center"
                  Margin="3" TextWrapping="Wrap" />
      <!-- Upstream's CommitPickerSmallControl: the commit's hash and how far it is from HEAD. -->
      <StackPanel x:Name="CommitPicker" Grid.Row="1" Grid.Column="1" Margin="3" Orientation="Horizontal"
                  VerticalAlignment="Center">
        <TextBox x:Name="CommitHashBox" Width="104" VerticalContentAlignment="Center" />
        <TextBlock x:Name="CommitCountText" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <CheckBox x:Name="CheckoutAfterCreateCheck" Grid.Row="2" Grid.Column="1" Content="Checkout _after create" Margin="3" />
      <!-- Upstream's CommitSummaryUserControl. -->
      <HeaderedContentControl x:Name="SummaryGroup" Grid.Row="3" Grid.ColumnSpan="2" Classes="groupBox" Header="No revision"
                              Margin="3">
        <Grid ColumnDefinitions="103,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock x:Name="AuthorCaption" Text="Author:" Margin="2" />
          <TextBlock x:Name="AuthorText" Grid.Column="1" Text="---" FontWeight="Bold" Margin="2" />
          <TextBlock x:Name="DateCaption" Grid.Row="1" Text="Commit date:" Margin="2" />
          <TextBlock x:Name="DateText" Grid.Row="1" Grid.Column="1" Text="---" Margin="2" />
          <TextBlock x:Name="MessageText" Grid.Row="2" Grid.ColumnSpan="2" Text="---" Margin="2,6" TextWrapping="Wrap"
                     MaxHeight="50" />
          <TextBlock Grid.Row="3" Text="Tag(s):" Margin="2" />
          <Border x:Name="TagsBorder" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="2">
            <TextBlock x:Name="TagsText" Text="---" Margin="2,0" />
          </Border>
          <TextBlock Grid.Row="4" Text="Branch(es):" Margin="2" />
          <Border x:Name="BranchesBorder" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="2">
            <TextBlock x:Name="BranchesText" Text="---" Margin="2,0" />
          </Border>
        </Grid>
      </HeaderedContentControl>
      <HeaderedContentControl x:Name="OrphanGroup" Grid.Row="4" Grid.ColumnSpan="2" Classes="groupBox" Header="Orphan" Margin="3">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox x:Name="CreateOrphanCheck" Content="Create or_phan" />
          <CheckBox x:Name="ClearOrphanCheck" Content="Clear _working directory and index" IsEnabled="False" />
        </StackPanel>
      </HeaderedContentControl>
    </Grid>
  </DockPanel>
</Window>
