<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.RepositoryHosts.CreatePullRequestWindow"
        Title="Create Pull Request"
        Width="640" Height="520" WindowStartupLocation="CenterOwner">
  <!-- Upstream CreatePullRequestForm: the target repository and branches, then the title and body. Texts are named as the
       form's fields, for its translations. -->
  <DockPanel Margin="10">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
      <TextBlock x:Name="label3" Text="Target repository:" VerticalAlignment="Center" />
      <ComboBox x:Name="_pullReqTargetsCB" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock x:Name="label5" Grid.Row="1" Text="Target branch:" VerticalAlignment="Center" />
      <ComboBox x:Name="_remoteBranchesCB" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" />
      <TextBlock x:Name="label4" Grid.Row="2" Text="Your branch:" VerticalAlignment="Center" />
      <ComboBox x:Name="_yourBranchesCB" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" />
    </Grid>
    <Button x:Name="_createBtn" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Create" IsEnabled="False"
            Margin="0,8,0,0" />
    <HeaderedContentControl x:Name="groupBox1" Header="Pull request data" Margin="0,10,0,0">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="8">
        <TextBlock x:Name="label1" Text="Title:" VerticalAlignment="Center" />
        <TextBox x:Name="_titleTB" Grid.Column="1" />
        <TextBlock x:Name="label2" Grid.Row="1" Text="Body:" />
        <TextBox x:Name="_bodyTB" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" />
      </Grid>
    </HeaderedContentControl>
  </DockPanel>
</Window>
