<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExtensions.Xplat.App.CommitSummaryView">
  <!-- Upstream's CommitSummaryUserControl: the short hash as the group's caption, the author, date and message, and the
       commit's tags and branches. -->
  <HeaderedContentControl x:Name="SummaryGroup" Classes="groupBox" Header="No revision">
    <Grid ColumnDefinitions="103,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <TextBlock x:Name="AuthorCaption" Text="Author:" Margin="2" />
      <TextBlock x:Name="AuthorText" Grid.Column="1" Text="---" FontWeight="Bold" Margin="2" />
      <TextBlock x:Name="DateCaption" Grid.Row="1" Text="Commit date:" Margin="2" />
      <TextBlock x:Name="DateText" Grid.Row="1" Grid.Column="1" Text="---" Margin="2" />
      <TextBlock x:Name="MessageText" Grid.Row="2" Grid.ColumnSpan="2" Text="---" Margin="2,6" TextWrapping="Wrap"
                 MaxHeight="50" />
      <TextBlock Grid.Row="3" Text="Tag(s):" Margin="2" />
      <Border x:Name="TagsBorder" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="2">
        <TextBlock x:Name="TagsText" Text="---" Margin="2,0" />
      </Border>
      <TextBlock Grid.Row="4" Text="Branch(es):" Margin="2" />
      <Border x:Name="BranchesBorder" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="2">
        <TextBlock x:Name="BranchesText" Text="---" Margin="2,0" />
      </Border>
    </Grid>
  </HeaderedContentControl>
</UserControl>
