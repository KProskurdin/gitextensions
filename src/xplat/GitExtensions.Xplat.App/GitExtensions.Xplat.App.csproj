<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GitExtensions</AssemblyName>
    <RootNamespace>GitExtensions.Xplat.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The repository turns publishing off for every project; the cross-platform app is published (src/xplat/eng/publish-app.sh). -->
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared xplat props add WinForms/Drawing namespaces to every project; they clash with Avalonia's control names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo lives in setup/ and is linked, not copied, so the upstream asset stays the single source. -->
    <AvaloniaResource Include="..\..\..\setup\assets\Logo\git-extensions-logo-256px.png" Link="Assets\git-extensions-logo-256px.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's theme files, linked into the Themes folder next to the app as upstream ships them (upstream's
         ThemePathProvider looks there), so both apps read the same CSS. -->
    <Content Include="..\..\app\GitUI\Themes\*.css;..\..\app\GitUI\Themes\README.md" Link="Themes\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's translations (Transifex), linked into the Translation folder next to the app as upstream ships them
         (upstream's Translator looks there), for the language chosen in Settings > Appearance. -->
    <Content Include="..\..\app\GitUI\Translation\*.xlf;..\..\app\GitUI\Translation\*.gif" Link="Translation\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitCommands\GitCommands.csproj" />
    <ProjectReference Include="..\GitExtensions.Xplat.Core\GitExtensions.Xplat.Core.csproj" />
    <ProjectReference Include="..\GitExtensions.Xplat.Ui\GitExtensions.Xplat.Ui.csproj" />
    <!-- The GitHub API client of the GitHub plugin, which ships with the app as upstream ships it. -->
    <ProjectReference Include="..\Git.hub\Git.hub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream plugins built for the new shell (src/xplat/plugins). Not referenced by the app: they go into the Plugins
         folder, one subfolder per plugin, where upstream's ManagedExtensibility looks for them. -->
    <ProjectReference Include="..\plugins\BackgroundFetch\GitExtensions.Plugins.BackgroundFetch.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\AutoCompileSubmodules\GitExtensions.Plugins.AutoCompileSubmodules.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\CreateLocalBranches\GitExtensions.Plugins.CreateLocalBranches.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\ProxySwitcher\GitExtensions.Plugins.ProxySwitcher.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\FindLargeFiles\GitExtensions.Plugins.FindLargeFiles.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\DeleteUnusedBranches\GitExtensions.Plugins.DeleteUnusedBranches.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\ReleaseNotesGenerator\GitExtensions.Plugins.ReleaseNotesGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\Gource\GitExtensions.Plugins.Gource.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\GitImpact\GitExtensions.Plugins.GitImpact.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\GitStatistics\GitExtensions.Plugins.GitStatistics.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\GitHub3\GitExtensions.Plugins.GitHub3.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\AppVeyorIntegration\GitExtensions.Plugins.AppVeyorIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\AzureDevOpsIntegration\GitExtensions.Plugins.AzureDevOpsIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\GitHubActionsIntegration\GitExtensions.Plugins.GitHubActionsIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\GitlabIntegration\GitExtensions.Plugins.GitlabIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\JenkinsIntegration\GitExtensions.Plugins.JenkinsIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
    <ProjectReference Include="..\plugins\BuildServerIntegration\TeamCityIntegration\GitExtensions.Plugins.TeamCityIntegration.csproj" ReferenceOutputAssembly="false" OutputItemType="XplatPlugin" />
  </ItemGroup>

  <!-- After the references are built, so their output paths are known; as content they reach the build output, the
       publish folder and the output of projects that reference the app. -->
  <Target Name="AddXplatPlugins" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <ContentWithTargetPath Include="@(XplatPlugin)" TargetPath="Plugins\%(Filename)\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
