<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExtensions.Xplat.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- The first installed family wins: Windows, macOS, then the usual Linux monospace fonts. -->
    <FontFamily x:Key="DiffFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <!-- Fluent's tab headers are sized for touch; the browse window's tabs are a compact strip, as in upstream. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </Application.Styles>
</Application>
