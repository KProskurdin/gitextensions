<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The shared xplat props add WinForms/Drawing namespaces to every project; they clash with Avalonia's control names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <!-- NUnit is raised to the version Avalonia.Headless.NUnit needs in Directory.Build.targets beside this file. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\xplat\GitExtensions.Xplat.App\GitExtensions.Xplat.App.csproj" />
    <ProjectReference Include="..\..\..\src\xplat\GitCommands\GitCommands.csproj" />
  </ItemGroup>

</Project>
