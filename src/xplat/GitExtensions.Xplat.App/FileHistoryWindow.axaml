<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        x:Class="GitExtensions.Xplat.App.FileHistoryWindow"
        Title="File History"
        Width="748" Height="444" MinWidth="299" MinHeight="198" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormFileHistory: the toolstrip (upstream's FilterToolBar, then Load, full history, blame options, git
       command log), the file's revision grid with its menu, and below it the Commit, Diff, View and Blame tabs. -->
  <Grid RowDefinitions="Auto,*,5,*">
    <WrapPanel Orientation="Horizontal" Margin="2">
      <local:FilterToolBar x:Name="ToolStripFilters" />
      <Rectangle Classes="toolSeparator" />
      <SplitButton x:Name="LoadButton" Classes="tool" ToolTip.Tip="Load file history">
        <Image Source="{local:UpstreamImage ReloadRevisions}" Width="16" Height="16" />
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem x:Name="LoadHistoryOnShowMenuItem" Header="Load history on show" ToggleType="CheckBox" />
            <MenuItem x:Name="LoadBlameOnShowMenuItem" Header="Load blame on show" ToggleType="CheckBox" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <DropDownButton x:Name="FullHistoryButton" Classes="tool" ToolTip.Tip="Show Full History">
        <Image Source="{local:UpstreamImage FileHistory}" Width="16" Height="16" />
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem x:Name="ShowFullHistoryMenuItem" Header="Show full history" ToggleType="CheckBox" />
            <MenuItem x:Name="SimplifyMergesMenuItem" Header="Simplify merges" ToggleType="CheckBox" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton x:Name="BlameOptionsButton" Classes="tool" ToolTip.Tip="Blame options">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Image Source="{local:UpstreamImage Blame}" Width="16" Height="16" />
          <TextBlock Text="Blame options" VerticalAlignment="Center" />
        </StackPanel>
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="Blame settings:" IsEnabled="False" />
            <MenuItem x:Name="IgnoreWhitespaceMenuItem" Header="Ignore whitespace" ToggleType="CheckBox" />
            <MenuItem x:Name="DetectMoveInFileMenuItem" Header="Detect move and copy in this file" ToggleType="CheckBox" />
            <MenuItem x:Name="DetectMoveInAllFilesMenuItem" Header="Detect move and copy in all files" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Header="Display result settings:" IsEnabled="False" />
            <MenuItem x:Name="DisplayAuthorFirstMenuItem" Header="Display author first" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorMenuItem" Header="Show author" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorDateMenuItem" Header="Show author date" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorTimeMenuItem" Header="Show author time" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowLineNumbersMenuItem" Header="Show line numbers" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowOriginalFilePathMenuItem" Header="Show original file path" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorAvatarMenuItem" Header="Show author avatar" ToggleType="CheckBox" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button x:Name="CommandLogButton" Classes="tool" ToolTip.Tip="Git command log">
        <Image Source="{local:UpstreamImage GitCommandLog}" Width="16" Height="16" />
      </Button>
    </WrapPanel>
    <ListBox x:Name="HistoryList" Grid.Row="1" Classes="revisionGrid" SelectionMode="Multiple" ItemTemplate="{StaticResource RevisionRowTemplate}"
             IsVisible="False">
      <ListBox.ContextMenu>
        <ContextMenu x:Name="HistoryContextMenu">
          <!-- Upstream's CopyContextMenuItem, filled when the menu opens. -->
          <MenuItem x:Name="CopyToClipboardMenuItem" Header="Copy to clipboard" Icon="{local:UpstreamIcon CopyToClipboard}">
            <Separator />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="OpenWithDifftoolMenuItem" Header="Open with difftool" Icon="{local:UpstreamIcon Diff}" />
          <MenuItem x:Name="DiffToolRemoteLocalMenuItem" Header="Difftool selected &lt; - &gt; local" />
          <MenuItem x:Name="SaveAsMenuItem" Header="Save as" Icon="{local:UpstreamIcon SaveAs}" />
          <Separator />
          <MenuItem x:Name="ManipulateCommitMenuItem" Header="Manipulate commit">
            <MenuItem x:Name="RevertCommitMenuItem" Header="Revert commit" Icon="{local:UpstreamIcon RevertCommit}" />
            <MenuItem x:Name="CherryPickMenuItem" Header="Cherry pick commit" Icon="{local:UpstreamIcon CherryPick}" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="FollowRenamesMenuItem" Header="Detect and follow renames" ToggleType="CheckBox" />
          <MenuItem x:Name="FollowExactRenamesMenuItem" Header="Detect and follow - exact renames and copies only"
                    ToggleType="CheckBox" />
          <!-- Upstream's FormBrowseMenus.InsertRevisionGridMainMenuItems: the grid's Navigate and View menus. -->
          <Separator />
          <MenuItem x:Name="NavigateMenuItem" Header="_Navigate" Icon="{local:UpstreamIcon GotoCommit}">
            <MenuItem x:Name="ToggleArtificialAndHeadMenuItem" Header="_Toggle between artificial and HEAD commits"
                      Icon="{local:UpstreamIcon WorkingDirChanges}" />
            <MenuItem x:Name="GoToCurrentRevisionMenuItem" Header="Go to c_urrent revision" Icon="{local:UpstreamIcon GotoCurrentRevision}" />
            <MenuItem x:Name="GoToCommitMenuItem" Header="Go to _commit..." Icon="{local:UpstreamIcon GotoCommit}" />
            <Separator />
            <MenuItem x:Name="GoToChildMenuItem" Header="Go to c_hild commit" Icon="{local:UpstreamIcon GoToChildCommit}" />
            <MenuItem x:Name="GoToParentMenuItem" Header="Go to _parent commit" Icon="{local:UpstreamIcon GoToParentCommit}" />
            <MenuItem x:Name="GoToFirstParentMenuItem" Header="Go to f_irst parent commit" Icon="{local:UpstreamIcon GoToFirstParentCommit}" />
            <MenuItem x:Name="GoToLastParentMenuItem" Header="Go to _last parent commit" Icon="{local:UpstreamIcon GoToLastParentCommit}" />
            <MenuItem x:Name="GoToMergeBaseMenuItem" Header="Go to common _ancestor (merge base)"
                      Icon="{local:UpstreamIcon GoToMergeBaseCommit}"
                      ToolTip.Tip="Selects the common ancestor commit (merge base), which is the most recent shared ancestor of the selected commits (or if only one commit is selected, between it and the checked out commit (HEAD))" />
            <Separator />
            <MenuItem x:Name="NavigateBackwardMenuItem" Header="Navigate _backward" Icon="{local:UpstreamIcon NavigateBackward}" />
            <MenuItem x:Name="NavigateForwardMenuItem" Header="Navigate _forward" Icon="{local:UpstreamIcon NavigateForward}" />
            <Separator />
            <MenuItem x:Name="QuickSearchMenuItem" Header="_Quick search" ToolTip.Tip="Start typing in revision grid to start quick search." />
            <MenuItem x:Name="PrevQuickSearchMenuItem" Header="Quick search p_revious" />
            <MenuItem x:Name="NextQuickSearchMenuItem" Header="Quick search _next" />
          </MenuItem>
          <MenuItem x:Name="ViewMenuItem" Header="View" Icon="{local:UpstreamIcon AdvancedSettings}">
            <MenuItem Classes="groupHeader" Header="Branches" IsEnabled="False" />
            <MenuItem x:Name="ShowAllBranchesMenuItem" Header="Show _all branches" ToggleType="Radio" Icon="{local:UpstreamIcon BranchLocal}" />
            <MenuItem x:Name="ShowCurrentBranchOnlyMenuItem" Header="Show _current branch only" ToggleType="Radio" Icon="{local:UpstreamIcon BranchFilter}" />
            <MenuItem x:Name="ShowFilteredBranchesMenuItem" Header="Show _filtered branches" ToggleType="Radio" Icon="{local:UpstreamIcon BranchFilter}" />
            <MenuItem x:Name="ShowReflogReferencesMenuItem" Header="Show _reflog references" ToggleType="CheckBox" Icon="{local:UpstreamIcon Book}" />
            <Separator />
            <MenuItem x:Name="AdvancedFilterViewMenuItem" Header="Advanced filter..." Icon="{local:UpstreamIcon EditFilter}" />
            <Separator />
            <MenuItem x:Name="DrawNonRelativesGrayMenuItem" Header="Draw non relatives gra_y" ToggleType="CheckBox" />
            <MenuItem x:Name="HighlightSelectedBranchMenuItem" Header="Highlight selected branch (until refresh)" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Commits" IsEnabled="False" />
            <MenuItem x:Name="ShowArtificialCommitsMenuItem" Header="Show artificial commits" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowStashesMenuItem" Header="Show stashes" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Grid labels" IsEnabled="False" />
            <MenuItem x:Name="ShowRemoteBranchesMenuItem" Header="Show remote _branches" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowTagsMenuItem" Header="Show _tags" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Grid info" IsEnabled="False" />
            <MenuItem x:Name="ShowCommitBodyMenuItem" Header="Show commit message body" ToggleType="CheckBox" />
            <MenuItem x:Name="GridShowAuthorDateMenuItem" Header="Sho_w author date" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowRelativeDateMenuItem" Header="Show relati_ve date" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Columns" IsEnabled="False" />
            <MenuItem x:Name="ShowGraphColumnMenuItem" Header="Show revision _graph column" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAvatarColumnMenuItem" Header="Show aut_hor avatar column" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorNameColumnMenuItem" Header="Show a_uthor name column" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowDateColumnMenuItem" Header="Show _date column" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowObjectIdColumnMenuItem" Header="Show SHA_-1 column" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Sorting" IsEnabled="False" />
            <MenuItem x:Name="AuthorDateSortMenuItem" Header="_Sort commits by author date" ToggleType="CheckBox" />
            <MenuItem x:Name="TopoOrderMenuItem" Header="Arrange c_ommits by topo order (ancestor order)" ToggleType="CheckBox" />
          </MenuItem>
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
    <!-- Upstream's quick search label: what was typed into the grid, red when nothing matches. -->
    <Border x:Name="QuickSearchPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="7,5,5,5" IsHitTestVisible="False">
      <TextBlock x:Name="QuickSearchText" FontWeight="Bold" FontSize="14" />
    </Border>
    <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
    <TabControl x:Name="Tabs" Grid.Row="3" Padding="0,4,0,0">
      <TabItem x:Name="CommitTab">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage CommitSummary}" />
            <TextBlock x:Name="CommitTabText" Text="Commit" />
          </StackPanel>
        </TabItem.Header>
        <!-- Upstream's CommitDiff: the commit's information, its changed files and the selected one's diff. -->
        <local:CommitDiffView x:Name="CommitDiffPanel" />
      </TabItem>
      <TabItem x:Name="DiffTab">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage Diff}" />
            <TextBlock Text="Diff" />
          </StackPanel>
        </TabItem.Header>
        <local:DiffView x:Name="Diff" />
      </TabItem>
      <TabItem x:Name="ViewTab">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage ViewFile}" />
            <TextBlock Text="View" />
          </StackPanel>
        </TabItem.Header>
        <local:DiffView x:Name="View" />
      </TabItem>
      <TabItem x:Name="BlameTab">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage Blame}" />
            <TextBlock Text="Blame" />
          </StackPanel>
        </TabItem.Header>
        <local:BlameView x:Name="Blame" />
      </TabItem>
      <!-- Upstream's BuildReportTabPageExtension: the selected commit's build report, as a link (no web view). -->
      <TabItem x:Name="BuildReportTab" Header="Build Report" IsVisible="False">
        <HyperlinkButton x:Name="OpenBuildReportLink" Content="Open report" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
