<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.Presentation"
        x:Class="GitExtensions.Xplat.App.PromptWindow"
        x:DataType="vm:PromptViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- The shell's prompt, bound to PromptViewModel (PLAN.md principle 6). -->
  <StackPanel Margin="16" Spacing="8">
    <TextBlock x:Name="LabelText" TextWrapping="Wrap" Text="{Binding Label}" />
    <TextBox x:Name="ValueBox" Text="{Binding Value}" />
    <TextBox x:Name="SecondValueBox" Text="{Binding SecondValue}" IsVisible="{Binding HasSecondValue}"
             PlaceholderText="{Binding SecondPlaceholder}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button x:Name="OkButton" IsDefault="True" Content="{Binding AcceptText}" Command="{Binding AcceptCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
