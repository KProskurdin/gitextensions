<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        x:Class="GitExtensions.Xplat.App.FileHistoryWindow"
        x:DataType="core:FileHistoryViewModel"
        Title="{Binding Title}"
        Width="748" Height="444" MinWidth="299" MinHeight="198" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormFileHistory: the toolstrip (upstream's FilterToolBar, then Load, full history, blame options, git
       command log), the file's revision grid with its menu, and below it the Commit, Diff, View and Blame tabs. Bound to
       FileHistoryViewModel (PLAN.md principle 6). -->
  <Grid RowDefinitions="Auto,*,5,*">
    <WrapPanel Orientation="Horizontal" Margin="2">
      <local:FilterToolBar x:Name="ToolStripFilters" />
      <Rectangle Classes="toolSeparator" />
      <SplitButton x:Name="LoadButton" Classes="tool" ToolTip.Tip="Load file history">
        <Image Source="{local:UpstreamImage ReloadRevisions}" Width="16" Height="16" />
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem x:Name="LoadHistoryOnShowMenuItem" IsChecked="{Binding LoadHistoryOnShow, Mode=OneWay}" Command="{Binding ToggleOptionCommand}"
                      CommandParameter="{x:Static core:FileHistoryOption.LoadHistoryOnShow}" Header="Load history on show" ToggleType="CheckBox" />
            <MenuItem x:Name="LoadBlameOnShowMenuItem" IsChecked="{Binding LoadBlameOnShow, Mode=OneWay}" Command="{Binding ToggleOptionCommand}"
                      CommandParameter="{x:Static core:FileHistoryOption.LoadBlameOnShow}" Header="Load blame on show" ToggleType="CheckBox" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <DropDownButton x:Name="FullHistoryButton" Classes="tool" ToolTip.Tip="Show Full History">
        <Image Source="{local:UpstreamImage FileHistory}" Width="16" Height="16" />
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem x:Name="ShowFullHistoryMenuItem" IsChecked="{Binding FullHistory, Mode=OneWay}" Command="{Binding ToggleOptionCommand}"
                      CommandParameter="{x:Static core:FileHistoryOption.FullHistory}" Header="Show full history" ToggleType="CheckBox" />
            <MenuItem x:Name="SimplifyMergesMenuItem" IsChecked="{Binding SimplifyMerges, Mode=OneWay}" Command="{Binding ToggleOptionCommand}"
                      CommandParameter="{x:Static core:FileHistoryOption.SimplifyMerges}" IsEnabled="{Binding FullHistory}" Header="Simplify merges" ToggleType="CheckBox" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton x:Name="BlameOptionsButton" IsVisible="{Binding Dialog.HasBlame}" Classes="tool" ToolTip.Tip="Blame options">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Image Source="{local:UpstreamImage Blame}" Width="16" Height="16" />
          <TextBlock Text="Blame options" VerticalAlignment="Center" />
        </StackPanel>
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="Blame settings:" IsEnabled="False" />
            <MenuItem x:Name="IgnoreWhitespaceMenuItem" IsChecked="{Binding BlameOptions.IgnoreWhitespace, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.IgnoreWhitespace}" Header="Ignore whitespace" ToggleType="CheckBox" />
            <MenuItem x:Name="DetectMoveInFileMenuItem" IsChecked="{Binding BlameOptions.DetectMoveInFile, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.DetectMoveInFile}" Header="Detect move and copy in this file" ToggleType="CheckBox" />
            <MenuItem x:Name="DetectMoveInAllFilesMenuItem" IsChecked="{Binding BlameOptions.DetectMoveInAllFiles, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.DetectMoveInAllFiles}" Header="Detect move and copy in all files" ToggleType="CheckBox" />
            <Separator />
            <MenuItem Header="Display result settings:" IsEnabled="False" />
            <MenuItem x:Name="DisplayAuthorFirstMenuItem" IsChecked="{Binding BlameOptions.DisplayAuthorFirst, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.DisplayAuthorFirst}" Header="Display author first" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorMenuItem" IsChecked="{Binding BlameOptions.ShowAuthor, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowAuthor}" Header="Show author" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorDateMenuItem" IsChecked="{Binding BlameOptions.ShowAuthorDate, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowAuthorDate}" Header="Show author date" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorTimeMenuItem" IsChecked="{Binding BlameOptions.ShowAuthorTime, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowAuthorTime}" IsEnabled="{Binding BlameOptions.ShowAuthorDate}" Header="Show author time" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowLineNumbersMenuItem" IsChecked="{Binding BlameOptions.ShowLineNumbers, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowLineNumbers}" Header="Show line numbers" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowOriginalFilePathMenuItem" IsChecked="{Binding BlameOptions.ShowOriginalFilePath, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowOriginalFilePath}" Header="Show original file path" ToggleType="CheckBox" />
            <MenuItem x:Name="ShowAuthorAvatarMenuItem" IsChecked="{Binding BlameOptions.ShowAuthorAvatar, Mode=OneWay}"
                      Command="{Binding ToggleBlameOptionCommand}" CommandParameter="{x:Static core:BlameOption.ShowAuthorAvatar}" Header="Show author avatar" ToggleType="CheckBox" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button x:Name="CommandLogButton" Command="{Binding ShowCommandLogCommand}" Classes="tool" ToolTip.Tip="Git command log">
        <Image Source="{local:UpstreamImage GitCommandLog}" Width="16" Height="16" />
      </Button>
    </WrapPanel>
    <ListBox x:Name="HistoryList" ItemsSource="{Binding Commits.VisibleRows}" Grid.Row="1" Classes="revisionGrid" SelectionMode="Multiple" ItemTemplate="{StaticResource RevisionRowTemplate}"
             IsVisible="{Binding IsHistoryVisible}">
      <ListBox.ContextMenu>
        <ContextMenu x:Name="HistoryContextMenu">
          <!-- Upstream's CopyContextMenuItem, filled when the menu opens. -->
          <MenuItem x:Name="CopyToClipboardMenuItem" IsEnabled="{Binding Menu.CopyToClipboard}" Header="Copy to clipboard" Icon="{local:UpstreamIcon CopyToClipboard}">
            <Separator />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="OpenWithDifftoolMenuItem" IsEnabled="{Binding Menu.OpenWithDifftool}" Header="Open with difftool" Icon="{local:UpstreamIcon Diff}"
                    Command="{Binding OpenWithDifftoolTools.OpenCommand}" ItemsSource="{Binding OpenWithDifftoolTools.Entries, Converter={x:Static local:MenuEntriesConverter.Instance}}" />
          <MenuItem x:Name="DiffToolRemoteLocalMenuItem" IsEnabled="{Binding Menu.DiffToolRemoteLocal}" Header="Difftool selected &lt; - &gt; local"
                    Command="{Binding DiffToolRemoteLocalTools.OpenCommand}" ItemsSource="{Binding DiffToolRemoteLocalTools.Entries, Converter={x:Static local:MenuEntriesConverter.Instance}}" />
          <MenuItem x:Name="SaveAsMenuItem" Header="Save as" IsEnabled="{Binding Menu.SaveAs}"
                    IsVisible="{Binding CanSaveFile}" Command="{Binding SaveAsCommand}" Icon="{local:UpstreamIcon SaveAs}" />
          <Separator />
          <MenuItem x:Name="ManipulateCommitMenuItem" Header="Manipulate commit" IsEnabled="{Binding Menu.ManipulateCommit}">
            <MenuItem x:Name="RevertCommitMenuItem" Header="Revert commit" Command="{Binding RevertCommand}" Icon="{local:UpstreamIcon RevertCommit}" />
            <MenuItem x:Name="CherryPickMenuItem" Header="Cherry pick commit" Command="{Binding CherryPickCommand}" Icon="{local:UpstreamIcon CherryPick}" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="FollowRenamesMenuItem" IsChecked="{Binding FollowRenames, Mode=OneWay}" Command="{Binding ToggleOptionCommand}" CommandParameter="{x:Static core:FileHistoryOption.FollowRenames}" Header="Detect and follow renames" ToggleType="CheckBox" />
          <MenuItem x:Name="FollowExactRenamesMenuItem" IsChecked="{Binding ExactRenamesOnly, Mode=OneWay}" IsEnabled="{Binding FollowRenames}"
                    Command="{Binding ToggleOptionCommand}" CommandParameter="{x:Static core:FileHistoryOption.ExactRenamesOnly}" Header="Detect and follow - exact renames and copies only"
                    ToggleType="CheckBox" />
          <!-- Upstream's FormBrowseMenus.InsertRevisionGridMainMenuItems: the grid's Navigate and View menus. -->
          <Separator />
          <MenuItem x:Name="NavigateMenuItem" Header="_Navigate" Icon="{local:UpstreamIcon GotoCommit}">
            <MenuItem x:Name="ToggleArtificialAndHeadMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.ToggleBetweenArtificialAndHeadCommits}" Header="_Toggle between artificial and HEAD commits"
                      Icon="{local:UpstreamIcon WorkingDirChanges}" />
            <MenuItem x:Name="GoToCurrentRevisionMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.SelectCurrentRevision}" Header="Go to c_urrent revision" Icon="{local:UpstreamIcon GotoCurrentRevision}" />
            <MenuItem x:Name="GoToCommitMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToCommit}" Header="Go to _commit..." Icon="{local:UpstreamIcon GotoCommit}" />
            <Separator />
            <MenuItem x:Name="GoToChildMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToChild}" Header="Go to c_hild commit" Icon="{local:UpstreamIcon GoToChildCommit}" />
            <MenuItem x:Name="GoToParentMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToParent}" Header="Go to _parent commit" Icon="{local:UpstreamIcon GoToParentCommit}" />
            <MenuItem x:Name="GoToFirstParentMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToFirstParent}" Header="Go to f_irst parent commit" Icon="{local:UpstreamIcon GoToFirstParentCommit}" />
            <MenuItem x:Name="GoToLastParentMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToLastParent}" Header="Go to _last parent commit" Icon="{local:UpstreamIcon GoToLastParentCommit}" />
            <MenuItem x:Name="GoToMergeBaseMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.GoToMergeBase}" Header="Go to common _ancestor (merge base)"
                      Icon="{local:UpstreamIcon GoToMergeBaseCommit}"
                      ToolTip.Tip="Selects the common ancestor commit (merge base), which is the most recent shared ancestor of the selected commits (or if only one commit is selected, between it and the checked out commit (HEAD))" />
            <Separator />
            <MenuItem x:Name="NavigateBackwardMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.NavigateBackward}" Header="Navigate _backward" Icon="{local:UpstreamIcon NavigateBackward}" />
            <MenuItem x:Name="NavigateForwardMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.NavigateForward}" Header="Navigate _forward" Icon="{local:UpstreamIcon NavigateForward}" />
            <Separator />
            <MenuItem x:Name="QuickSearchMenuItem" Command="{Binding QuickSearchHelpCommand}" Header="_Quick search" ToolTip.Tip="Start typing in revision grid to start quick search." />
            <MenuItem x:Name="PrevQuickSearchMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.PrevQuickSearch}" Header="Quick search p_revious" />
            <MenuItem x:Name="NextQuickSearchMenuItem" Command="{Binding RunGridCommand}" CommandParameter="{x:Static core:GridCommand.NextQuickSearch}" Header="Quick search _next" />
          </MenuItem>
          <MenuItem x:Name="ViewMenuItem" DataContext="{x:Null}" Header="View" x:DataType="core:GridViewMenuViewModel" Icon="{local:UpstreamIcon AdvancedSettings}">
            <MenuItem Classes="groupHeader" Header="Branches" IsEnabled="False" />
            <MenuItem x:Name="ShowAllBranchesMenuItem" Header="Show _all branches" ToggleType="Radio" IsChecked="{Binding ShowAllBranches}" Command="{Binding ShowBranchesCommand}" CommandParameter="{x:Static core:BranchesShown.All}" Icon="{local:UpstreamIcon BranchLocal}" />
            <MenuItem x:Name="ShowCurrentBranchOnlyMenuItem" Header="Show _current branch only" ToggleType="Radio" IsChecked="{Binding ShowCurrentBranchOnly}" Command="{Binding ShowBranchesCommand}" CommandParameter="{x:Static core:BranchesShown.CurrentOnly}" Icon="{local:UpstreamIcon BranchFilter}" />
            <MenuItem x:Name="ShowFilteredBranchesMenuItem" Header="Show _filtered branches" ToggleType="Radio" IsChecked="{Binding ShowFilteredBranches}" Command="{Binding ShowBranchesCommand}" CommandParameter="{x:Static core:BranchesShown.Filtered}" Icon="{local:UpstreamIcon BranchFilter}" />
            <MenuItem x:Name="ShowReflogReferencesMenuItem" Header="Show _reflog references" ToggleType="CheckBox" IsChecked="{Binding ShowReflog}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.Reflog}" Icon="{local:UpstreamIcon Book}" />
            <Separator />
            <MenuItem x:Name="AdvancedFilterViewMenuItem" Command="{Binding EditFilterCommand}" Header="Advanced filter..." Icon="{local:UpstreamIcon EditFilter}" />
            <Separator />
            <MenuItem x:Name="DrawNonRelativesGrayMenuItem" Header="Draw non relatives gra_y" ToggleType="CheckBox" IsChecked="{Binding DrawNonRelativesGray}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.DrawNonRelativesGray}" />
            <MenuItem x:Name="HighlightSelectedBranchMenuItem" Command="{Binding HighlightSelectedBranchCommand}" Header="Highlight selected branch (until refresh)" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Commits" IsEnabled="False" />
            <MenuItem x:Name="ShowArtificialCommitsMenuItem" Header="Show artificial commits" ToggleType="CheckBox" IsChecked="{Binding ShowArtificialCommits}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.ArtificialCommits}" />
            <MenuItem x:Name="ShowStashesMenuItem" Header="Show stashes" ToggleType="CheckBox" IsChecked="{Binding ShowStashes}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.Stashes}" />
            <MenuItem x:Name="ShowSessionCheckpointsMenuItem" Header="Show session checkpoints" ToggleType="CheckBox" IsChecked="{Binding ShowSessionCheckpoints}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.SessionCheckpoints}" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Grid labels" IsEnabled="False" />
            <MenuItem x:Name="ShowRemoteBranchesMenuItem" Header="Show remote _branches" ToggleType="CheckBox" IsChecked="{Binding ShowRemoteBranches}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.RemoteBranches}" />
            <MenuItem x:Name="ShowTagsMenuItem" Header="Show _tags" ToggleType="CheckBox" IsChecked="{Binding ShowTags}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.Tags}" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Grid info" IsEnabled="False" />
            <MenuItem x:Name="ShowCommitBodyMenuItem" Header="Show commit message body" ToggleType="CheckBox" IsChecked="{Binding ShowCommitBody}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.CommitBody}" />
            <MenuItem x:Name="GridShowAuthorDateMenuItem" Header="Sho_w author date" ToggleType="CheckBox" IsChecked="{Binding ShowAuthorDate}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.AuthorDate}" />
            <MenuItem x:Name="ShowRelativeDateMenuItem" Header="Show relati_ve date" ToggleType="CheckBox" IsChecked="{Binding ShowRelativeDate}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.RelativeDate}" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Columns" IsEnabled="False" />
            <MenuItem x:Name="ShowGraphColumnMenuItem" Header="Show revision _graph column" ToggleType="CheckBox" IsChecked="{Binding ShowGraphColumn}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.GraphColumn}" />
            <MenuItem x:Name="ShowAvatarColumnMenuItem" Header="Show aut_hor avatar column" ToggleType="CheckBox" IsChecked="{Binding ShowAvatarColumn}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.AvatarColumn}" />
            <MenuItem x:Name="ShowAuthorNameColumnMenuItem" Header="Show a_uthor name column" ToggleType="CheckBox" IsChecked="{Binding ShowAuthorNameColumn}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.AuthorNameColumn}" />
            <MenuItem x:Name="ShowDateColumnMenuItem" Header="Show _date column" ToggleType="CheckBox" IsChecked="{Binding ShowDateColumn}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.DateColumn}" />
            <MenuItem x:Name="ShowObjectIdColumnMenuItem" Header="Show SHA_-1 column" ToggleType="CheckBox" IsChecked="{Binding ShowObjectIdColumn}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.ObjectIdColumn}" />
            <Separator />
            <MenuItem Classes="groupHeader" Header="Sorting" IsEnabled="False" />
            <MenuItem x:Name="AuthorDateSortMenuItem" Header="_Sort commits by author date" ToggleType="CheckBox" IsChecked="{Binding SortByAuthorDate}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.AuthorDateSort}" />
            <MenuItem x:Name="TopoOrderMenuItem" Header="Arrange c_ommits by topo order (ancestor order)" ToggleType="CheckBox" IsChecked="{Binding TopoOrder}" Command="{Binding ToggleCommand}" CommandParameter="{x:Static core:GridViewToggle.TopoOrder}" />
          </MenuItem>
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
    <!-- Upstream's quick search label: what was typed into the grid, red when nothing matches. -->
    <Border x:Name="QuickSearchPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="7,5,5,5" IsHitTestVisible="False">
      <TextBlock x:Name="QuickSearchText" FontWeight="Bold" FontSize="14" />
    </Border>
    <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
    <TabControl x:Name="Tabs" Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Padding="0,4,0,0">
      <TabItem x:Name="CommitTab" IsVisible="{Binding IsCommitTabVisible}">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage CommitSummary}" />
            <TextBlock x:Name="CommitTabText" Text="{Binding CommitTabText}" />
          </StackPanel>
        </TabItem.Header>
        <!-- Upstream's CommitDiff: the commit's information, its changed files and the selected one's diff. -->
        <local:CommitDiffView x:Name="CommitDiffPanel" />
      </TabItem>
      <TabItem x:Name="DiffTab" IsVisible="{Binding IsDiffTabVisible}">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage Diff}" />
            <TextBlock Text="Diff" />
          </StackPanel>
        </TabItem.Header>
        <local:DiffView x:Name="Diff" />
      </TabItem>
      <TabItem x:Name="ViewTab" IsVisible="{Binding IsViewTabVisible}">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage ViewFile}" />
            <TextBlock Text="View" />
          </StackPanel>
        </TabItem.Header>
        <local:DiffView x:Name="View" />
      </TabItem>
      <TabItem x:Name="BlameTab" IsVisible="{Binding IsBlameTabVisible}">
        <TabItem.Header>
          <StackPanel Classes="tabHeader">
            <Image Source="{local:UpstreamImage Blame}" />
            <TextBlock Text="Blame" />
          </StackPanel>
        </TabItem.Header>
        <local:BlameView x:Name="Blame" />
      </TabItem>
      <!-- Upstream's BuildReportTabPageExtension: the selected commit's build report, as a link (no web view). -->
      <TabItem x:Name="BuildReportTab" Header="Build Report" IsVisible="False">
        <HyperlinkButton x:Name="OpenBuildReportLink" Command="{Binding OpenReportedBuildCommand}" Content="Open report" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
