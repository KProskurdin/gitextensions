<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitExtensions.Xplat.App"
             x:Class="GitExtensions.Xplat.App.DiffView">
  <DockPanel LastChildFill="True">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
      <!-- Upstream FileViewer's toolbar: whitespace, lines of context, entire file. -->
      <StackPanel x:Name="OptionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
        <ComboBox x:Name="WhitespaceBox" MinWidth="200" ToolTip.Tip="Whitespace changes" />
        <Button x:Name="DecreaseContextButton" Content="−" Padding="8,2" ToolTip.Tip="Decrease the number of lines of context" />
        <TextBlock x:Name="ContextText" VerticalAlignment="Center" MinWidth="16" TextAlignment="Center" ToolTip.Tip="Lines of context" />
        <Button x:Name="IncreaseContextButton" Content="+" Padding="8,2" ToolTip.Tip="Increase the number of lines of context" />
        <ToggleButton x:Name="EntireFileToggle" Content="Entire file" Padding="8,2" ToolTip.Tip="Show entire file" />
      </StackPanel>
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Firebrick" TextWrapping="Wrap" IsVisible="False" />
    <ListBox x:Name="DiffList" FontFamily="{DynamicResource DiffFontFamily}" Padding="0" SelectionMode="Multiple">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:DiffLineItem">
          <Grid ColumnDefinitions="44,44,*">
            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Opacity="0.55" TextAlignment="Right" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Opacity="0.55" TextAlignment="Right" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding Foreground}" Background="{Binding Background}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
