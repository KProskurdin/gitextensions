<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        xmlns:repo="using:GitExtensions.Xplat.Core.Repository"
        x:Class="GitExtensions.Xplat.App.MainWindow"
        Title="Git Extensions"
        Width="1100" Height="680">
  <DockPanel Margin="12" LastChildFill="True">
    <TextBlock x:Name="GitProblemText" DockPanel.Dock="Top" Foreground="Firebrick" Margin="0,0,0,8" />
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox x:Name="PathBox" Width="420" Margin="0,0,8,4" PlaceholderText="Path to a git repository" />
      <Button x:Name="OpenButton" Content="Open" Margin="0,0,8,4" />
      <Button x:Name="LoadMoreButton" Content="Load more" IsVisible="False" Margin="0,0,8,4" />
      <Button x:Name="FetchButton" Content="Fetch" Margin="0,0,8,4" />
      <Button x:Name="PullButton" Content="Pull" Margin="0,0,8,4" />
      <Button x:Name="PushButton" Content="Push" Margin="0,0,8,4" />
      <Button x:Name="CloneButton" Content="Clone..." Margin="0,0,8,4" />
      <Button x:Name="OpenFolderButton" Content="Open folder" Margin="0,0,8,4" />
      <Button x:Name="TerminalButton" Content="Terminal" Margin="0,0,8,4" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,4" />
      <TextBlock x:Name="OperationStatusText" VerticalAlignment="Center" Margin="8,0,0,4" Foreground="DarkGreen" />
    </WrapPanel>
    <Grid ColumnDefinitions="260,12,*,12,360">
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="6">
          <TextBlock x:Name="BranchText" FontWeight="Bold" />
          <ListBox x:Name="BranchList" Height="150">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="repo:BranchInfo">
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel>
            <Button x:Name="CheckoutButton" Content="Checkout" Margin="0,0,6,4" />
            <Button x:Name="DeleteBranchButton" Content="Delete" Margin="0,0,6,4" />
          </WrapPanel>
          <WrapPanel>
            <TextBox x:Name="NewBranchBox" Width="150" Margin="0,0,6,4" PlaceholderText="New branch name" />
            <Button x:Name="CreateBranchButton" Content="Create" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBlock Text="Changes" FontWeight="Bold" Margin="0,8,0,0" />
          <ListBox x:Name="ChangeList" Height="200" SelectionMode="Multiple">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="repo:FileChange">
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel>
            <Button x:Name="StageButton" Content="Stage" Margin="0,0,6,4" />
            <Button x:Name="UnstageButton" Content="Unstage" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBox x:Name="CommitMessageBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="Commit message" />
          <WrapPanel>
            <CheckBox x:Name="AmendCheck" Content="Amend" Margin="0,0,12,4" />
            <Button x:Name="CommitButton" Content="Commit" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBlock Text="Stash" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBox x:Name="StashMessageBox" PlaceholderText="Stash message (optional)" />
          <WrapPanel>
            <Button x:Name="StashButton" Content="Stash" Margin="0,0,6,4" />
            <Button x:Name="PopStashButton" Content="Pop stash" Margin="0,0,6,4" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <ListBox x:Name="CommitList" Grid.Column="2">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:CommitRow">
            <Grid ColumnDefinitions="90,*,200,140" Margin="4,2">
              <TextBlock Grid.Column="0" Text="{Binding ShortHash}" FontFamily="monospace" />
              <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Date}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1" Padding="10" CornerRadius="4">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
            <TextBlock x:Name="DetailHash" FontFamily="monospace" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailAuthor" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailAuthorDate" />
            <TextBlock x:Name="DetailCommitDate" />
            <TextBlock x:Name="DetailParents" FontFamily="monospace" TextWrapping="Wrap" />
            <Button x:Name="CopyHashButton" Content="Copy hash" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
          <ScrollViewer>
            <TextBlock x:Name="DetailMessage" TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
