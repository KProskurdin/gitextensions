<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.CherryPickWindow"
        x:DataType="vm:CherryPickViewModel"
        Title="Cherry pick commit"
        Width="614" SizeToContent="Height" MinWidth="614" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormCherryPick: the commit's summary with a button to choose another, the parent of a merge, the commit
       and reference options, and Cherry pick and Abort at the bottom right. Bound to
       CherryPickViewModel (PLAN.md principle 6). -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="HelpButton" Content="?" Width="24" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
          <Button x:Name="btnPick" Content="_Cherry pick" MinWidth="109" HorizontalContentAlignment="Center" IsDefault="True"
                  Command="{Binding PickCommand}" />
          <Button x:Name="btnAbort" Content="A_bort" MinWidth="75" HorizontalContentAlignment="Center" IsCancel="True"
                  Command="{Binding CancelCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Margin="15,12" Spacing="4">
      <TextBlock x:Name="lblBranchInfo" Text="Cherry pick this commit:" />
      <local:CommitSummaryView x:Name="commitSummaryUserControl1" Margin="13,0,0,0" Summary="{Binding Summary}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Label x:Name="lblAnotherRev" Content="C_hoose another revision:" Target="btnChooseRevision" Padding="0"
               VerticalAlignment="Center" />
        <Button x:Name="btnChooseRevision" Padding="3" Command="{Binding ChooseRevisionCommand}">
          <Image Source="{local:UpstreamImage SelectRevision}" Width="16" Height="16" />
        </Button>
      </StackPanel>
      <Label x:Name="lblParents" Content="This commit is a merge, select _parent:" Target="lvParentsList" Padding="0"
             IsVisible="{Binding IsMerge}" />
      <ListBox x:Name="lvParentsList" Margin="3,0,0,0" IsVisible="{Binding IsMerge}" ItemsSource="{Binding Parents}"
               SelectedItem="{Binding SelectedParent}" />
      <CheckBox x:Name="cbxAutoCommit" Content="_Automatically create a commit" IsChecked="{Binding AutoCommit}" />
      <CheckBox x:Name="cbxAddReference" Content="A_dd commit reference to commit message"
                IsChecked="{Binding AddReference}" />
    </StackPanel>
  </DockPanel>
</Window>
