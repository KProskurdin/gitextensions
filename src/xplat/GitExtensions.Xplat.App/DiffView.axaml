<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitExtensions.Xplat.App"
             x:Class="GitExtensions.Xplat.App.DiffView">
  <DockPanel LastChildFill="True">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Firebrick" TextWrapping="Wrap" IsVisible="False" />
    <!-- Upstream's EditorBackground behind the lines, LineNumberBackground behind the numbers, Selection on selected lines. -->
    <!-- Upstream's vertical ruler (diffverticalrulerposition) over the lines. -->
    <Panel>
    <ListBox x:Name="DiffList" FontFamily="{DynamicResource DiffFontFamily}" FontWeight="{DynamicResource DiffFontWeight}" FontStyle="{DynamicResource DiffFontStyle}" FontSize="{DynamicResource DiffFontSize}" Padding="0" SelectionMode="Multiple"
             Background="{DynamicResource EditorBackgroundBrush}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
      </ListBox.Styles>
      <!-- Upstream FileViewer's menu: line staging (where the window can stage), the copy items, then the view options. -->
      <ListBox.ContextMenu>
        <ContextMenu x:Name="DiffContextMenu">
          <MenuItem x:Name="StageLinesMenuItem" Header="Stage selected line(s)" Icon="{local:UpstreamIcon Stage}" />
          <MenuItem x:Name="UnstageLinesMenuItem" Header="Unstage selected line(s)" Icon="{local:UpstreamIcon Unstage}" />
          <MenuItem x:Name="CopyMenuItem" Header="_Copy" />
          <MenuItem x:Name="CopyPatchMenuItem" Header="Copy _patch" />
          <MenuItem x:Name="CopyNewVersionMenuItem" Header="Copy _new version" />
          <MenuItem x:Name="CopyOldVersionMenuItem" Header="Copy _old version" />
          <Separator x:Name="OptionsSeparator" />
          <MenuItem x:Name="IncreaseContextMenuItem" Header="_Increase the number of lines of context" Icon="{local:UpstreamIcon NumberOfLinesIncrease}" />
          <MenuItem x:Name="DecreaseContextMenuItem" Header="_Decrease the number of lines of context" Icon="{local:UpstreamIcon NumberOfLinesDecrease}" />
          <MenuItem x:Name="EntireFileMenuItem" Header="Show _entire file" ToggleType="CheckBox" />
          <MenuItem x:Name="NonPrintingMenuItem" Header="S_how nonprinting characters" ToggleType="CheckBox" />
          <MenuItem x:Name="SyntaxHighlightingMenuItem" Header="Show synta_x highlighting" ToggleType="CheckBox" />
          <MenuItem x:Name="IgnoreWhitespaceEolMenuItem" Header="Ignore whitespace changes at end of _line" ToggleType="CheckBox" />
          <MenuItem x:Name="IgnoreWhitespaceChangeMenuItem" Header="Ignore changes in _amount of whitespace" ToggleType="CheckBox" />
          <MenuItem x:Name="IgnoreAllWhitespaceMenuItem" Header="Ignore all _whitespace changes" ToggleType="CheckBox" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:DiffLineItem">
          <Grid ColumnDefinitions="44,44,*">
            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Opacity="0.55" TextAlignment="Right" Padding="0,0,6,0"
                       Background="{DynamicResource LineNumberBackgroundBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Opacity="0.55" TextAlignment="Right" Padding="0,0,8,0"
                       Background="{DynamicResource LineNumberBackgroundBrush}" />
            <!-- The file's syntax colors when its type has a definition, as upstream's file viewer. -->
            <local:SyntaxTextBlock Grid.Column="2" Text="{Binding Text}" Runs="{Binding Runs}" Foreground="{Binding Foreground}"
                                   Background="{Binding Background}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Line x:Name="VerticalRuler" StrokeThickness="1" Stroke="Gray" Opacity="0.6" IsVisible="False" />
    </Canvas>
    <!-- Upstream FileViewer's toolbar: at the top right over the lines, shown while the pointer is on the viewer. -->
    <StackPanel x:Name="DiffToolbar" Classes="toolStrip" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,40,0" IsVisible="False" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <local:ToolButton x:Name="NextChangeButton" Image="ArrowDown" ToolTip.Tip="Next change" />
      <local:ToolButton x:Name="PreviousChangeButton" Image="ArrowUp" ToolTip.Tip="Previous change" />
      <Rectangle Classes="toolSeparator" />
      <local:ToolButton x:Name="IncreaseContextButton" Image="NumberOfLinesIncrease" ToolTip.Tip="Increase the number of lines of context" />
      <local:ToolButton x:Name="DecreaseContextButton" Image="NumberOfLinesDecrease" ToolTip.Tip="Decrease the number of lines of context" />
      <Rectangle Classes="toolSeparator" />
      <local:ToolToggleButton x:Name="EntireFileToggle" Image="ShowEntireFile" ToolTip.Tip="Show entire file" />
      <local:ToolToggleButton x:Name="NonPrintingToggle" Image="ShowWhitespace" ToolTip.Tip="Show nonprinting characters" />
      <local:ToolToggleButton x:Name="SyntaxHighlightingToggle" Image="SyntaxHighlighting" ToolTip.Tip="Show syntax highlighting" />
      <local:ToolToggleButton x:Name="IgnoreWhitespaceEolToggle" Image="WhitespaceIgnoreEol" ToolTip.Tip="Ignore whitespace changes at end of line" />
      <local:ToolToggleButton x:Name="IgnoreWhitespaceChangeToggle" Image="WhitespaceIgnore" ToolTip.Tip="Ignore changes in amount of whitespace" />
      <local:ToolToggleButton x:Name="IgnoreAllWhitespaceToggle" Image="WhitespaceIgnoreAll" ToolTip.Tip="Ignore all whitespace changes" />
    </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
