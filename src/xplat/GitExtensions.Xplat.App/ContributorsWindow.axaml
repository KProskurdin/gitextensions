<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.Platform"
        x:Class="GitExtensions.Xplat.App.ContributorsWindow"
        x:DataType="vm:ContributorsViewModel"
        Title="{Binding Title}"
        Width="624" Height="442" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormContributors: the developers (team and contributors), translators and designers on three tabs, each
       a read-only text filling its tab. Bound to ContributorsViewModel (PLAN.md principle 6). -->
  <Window.Styles>
    <Style Selector="TextBox.names">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
  </Window.Styles>
  <TabControl x:Name="Tabs" Padding="0">
    <TabItem x:Name="DevelopersTab" Header="{Binding DevelopersHeader}">
      <TextBox x:Name="DevelopersText" Classes="names" Text="{Binding DevelopersText, Mode=OneWay}" />
    </TabItem>
    <TabItem x:Name="TranslatorsTab" Header="{Binding TranslatorsHeader}">
      <TextBox x:Name="TranslatorsText" Classes="names" Text="{Binding TranslatorsText, Mode=OneWay}" />
    </TabItem>
    <TabItem x:Name="DesignersTab" Header="{Binding DesignersHeader}">
      <TextBox x:Name="DesignersText" Classes="names" Text="{Binding DesignersText, Mode=OneWay}" />
    </TabItem>
  </TabControl>
</Window>
