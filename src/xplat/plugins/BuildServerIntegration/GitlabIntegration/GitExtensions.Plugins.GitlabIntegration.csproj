<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UpstreamDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..', 'plugins', 'BuildServerIntegration', 'GitlabIntegration'))</UpstreamDir>
    <XplatPluginUi>true</XplatPluginUi>
  </PropertyGroup>

  <Import Project="..\..\..\eng\SharedSources.targets" />

  <ItemGroup>
    <!-- The WinForms settings control; Settings\GitlabSettingsUserControl.axaml here stands in for it. The adapter is
         compiled as it is. -->
    <Compile Remove="$(UpstreamDir)Settings\GitlabSettingsUserControl.cs;$(UpstreamDir)Settings\GitlabSettingsUserControl.Designer.cs" />
    <EmbeddedResource Remove="$(UpstreamDir)Settings\GitlabSettingsUserControl.resx" />
  </ItemGroup>

</Project>
