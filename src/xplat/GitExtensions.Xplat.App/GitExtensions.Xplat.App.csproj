<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GitExtensions</AssemblyName>
    <RootNamespace>GitExtensions.Xplat.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The repository turns publishing off for every project; the cross-platform app is published (src/xplat/eng/publish-app.sh). -->
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared xplat props add WinForms/Drawing namespaces to every project; they clash with Avalonia's control names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo lives in setup/ and is linked, not copied, so the upstream asset stays the single source. -->
    <AvaloniaResource Include="..\..\..\setup\assets\Logo\git-extensions-logo-256px.png" Link="Assets\git-extensions-logo-256px.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's theme files, linked into the Themes folder next to the app as upstream ships them (upstream's
         ThemePathProvider looks there), so both apps read the same CSS. -->
    <Content Include="..\..\app\GitUI\Themes\*.css;..\..\app\GitUI\Themes\README.md" Link="Themes\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitCommands\GitCommands.csproj" />
    <ProjectReference Include="..\GitExtensions.Xplat.Core\GitExtensions.Xplat.Core.csproj" />
  </ItemGroup>

</Project>
