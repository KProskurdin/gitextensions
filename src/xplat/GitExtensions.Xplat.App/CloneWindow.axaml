<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.CloneWindow"
        x:DataType="vm:CloneViewModel"
        Title="Clone"
        Width="647" MinWidth="450" MaxWidth="950" SizeToContent="Height" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Upstream's Info label: the control text color, or red for a problem with the location. -->
    <Style Selector="TextBlock#InfoText">
      <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
    </Style>
    <Style Selector="TextBlock#InfoText.error">
      <Setter Property="Foreground" Value="{DynamicResource InfoErrorTextBrush}" />
    </Style>
  </Window.Styles>
  <!-- Upstream's FormClone (a GitExtensionsDialog): the source, destination, subdirectory and branch, the line that says
       where the clone goes, the repository type and the options; Load SSH key and Clone at the bottom. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="HelpButton" Content="?" Width="24" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
          <Button x:Name="LoadSshKeyButton" Command="{Binding LoadSshKeyCommand}" MinWidth="120" VerticalAlignment="Center" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="{local:UpstreamImage Putty}" Width="16" Height="16" />
              <AccessText Text="_Load SSH key" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="CloneButton" Command="{Binding CloneCommand}" Content="Clone" MinWidth="75" IsDefault="True" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Margin="12">
      <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto,Auto,Auto,Auto">
        <AccessText Text="Repository to _clone:" VerticalAlignment="Center" Margin="3,3,12,3" />
        <ComboBox IsEditable="True" x:Name="FromBox" ItemsSource="{Binding FromHistory}" Text="{Binding From}" Grid.Column="1" HorizontalAlignment="Stretch" Margin="3" />
        <Button x:Name="FromBrowseButton" Command="{Binding BrowseFromCommand}" Grid.Column="2" HorizontalAlignment="Stretch" Margin="3">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Image Source="{local:UpstreamImage BrowseFileExplorer}" Width="16" Height="16" />
            <AccessText Text="_Browse" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <AccessText Grid.Row="1" Text="_Destination:" VerticalAlignment="Center" Margin="3,3,12,3" />
        <ComboBox IsEditable="True" x:Name="ToBox" ItemsSource="{Binding Destinations}" Text="{Binding Destination}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="3" />
        <Button x:Name="ToBrowseButton" Command="{Binding BrowseDestinationCommand}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Margin="3">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Image Source="{local:UpstreamImage BrowseFileExplorer}" Width="16" Height="16" />
            <AccessText Text="B_rowse" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <AccessText Grid.Row="2" Text="_Subdirectory to create:" VerticalAlignment="Center" Margin="3,3,12,3" />
        <TextBox x:Name="SubdirectoryBox" Text="{Binding Subdirectory}" Grid.Row="2" Grid.Column="1" Margin="3" />
        <AccessText Grid.Row="3" Text="Br_anch:" VerticalAlignment="Center" Margin="3,3,12,3" />
        <ComboBox IsEditable="True" x:Name="BranchesBox" ItemsSource="{Binding BranchItems}" Text="{Binding Branch}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                  Margin="3" />
      </Grid>
      <Border Margin="3,13,3,0" MinHeight="42" Padding="3" BorderThickness="1"
              Background="{DynamicResource InfoBackgroundBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <TextBlock x:Name="InfoText" Text="{Binding LocationInfo}" Classes.error="{Binding LocationIsError}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Border>
      <HeaderedContentControl Classes="groupBox" Header="Repository type" Margin="3,4,3,0">
        <StackPanel Margin="14,0,0,0">
          <RadioButton x:Name="PersonalRepositoryRadio" Content="_Personal repository"
                       IsChecked="{Binding Bare, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:False}}" />
          <RadioButton x:Name="CentralRepositoryRadio" IsChecked="{Binding Bare}" Content="P_ublic repository, no working directory  (--bare)" />
        </StackPanel>
      </HeaderedContentControl>
      <WrapPanel Margin="0,10,0,0">
        <CheckBox x:Name="InitializeSubmodulesCheck" Content="Initialize all submodules" IsChecked="{Binding InitializeAllSubmodules}"
                  Margin="15,3,9,3" />
        <CheckBox x:Name="DownloadFullHistoryCheck" Content="Download full _history" IsChecked="{Binding DownloadFullHistory}" Margin="15,3,9,3"
                  ToolTip.Tip="The default Git behavior is to download all historical revisions.&#10;If you turn this off, we'll only download the latest revision for all branches.&#10;&#10;Actual command line (if unchecked): --depth 1 --no-single-branch" />
      </WrapPanel>
    </StackPanel>
  </DockPanel>
</Window>
