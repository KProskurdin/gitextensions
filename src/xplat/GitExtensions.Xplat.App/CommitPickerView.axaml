<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitExtensions.Xplat.App"
             xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
             x:Class="GitExtensions.Xplat.App.CommitPickerView">
  <!-- Upstream's CommitPickerSmallControl: the commit's short hash, editable, the button that picks it in the choose
       commit window, and how far it is from HEAD. -->
  <StackPanel x:Name="LayoutRoot" Orientation="Horizontal" VerticalAlignment="Center" x:DataType="core:CommitPickerViewModel">
    <TextBox x:Name="CommitHashBox" Width="104" VerticalContentAlignment="Center" Text="{Binding HashText}" />
    <Button x:Name="buttonPickCommit" Padding="3" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding PickCommand}">
      <Image Source="{local:UpstreamImage SelectRevision}" Width="16" Height="16" />
    </Button>
    <TextBlock x:Name="CommitCountText" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding CountText}" />
  </StackPanel>
</UserControl>
