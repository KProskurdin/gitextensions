<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scripts="using:GitExtensions.Xplat.Core.Scripts"
        xmlns:settings="using:GitExtensions.Xplat.Core.Settings"
        xmlns:local="using:GitExtensions.Xplat.App"
        x:Class="GitExtensions.Xplat.App.SettingsWindow"
        Title="Settings"
        Width="958" Height="646" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- The pages are the tab control's items; the tree chooses them, so the tab strip is not shown. -->
    <Style Selector="TabControl#Tabs /template/ ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TreeView#SettingsTree TreeViewItem" x:DataType="local:SettingsPageNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <!-- Upstream marks the pages the search finds in the system's selection colors. -->
    <Style Selector="StackPanel.found">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.found > TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
  <!-- Upstream's FormSettings: the page tree (SettingsTreeViewUserControl, 200 pixels wide, its search box above it) beside
       the page, and the buttons under the page. -->
  <Grid Margin="3" ColumnDefinitions="200,6,*" RowDefinitions="*,Auto">
    <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
      <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Top" Margin="0,8" />
      <TreeView x:Name="SettingsTree">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="local:SettingsPageNode" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="4" Classes.found="{Binding IsFound}">
              <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </DockPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,6,3,3">
      <TextBlock x:Name="ErrorText" Foreground="Firebrick" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
      <!-- Upstream's labelInstantSaveNotice, shown on the pages that save at once (the Checklist). -->
      <TextBlock x:Name="InstantSaveNoticeText" Text="{x:Static settings:SettingsChecklist.InstantSaveNotice}"
                 VerticalAlignment="Center" TextAlignment="Right" IsVisible="False" />
      <!-- Upstream's buttons in its order. -->
      <Button x:Name="SaveButton" Content="OK" IsDefault="True" MinWidth="84" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" />
      <Button x:Name="ApplyButton" Content="Apply" MinWidth="92" />
    </StackPanel>
    <TabControl x:Name="Tabs" Grid.Row="0" Grid.Column="2" Padding="0">
      <!-- Upstream's "Checklist" page, on the Git Extensions group's node: a row per check, green when the setting is
           right, red or yellow with a Repair button when not (rows built by SettingsWindow.Checklist). -->
      <TabItem x:Name="ChecklistTab" Header="Checklist">
        <StackPanel Spacing="4" Margin="4,8">
          <TextBlock Text="{x:Static settings:SettingsChecklist.Introduction}" TextWrapping="Wrap" Margin="0,0,0,6" />
          <Grid x:Name="ChecklistGrid" ColumnDefinitions="*,6,Auto" />
          <Button x:Name="ChecklistRescanButton" Content="{x:Static settings:SettingsChecklist.SaveAndRescanText}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's root pages: the Git and Plugins groups' introductions. -->
      <TabItem x:Name="GitRootTab" Header="Git Settings">
        <TextBlock Margin="4,8" TextWrapping="Wrap" Text="Select one of the subnodes to view or edit the Git settings" />
      </TabItem>
      <TabItem x:Name="PluginsRootTab" Header="Plugins Settings">
        <TextBlock Margin="4,8" TextWrapping="Wrap"
                   Text="Select one of the subnodes to view or edit the settings of a Git Extensions Plugin." />
      </TabItem>
      <!-- Upstream's "Colors" page: its "Theme" group, the CSS themes next to the app and the user's own, and the
           colorblind variation. -->
      <TabItem x:Name="ColorsTab" Header="Colors">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Theme" FontWeight="SemiBold" />
          <ComboBox x:Name="ThemeBox" MinWidth="260" />
          <CheckBox x:Name="ColorblindCheck" Content="Colorblind" />
          <TextBlock Text="Shared with Git Extensions for Windows: the same theme files (Themes folder) and setting." Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
      <TabItem x:Name="AppearanceTab" Header="Appearance">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="General" FontWeight="SemiBold" />
          <CheckBox x:Name="RelativeDateCheck" Content="Show relative date instead of full date" />
          <CheckBox x:Name="ShowRepoBranchCheck" Content="Show current branch names in the dashboard and the recent repositories dropdown menu" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Truncate long filenames" VerticalAlignment="Center" />
            <ComboBox x:Name="TruncatePathBox" MinWidth="160" />
          </StackPanel>
          <!-- Upstream's "Author images" group. -->
          <TextBlock Text="Author images" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox x:Name="ShowAvatarColumnCheck" Content="Show author's avatar column in the commit graph" />
          <CheckBox x:Name="ShowAvatarInCommitInfoCheck" Content="Show author's avatar in the commit info view" />
          <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto">
            <TextBlock Grid.Row="0" Text="Avatar provider" VerticalAlignment="Center" />
            <ComboBox x:Name="AvatarProviderBox" Grid.Row="0" Grid.Column="2" MinWidth="200" />
            <TextBlock Grid.Row="2" Text="Fallback generated avatar style" VerticalAlignment="Center" />
            <ComboBox x:Name="AvatarFallbackBox" Grid.Row="2" Grid.Column="2" MinWidth="200" />
            <TextBlock Grid.Row="4" Text="Custom avatar template" VerticalAlignment="Center" />
            <TextBox x:Name="CustomAvatarTemplateBox" Grid.Row="4" Grid.Column="2" />
            <TextBlock Grid.Row="6" Text="Cache images (days)" VerticalAlignment="Center" />
            <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <NumericUpDown x:Name="AvatarCacheDaysBox" Minimum="0" Maximum="1000" Increment="1" FormatString="0" Width="130" />
              <Button x:Name="ClearImageCacheButton" Content="Clear image cache" />
            </StackPanel>
          </Grid>
          <!-- Upstream's "Language" group: upstream's translations (Translation folder), shared with Git Extensions for
               Windows through the same setting. -->
          <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Language (restart required)" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageBox" MinWidth="200" />
            <HyperlinkButton x:Name="HelpTranslateButton" Content="Help translate" NavigateUri="https://github.com/gitextensions/gitextensions/wiki/Translations" />
          </StackPanel>
          <TextBlock Text="Upstream's translations of Git Extensions. Texts this app has that Git Extensions for Windows does not have stay English." Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Fonts" page. Avalonia has no font dialog: the family is chosen from the installed ones and the size
           typed in points, as upstream stores it. Upstream needs a restart; here the fonts change when OK is pressed. -->
      <TabItem x:Name="FontsTab" Header="Fonts">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Fonts" FontWeight="SemiBold" />
          <Grid x:Name="FontsGrid" ColumnDefinitions="Auto,8,*,8,Auto,8,Auto,8,Auto" />
          <TextBlock Text="Sizes are in points. &quot;(default)&quot; keeps this app's own font." Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
      <TabItem x:Name="GeneralTab" Header="General">
        <StackPanel Spacing="8" Margin="4,8">
          <CheckBox x:Name="CloseAfterCommitCheck" Content="Close the commit window after a commit" />
          <CheckBox x:Name="CloseProcessDialogCheck" Content="Close the output window when a fetch, pull or push succeeds" />
          <CheckBox x:Name="StartWithRecentWorkingDirCheck" Content="Open last working directory on startup" />
          <CheckBox x:Name="FollowRenamesInFileHistoryCheck" Content="Follow renames in file history" />
          <CheckBox x:Name="FollowRenamesExactCheck" Content="Follow exact renames and copies only" Margin="24,0,0,0" />
          <CheckBox x:Name="UseHistogramDiffCheck" Content="Use histogram diff algorithm" />
          <CheckBox x:Name="StashUntrackedFilesCheck" Content="Include untracked files in autostash" />
          <CheckBox x:Name="UpdateSubmodulesCheck" Content="Update submodules on checkout" IsThreeState="True"
                    ToolTip.Tip="Undecided: ask at each checkout" />
          <CheckBox x:Name="CheckUncommittedChangesCheck" Content="Check for uncommitted changes in checkout branch dialog" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Default pull action" VerticalAlignment="Center" />
            <ComboBox x:Name="DefaultPullActionBox" MinWidth="200" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Revision grid quick search timeout [ms]" VerticalAlignment="Center" />
            <NumericUpDown x:Name="QuickSearchTimeoutBox" Minimum="250" Maximum="10000" Increment="100" FormatString="0" Width="130" />
          </StackPanel>
          <TextBlock Text="Performance" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox x:Name="ShowCommitCountCheck" Content="Show number of changed files on commit button" />
          <CheckBox x:Name="ShowArtificialCountCheck" Content="Show number of changed files for artificial commits" />
          <CheckBox x:Name="ShowAheadBehindCheck" Content="Show ahead and behind information on status bar in browse window" />
          <CheckBox x:Name="ShowStashCountCheck" Content="Show stash count on status bar in browse window" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox x:Name="CommitsLimitCheck" Content="Limit number of commits to be loaded" />
            <NumericUpDown x:Name="CommitsLimitBox" Minimum="1" Maximum="10000000" Increment="1000" FormatString="0" Width="150" />
          </StackPanel>
          <TextBlock Text="Default clone destination" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBox x:Name="DefaultCloneDestinationBox" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Recent repositories to keep" VerticalAlignment="Center" />
            <NumericUpDown x:Name="RecentSizeBox" Minimum="1" Maximum="200" Increment="1" FormatString="0" Width="130" />
          </StackPanel>
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Paths" page (GitSettingsPage: paths and environment) with its "Change HOME" choices (FormFixHome)
           on the page. -->
      <TabItem x:Name="GitTab" Header="Paths">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Paths" FontWeight="SemiBold" />
          <TextBlock Text="Command used to run git (empty: look it up on PATH)" />
          <DockPanel>
            <Button x:Name="BrowseGitCommandButton" DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" />
            <TextBox x:Name="GitCommandBox" />
          </DockPanel>
          <StackPanel x:Name="LinuxToolsPanel" Spacing="8">
            <TextBlock Text="Path to linux tools (sh). Leave empty when it is in the path." />
            <DockPanel>
              <Button x:Name="BrowseLinuxToolsButton" DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" />
              <TextBox x:Name="LinuxToolsDirBox" />
            </DockPanel>
          </StackPanel>
          <TextBlock Text="Environment" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock x:Name="HomeText" TextWrapping="Wrap" />
          <TextBlock Text="By default, the global config file is located in the folder HOME names. (This can be overridden by setting GIT_CONFIG_GLOBAL.)" Opacity="0.7" TextWrapping="Wrap" />
          <StackPanel x:Name="HomeChoicePanel" Spacing="6">
            <TextBlock Text="HOME" FontWeight="SemiBold" Margin="0,8,0,0" />
            <RadioButton x:Name="DefaultHomeRadio" GroupName="Home" />
            <RadioButton x:Name="UserProfileHomeRadio" GroupName="Home" />
            <RadioButton x:Name="OtherHomeRadio" GroupName="Home" Content="Other" />
            <DockPanel Margin="24,0,0,0">
              <Button x:Name="BrowseHomeButton" DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" />
              <TextBox x:Name="OtherHomeBox" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <!-- Upstream's "SSH" page. -->
      <TabItem x:Name="SshTab" Header="SSH">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Specify which ssh client to use" FontWeight="SemiBold" />
          <RadioButton x:Name="OpenSshRadio" GroupName="Ssh" Content="OpenSSH" />
          <RadioButton x:Name="PuttyRadio" GroupName="Ssh" Content="PuTTY" />
          <RadioButton x:Name="OtherSshRadio" GroupName="Ssh" Content="Other ssh client" />
          <DockPanel Margin="24,0,0,0">
            <Button x:Name="BrowseOtherSshButton" DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" />
            <TextBox x:Name="OtherSshBox" />
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Opacity="0.7"
                     Text="OpenSSH is the ssh client git uses itself. Another client is given to git in GIT_SSH." />
          <StackPanel x:Name="PuttyPanel" Spacing="8">
            <TextBlock Text="Configure PuTTY" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="Auto,8,*,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
              <TextBlock Grid.Row="0" Text="Path to plink" VerticalAlignment="Center" />
              <TextBox x:Name="PlinkBox" Grid.Row="0" Grid.Column="2" />
              <Button x:Name="BrowsePlinkButton" Grid.Row="0" Grid.Column="4" Content="Browse" />
              <TextBlock Grid.Row="2" Text="Path to puttygen" VerticalAlignment="Center" />
              <TextBox x:Name="PuttygenBox" Grid.Row="2" Grid.Column="2" />
              <Button x:Name="BrowsePuttygenButton" Grid.Row="2" Grid.Column="4" Content="Browse" />
              <TextBlock Grid.Row="4" Text="Path to pageant" VerticalAlignment="Center" />
              <TextBox x:Name="PageantBox" Grid.Row="4" Grid.Column="2" />
              <Button x:Name="BrowsePageantButton" Grid.Row="4" Grid.Column="4" Content="Browse" />
            </Grid>
            <CheckBox x:Name="AutoStartPageantCheck">
              <TextBlock TextWrapping="Wrap" Text="Automatically start authentication client when a private key is configured for a remote" />
            </CheckBox>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Browse repository window" page: the setting whose feature the browse window has. -->
      <TabItem x:Name="BrowseRepositoryTab" Header="Browse repository window">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="General" FontWeight="SemiBold" />
          <CheckBox x:Name="ShowRevisionTooltipsCheck" Content="Show revision tooltips" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Detailed" page: its revision graph group. The push and merge window options are not ported. -->
      <TabItem x:Name="DetailedTab" Header="Detailed">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Revision graph" FontWeight="SemiBold" />
          <CheckBox x:Name="MergeGraphLanesCheck" Content="Merge graph lanes having common parent" />
          <CheckBox x:Name="GraphDiagonalsCheck" Content="Render graph with diagonals" />
          <CheckBox x:Name="StraightenDiagonalsCheck" Content="Straighten graph diagonals" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Commit dialog" page: the settings whose feature the commit window has. -->
      <TabItem x:Name="CommitDialogTab" Header="Commit dialog">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Behaviour" FontWeight="SemiBold" />
          <CheckBox x:Name="ShowStagingErrorsCheck" Content="Show errors when staging files" />
          <CheckBox x:Name="SecondLineEmptyCheck" Content="Ensure the second line of commit message is empty" />
          <CheckBox x:Name="RememberAmendCheck" Content="Remember 'Amend commit' checkbox on commit form close" />
          <CheckBox x:Name="AutocompleteCheck" Content="Provide auto-completion in commit dialog" />
          <CheckBox x:Name="ComposeInWindowCheck" Content="Compose commit messages in Commit dialog (otherwise the message will be requested during commit)" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Number of previous messages in commit dialog" VerticalAlignment="Center" />
            <NumericUpDown x:Name="PreviousMessagesBox" Minimum="1" Maximum="999" Increment="1" FormatString="0" Width="130" />
          </StackPanel>
          <TextBlock Text="Show additional buttons in commit button area" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox x:Name="ShowCommitAndPushCheck" Content="Commit &amp; Push" />
          <CheckBox x:Name="ShowResetUnstagedCheck" Content="Reset Unstaged Changes" />
          <CheckBox x:Name="ShowResetAllCheck" Content="Reset All Changes" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Advanced" page: the settings whose feature the new shell has. -->
      <TabItem x:Name="AdvancedTab" Header="Advanced">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Checkout" FontWeight="SemiBold" />
          <CheckBox x:Name="AlwaysShowCheckoutDlgCheck" Content="Always show checkout dialog" />
          <CheckBox x:Name="UseLocalChangesActionCheck">
            <TextBlock TextWrapping="Wrap" Text="Use last chosen &quot;local changes&quot; action as default action. This action will be performed without warning while checking out branch." />
          </CheckBox>
          <TextBlock Text="General" FontWeight="SemiBold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox x:Name="AutoNormaliseCheck" Content="Auto normalise branch name" />
            <TextBlock Text="Symbol to use:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="NormaliseSymbolBox" MinWidth="90" />
          </StackPanel>
          <TextBlock Text="Commit" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox x:Name="CommitAndPushForcedCheck" Content="Push forced with lease when Commit &amp; Push action is performed with Amend option checked" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Diff viewer" page: the settings of the diff view's choices, its ruler and the difftool list. -->
      <TabItem x:Name="DiffViewerTab" Header="Diff viewer">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="General" FontWeight="SemiBold" />
          <CheckBox x:Name="RememberIgnoreWhitespaceCheck" Content="Remember the 'Ignore whitespaces' preference" />
          <CheckBox x:Name="RememberNonPrintingCheck" Content="Remember the 'Show nonprinting characters' preference" />
          <CheckBox x:Name="RememberEntireFileCheck" Content="Remember the 'Show entire file' preference" />
          <CheckBox x:Name="RememberContextLinesCheck" Content="Remember the 'Number of context lines' preference" />
          <CheckBox x:Name="RememberSyntaxHighlightingCheck" Content="Remember the 'Show syntax highlighting' preference" />
          <CheckBox x:Name="ShowAllDiffToolsCheck" Content="Show all available difftools" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Vertical ruler position [chars]" VerticalAlignment="Center" />
            <NumericUpDown x:Name="VerticalRulerBox" Minimum="0" Maximum="1000" Increment="1" FormatString="0" Width="130" />
          </StackPanel>
          <Button x:Name="SaveDiffDefaultsButton" Content="Save current view settings as default" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Blame viewer" page, the blame window's settings. -->
      <TabItem x:Name="BlameViewerTab" Header="Blame viewer">
        <StackPanel Spacing="8" Margin="4,8">
          <TextBlock Text="Blame settings" FontWeight="SemiBold" />
          <CheckBox x:Name="BlameIgnoreWhitespaceCheck" Content="Ignore whitespace" />
          <CheckBox x:Name="BlameDetectMoveInFileCheck" Content="Detect moved or copied lines within blamed file" />
          <CheckBox x:Name="BlameDetectMoveInAllFilesCheck" Content="Detect moved or copied lines from all files in same commit" />
          <TextBlock Text="Display result settings" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox x:Name="BlameDisplayAuthorFirstCheck" Content="Display author first" />
          <CheckBox x:Name="BlameShowAuthorCheck" Content="Show author" />
          <CheckBox x:Name="BlameShowAuthorDateCheck" Content="Show author date" />
          <CheckBox x:Name="BlameShowAuthorTimeCheck" Content="Show author time" />
          <CheckBox x:Name="BlameShowLineNumbersCheck" Content="Show line numbers" />
          <CheckBox x:Name="BlameShowOriginalFilePathCheck" Content="Show original file path" />
          <CheckBox x:Name="BlameShowAuthorAvatarCheck" Content="Show author avatar" />
        </StackPanel>
      </TabItem>
      <!-- Upstream's "Sorting" page: the grid's commit order and the left panel's branch order. -->
      <TabItem x:Name="SortingTab" Header="Sorting">
        <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto" Margin="4,8">
          <TextBlock Grid.Row="0" Text="Sort revisions by" VerticalAlignment="Center" />
          <ComboBox x:Name="RevisionSortBox" Grid.Row="0" Grid.Column="2" MinWidth="200" />
          <TextBlock Grid.Row="2" Text="Sort branches by" VerticalAlignment="Center" />
          <ComboBox x:Name="BranchesSortByBox" Grid.Row="2" Grid.Column="2" MinWidth="200" />
          <TextBlock Grid.Row="4" Text="Order branches" VerticalAlignment="Center" />
          <ComboBox x:Name="BranchesOrderBox" Grid.Row="4" Grid.Column="2" MinWidth="200" />
          <TextBlock Grid.Row="6" Text="Prioritized branches" VerticalAlignment="Center" />
          <TextBox x:Name="PrioritizedBranchesBox" Grid.Row="6" Grid.Column="2" />
          <TextBlock Grid.Row="8" Text="Prioritized remotes" VerticalAlignment="Center" />
          <TextBox x:Name="PrioritizedRemotesBox" Grid.Row="8" Grid.Column="2" />
        </Grid>
      </TabItem>
      <!-- Upstream's "Revision links" page: link definitions that turn commit data into links in the commit details. -->
      <TabItem x:Name="RevisionLinksTab" Header="Revision links">
        <DockPanel Margin="4,8">
        <Grid ColumnDefinitions="200,12,*">
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Categories" FontWeight="SemiBold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
              <Button x:Name="AddRevisionLinkButton" Content="Add" HorizontalAlignment="Stretch" />
              <StackPanel x:Name="RevisionLinkTemplateButtons" Spacing="4" />
              <Button x:Name="RemoveRevisionLinkButton" Content="Remove" HorizontalAlignment="Stretch" />
            </StackPanel>
            <ListBox x:Name="RevisionLinksList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="settings:RevisionLinkItem">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ScrollViewer Grid.Column="2">
            <StackPanel x:Name="RevisionLinkDetails" Spacing="6" x:DataType="settings:RevisionLinkItem">
              <Grid ColumnDefinitions="Auto,8,*,12,Auto">
                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox x:Name="RevisionLinkNameBox" Grid.Column="2" Text="{Binding Name}" />
                <CheckBox x:Name="RevisionLinkEnabledCheck" Grid.Column="4" Content="Enabled" IsChecked="{Binding Enabled}" />
              </Grid>
              <TextBlock Text="Revision data" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,6,Auto,6,Auto">
                <TextBlock Grid.Row="0" Text="Search in" VerticalAlignment="Center" />
                <WrapPanel Grid.Row="0" Grid.Column="2">
                  <CheckBox x:Name="RevisionLinkMessageCheck" Content="Message" IsChecked="{Binding SearchMessage}" Margin="0,0,12,0" />
                  <CheckBox x:Name="RevisionLinkLocalBranchCheck" Content="Local branch name" IsChecked="{Binding SearchLocalBranches}" Margin="0,0,12,0" />
                  <CheckBox x:Name="RevisionLinkRemoteBranchCheck" Content="Remote branch name" IsChecked="{Binding SearchRemoteBranches}" />
                </WrapPanel>
                <TextBlock Grid.Row="2" Text="Search pattern" VerticalAlignment="Center" />
                <TextBox x:Name="RevisionLinkSearchPatternBox" Grid.Row="2" Grid.Column="2" Text="{Binding SearchPattern}" />
                <TextBlock Grid.Row="4" Text="Nested pattern" VerticalAlignment="Center" />
                <TextBox x:Name="RevisionLinkNestedPatternBox" Grid.Row="4" Grid.Column="2" Text="{Binding NestedSearchPattern}" />
              </Grid>
              <TextBlock Text="Remote data" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="Auto,8,*,12,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                <TextBlock Grid.Row="0" Text="Use remotes" VerticalAlignment="Center" />
                <TextBox x:Name="RevisionLinkUseRemotesBox" Grid.Row="0" Grid.Column="2" Text="{Binding UseRemotesPattern}" />
                <CheckBox x:Name="RevisionLinkFirstRemoteCheck" Grid.Row="0" Grid.Column="4" Content="Only use the first match" IsChecked="{Binding UseOnlyFirstRemote}" />
                <TextBlock Grid.Row="2" Text="Search in" VerticalAlignment="Center" />
                <WrapPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                  <CheckBox x:Name="RevisionLinkUrlCheck" Content="URL" IsChecked="{Binding SearchRemoteUrl}" Margin="0,0,12,0" />
                  <CheckBox x:Name="RevisionLinkPushUrlCheck" Content="Push URL" IsChecked="{Binding SearchRemotePushUrl}" />
                </WrapPanel>
                <TextBlock Grid.Row="4" Text="Search pattern" VerticalAlignment="Center" />
                <TextBox x:Name="RevisionLinkRemotePatternBox" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding RemoteSearchPattern}" />
              </Grid>
              <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="150,8,*,8,Auto">
                <TextBlock Text="Caption" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="URI" Opacity="0.7" />
              </Grid>
              <ItemsControl x:Name="RevisionLinkFormatsList" ItemsSource="{Binding Formats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:RevisionLinkFormatItem">
                    <Grid ColumnDefinitions="150,8,*,8,Auto" Margin="0,0,0,4">
                      <TextBox Text="{Binding Caption}" />
                      <TextBox Grid.Column="2" Text="{Binding Format}" />
                      <Button Grid.Column="4" Name="RemoveRevisionLinkFormatButton" Content="Remove" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="AddRevisionLinkFormatButton" Content="Add link" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        </DockPanel>
      </TabItem>
      <!-- Upstream's "Build server integration" page, on the repository's settings as the revision links: the type, whether
           the integration is on (undecided: decided by a lower settings level, or detected from the remotes), and the
           plugin's own settings control for the type. -->
      <TabItem x:Name="BuildServerTab" Header="Build server integration">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="4,8">
            <TextBlock Text="Git Extensions can integrate with build servers to supply per-commit Continuous Integration information."
                       TextWrapping="Wrap" Opacity="0.7" />
            <CheckBox x:Name="EnableBuildServerCheck" Content="Enable build server integration" IsThreeState="True" />
            <CheckBox x:Name="ShowBuildResultPageCheck" Content="Show build result page" IsThreeState="True" IsEnabled="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Build server type" VerticalAlignment="Center" />
              <ComboBox x:Name="BuildServerTypeBox" MinWidth="220" />
            </StackPanel>
            <TextBlock x:Name="BuildServerNoRepositoryText" Text="Open a repository to set up its build server." Opacity="0.7"
                       IsVisible="False" />
            <ContentControl x:Name="BuildServerSettingsPanel" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Upstream's "Config" page under Git (GitConfigSettingsPage): one column of git's own settings at the level the
           page header chooses, in upstream's order. The tool and editor boxes offer what git and this computer have. -->
      <TabItem x:Name="GitConfigTab" Header="Config">
        <Grid ColumnDefinitions="Auto,8,*,8,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4,8">
          <TextBlock Grid.Row="0" Text="User name" VerticalAlignment="Center" />
          <TextBox x:Name="UserNameBox" Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" />
          <TextBlock Grid.Row="1" Text="User email" VerticalAlignment="Center" />
          <TextBox x:Name="UserEmailBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,6" />
          <TextBlock x:Name="lblCredentialHelper" Grid.Row="2" Text="Credential helper" VerticalAlignment="Center" />
          <ComboBox x:Name="CredentialHelperBox" Grid.Row="2" Grid.Column="2" IsEditable="True"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6" />
          <TextBlock Grid.Row="3" Text="Editor" VerticalAlignment="Center" />
          <ComboBox x:Name="EditorBox" Grid.Row="3" Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" />
          <TextBlock Grid.Row="4" Text="Mergetool" VerticalAlignment="Center" />
          <ComboBox x:Name="MergeToolBox" Grid.Row="4" Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" />
          <TextBlock Grid.Row="5" Text="Difftool" VerticalAlignment="Center" />
          <ComboBox x:Name="DiffToolBox" Grid.Row="5" Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" />
          <TextBlock Grid.Row="6" Text="Path to commit template" VerticalAlignment="Center" />
          <TextBox x:Name="CommitTemplateBox" Grid.Row="6" Grid.Column="2" Margin="0,0,0,6" />
          <Button x:Name="BrowseCommitTemplateButton" Grid.Row="6" Grid.Column="4" Content="Browse" Margin="0,0,0,6" />
          <!-- Upstream's groupBoxLineEndings. -->
          <StackPanel Grid.Row="7" Grid.ColumnSpan="5" Spacing="4" Margin="0,6,0,0">
            <TextBlock Text="Line endings" FontWeight="SemiBold" />
            <RadioButton x:Name="AutoCrlfTrueRadio" GroupName="AutoCrlf" />
            <RadioButton x:Name="AutoCrlfInputRadio" GroupName="AutoCrlf" />
            <RadioButton x:Name="AutoCrlfFalseRadio" GroupName="AutoCrlf" />
            <RadioButton x:Name="AutoCrlfNotSetRadio" GroupName="AutoCrlf" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="ConfirmationsTab" Header="Confirmations">
        <DockPanel Margin="4,8" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" Text="Confirm actions" />
          <ScrollViewer>
            <StackPanel x:Name="ConfirmationsPanel" Spacing="2" />
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="ScriptsTab" Header="Scripts">
        <!-- As upstream's scripts settings page: the scripts in the order they run, and the selected script's values. -->
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,8,Auto" Margin="4,8">
          <ListBox x:Name="ScriptsList" Grid.Row="0" Grid.Column="0" MinHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="scripts:ScriptListItem">
                <Grid ColumnDefinitions="Auto,Auto,170,150,*" ToolTip.Tip="{Binding CommandLine}">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" MinWidth="0" Margin="0,0,6,0" />
                  <Image Grid.Column="1" Width="16" Height="16" Margin="0,0,6,0">
                    <Image.Source>
                      <MultiBinding Converter="{x:Static local:ScriptIconConverter.Instance}">
                        <Binding Path="Icon" />
                        <Binding Path="IconFilePath" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                  <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding EventText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                  <TextBlock Grid.Column="4" Text="{Binding CommandLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
            <Button x:Name="AddScriptButton" Content="Add" HorizontalAlignment="Stretch" />
            <Button x:Name="DeleteScriptButton" Content="Delete" HorizontalAlignment="Stretch" />
            <Button x:Name="MoveScriptUpButton" Content="Up" HorizontalAlignment="Stretch" />
            <Button x:Name="MoveScriptDownButton" Content="Down" HorizontalAlignment="Stretch" />
            <Button x:Name="ScriptHelpButton" Content="?" HorizontalAlignment="Stretch" ToolTip.Tip="Arguments help" />
          </StackPanel>
          <Grid x:Name="ScriptDetails" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:DataType="scripts:ScriptListItem"
                ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
            <TextBox x:Name="ScriptNameBox" Grid.Row="0" Grid.Column="2" Text="{Binding Name}" Margin="0,0,0,6"
                     ToolTip.Tip="An &amp; before a letter makes it the menu's access key" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Command" VerticalAlignment="Center" />
            <TextBox x:Name="ScriptCommandBox" Grid.Row="1" Grid.Column="2" Text="{Binding Command}" Margin="0,0,0,6"
                     PlaceholderText="A program, {openurl} or navigateTo:program" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments" VerticalAlignment="Center" />
            <TextBox x:Name="ScriptArgumentsBox" Grid.Row="2" Grid.Column="2" Text="{Binding Arguments}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="On event" VerticalAlignment="Center" />
            <ComboBox x:Name="ScriptEventBox" Grid.Row="3" Grid.Column="2" SelectedItem="{Binding OnEvent}" MinWidth="200" Margin="0,0,0,6" />
            <!-- Upstream's Icon (one of its images) and "Icon or associated file path". -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Icon" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="2" ColumnDefinitions="Auto,8,*,4,Auto" Margin="0,0,0,6">
              <ComboBox x:Name="ScriptIconBox" Grid.Column="0" MinWidth="200" SelectedValue="{Binding Icon}" MaxDropDownHeight="300" />
              <TextBox x:Name="ScriptIconFileBox" Grid.Column="2" Text="{Binding IconFilePath}"
                       PlaceholderText="Icon or associated file path (an image file)" />
              <Button x:Name="ScriptIconFileButton" Grid.Column="4" Content="Browse..." />
            </Grid>
            <WrapPanel Grid.Row="5" Grid.Column="2">
              <CheckBox x:Name="ScriptEnabledCheck" Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,12,0" />
              <CheckBox x:Name="ScriptGridMenuCheck" Content="In the revision grid menu" IsChecked="{Binding AddToRevisionGridContextMenu}" Margin="0,0,12,0" />
              <CheckBox x:Name="ScriptAskCheck" Content="Ask for confirmation" IsChecked="{Binding AskConfirmation}" Margin="0,0,12,0" />
              <CheckBox x:Name="ScriptBackgroundCheck" Content="Run in background" IsChecked="{Binding RunInBackground}" Margin="0,0,12,0" />
              <CheckBox x:Name="ScriptPowerShellCheck" Content="PowerShell" IsChecked="{Binding IsPowerShell}"
                        ToolTip.Tip="Run with PowerShell (pwsh outside Windows)" />
            </WrapPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="HotkeysTab" Header="Hotkeys">
        <DockPanel Margin="4,8" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                     Text="Click a box and press the new key combination. Shared with Git Extensions for Windows; Ctrl is Cmd on macOS. Script hotkeys list the saved scripts." />
          <ScrollViewer>
            <StackPanel x:Name="HotkeysPanel" Spacing="4" />
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <!-- A plugin's page (upstream's PluginSettingsPage); the tree's plugin nodes choose the plugin. -->
      <TabItem x:Name="PluginsTab" Header="Plugin">
        <Grid Margin="4,8">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="PluginTitleText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ScrollViewer>
              <StackPanel x:Name="PluginSettingsPanel" Spacing="6" />
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
