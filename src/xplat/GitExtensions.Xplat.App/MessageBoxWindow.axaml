<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.Presentation"
        x:Class="GitExtensions.Xplat.App.MessageBoxWindow"
        x:DataType="vm:MessageBoxViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- WinForms' message box and task dialog. Bound to MessageBoxViewModel (PLAN.md principle 6); the buttons are made from
       its choices in code, named as tests and WinForms' results know them. -->
  <StackPanel Margin="16" Spacing="12">
    <!-- A task dialog's heading, larger as WinForms shows it. -->
    <TextBlock x:Name="HeadingText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Text="{Binding Heading}"
               IsVisible="{Binding Heading, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" MaxHeight="400" Text="{Binding Text}" />
    <StackPanel x:Name="CommandLinksPanel" IsVisible="False" Spacing="4" />
    <DockPanel>
      <CheckBox x:Name="VerificationCheck" DockPanel.Dock="Left" VerticalAlignment="Center"
                IsVisible="{Binding VerificationText, Converter={x:Static ObjectConverters.IsNotNull}}"
                IsChecked="{Binding VerificationChecked}">
        <AccessText Text="{Binding VerificationText}" />
      </CheckBox>
      <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
    </DockPanel>
  </StackPanel>
</Window>
