<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitExtensions.Xplat.App"
             x:Class="GitExtensions.Xplat.App.DiffView">
  <DockPanel LastChildFill="True">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
      <CheckBox x:Name="IgnoreWhitespaceCheck" DockPanel.Dock="Right" Content="Ignore whitespace" Margin="8,0,0,0" />
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Firebrick" TextWrapping="Wrap" IsVisible="False" />
    <ListBox x:Name="DiffList" FontFamily="{DynamicResource DiffFontFamily}" Padding="0" SelectionMode="Multiple">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:DiffLineItem">
          <Grid ColumnDefinitions="44,44,*">
            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Opacity="0.55" TextAlignment="Right" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Opacity="0.55" TextAlignment="Right" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding Foreground}" Background="{Binding Background}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
