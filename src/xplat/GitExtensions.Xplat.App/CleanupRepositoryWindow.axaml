<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.CleanupRepositoryWindow"
        Title="Clean working directory"
        Width="542" SizeToContent="Height" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormCleanupRepository: what to remove, the directories and submodules choices, the paths to clean and to
       keep, Preview, Cleanup and Close, and git's output in the log. -->
  <StackPanel Margin="15" Spacing="6">
    <HeaderedContentControl x:Name="groupBox1" Classes="groupBox" Header="Remove untracked files from working directory">
      <StackPanel Spacing="4">
        <RadioButton x:Name="RemoveAll" GroupName="Mode" Content="Remove all untracked files" IsChecked="True" />
        <RadioButton x:Name="RemoveNonIgnored" GroupName="Mode" Content="Remove only non-ignored untracked files" />
        <RadioButton x:Name="RemoveIgnored" GroupName="Mode" Content="Remove only ignored untracked files" />
      </StackPanel>
    </HeaderedContentControl>
    <CheckBox x:Name="RemoveDirectories" Content="Remove untracked directories" IsChecked="True" Margin="9,0,0,0" />
    <CheckBox x:Name="CleanSubmodules" Content="Clean submodules recursively" Margin="9,0,0,0" />
    <Grid ColumnDefinitions="*,Auto" Margin="9,6,0,0">
      <CheckBox x:Name="checkBoxIncludePathFilter" Content="Affect the following directory path(s) only:" />
      <Button x:Name="AddInclusivePath" Grid.Column="1" Content="Add a path..." Width="150"
              HorizontalContentAlignment="Center" />
    </Grid>
    <TextBox x:Name="textBoxIncludePaths" AcceptsReturn="True" TextWrapping="NoWrap" Height="78" Margin="45,0,0,0" />
    <TextBlock x:Name="labelPathHintInclude" Text="(one path per line)" Margin="47,0,0,0" />
    <Grid ColumnDefinitions="*,Auto" Margin="9,6,0,0">
      <CheckBox x:Name="checkBoxExcludePathFilter" Content="Exclude the following file path(s):" />
      <Button x:Name="AddExclusivePath" Grid.Column="1" Content="Add a path..." Width="150"
              HorizontalContentAlignment="Center" />
    </Grid>
    <TextBox x:Name="textBoxExcludePaths" AcceptsReturn="True" TextWrapping="NoWrap" Height="78" Margin="45,0,0,0" />
    <TextBlock x:Name="labelPathHintExclude" Text="(one path per line)" Margin="47,0,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
      <Button x:Name="Preview" Content="Preview" Width="150" HorizontalContentAlignment="Center" />
      <Button x:Name="Cleanup" Content="Cleanup" Width="150" HorizontalContentAlignment="Center" />
      <Button x:Name="_NO_TRANSLATE_Close" Content="Close" Width="150" HorizontalContentAlignment="Center"
              IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="label1" Text="Log:" Margin="2,6,0,0" />
    <TextBox x:Name="PreviewOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="117" />
  </StackPanel>
</Window>
