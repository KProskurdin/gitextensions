<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.PromptWindow"
        Title="Git Extensions"
        Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock x:Name="LabelText" TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" />
    <TextBox x:Name="SecondValueBox" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
      <Button x:Name="OkButton" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
