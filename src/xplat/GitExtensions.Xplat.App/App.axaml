<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExtensions.Xplat.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- The first installed family wins: Windows, macOS, then the usual Linux monospace fonts. FontApplier replaces these
         with upstream's code and monospace fonts when they are set. -->
    <FontFamily x:Key="DiffFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <!-- Fluent's tab headers are sized for touch; the browse window's tabs are a compact strip, as in upstream. The tab's
         content inherits the size, so it is the application font's (FontApplier). -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <!-- Upstream's tab headers (CommitInfoTabControl's ImageList): a 16-pixel image before the text. -->
    <Style Selector="StackPanel.tabHeader">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="StackPanel.tabHeader > Image">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.tabHeader > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Upstream's toolstrips (ToolStripEx): flat items with their 16-pixel images, a light fill and a border only while
         the pointer is on them, thin vertical separators, no gaps. ToolButton, ToolDropDownButton and ToolSplitButton carry
         the "tool" class. -->
    <Style Selector="StackPanel.toolStrip">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="2,1,6,1" />
    </Style>
    <Style Selector="Rectangle.toolSeparator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool, ToggleButton.tool, DropDownButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
    </Style>
    <!-- A checked toolstrip button keeps the hover look (upstream's ToolStripButton.Checked), not Fluent's accent fill. -->
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector=":is(Button).tool:disabled Image">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="SplitButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="SplitButton.tool /template/ Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="SplitButton.tool /template/ Button#PART_SecondaryButton">
      <Setter Property="Padding" Value="1,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="14" />
    </Style>
    <Style Selector="SplitButton.tool:disabled Image">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Upstream's menu group captions (MenuUtil.SetAsCaptionMenuItem): disabled, in italics. -->
    <Style Selector="MenuItem.groupHeader">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- Upstream's PanelBackground (ThemeApplier sets it from the theme) behind every window, as upstream's forms use it. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <!-- Upstream's application font is bold or italic when the Fonts page says so (FontApplier). -->
      <Setter Property="FontWeight" Value="{DynamicResource ApplicationFontWeight}" />
      <Setter Property="FontStyle" Value="{DynamicResource ApplicationFontStyle}" />
    </Style>
  </Application.Styles>
</Application>
