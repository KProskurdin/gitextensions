<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer of the cross-platform app (PLAN.md M7, section 12.3), built by publish-app.sh win-* with WiX 3, the
  version upstream's setup/installer uses. Decided 2026-11-24: per user, and side by side with an installed Git Extensions.
  So it writes nothing under upstream's HKCU\Software\GitExtensions (InstallDir there names upstream's folder, which its
  Explorer extension starts) and registers no shell extension (upstream's has the same CLSID); the app's Shell extension
  page works with an installed Git Extensions' files. Its own state is under HKCU\Software\GitExtensions-xplat.

  Variables from publish-app.sh: Version (major.minor.build), AppDir (the published app), Icon (upstream's logo).
  The app's files come from heat as the component group AppFiles.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Git Extensions (cross-platform)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Git Extensions cross-platform fork"
           UpgradeCode="A1F60A60-36C2-45AD-9DCC-2EC626CC013D">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Description="Git Extensions (cross-platform)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Git Extensions (cross-platform) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="gitextensions.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="gitextensions.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/gitextensions/gitextensions" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="GitExtensions-xplat" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="30F92181-190C-41C2-BF6D-5B0723E3FB9F">
        <Shortcut Id="AppShortcut" Name="Git Extensions (cross-platform)" Description="Graphical user interface for git"
                  Target="[INSTALLDIR]GitExtensions.exe" WorkingDirectory="INSTALLDIR" Icon="gitextensions.ico" />
        <RegistryValue Root="HKCU" Key="Software\GitExtensions-xplat" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="App" Title="Git Extensions (cross-platform)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
