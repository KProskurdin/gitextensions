<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        x:Class="GitExtensions.Xplat.App.CommitDiffWindow"
        x:DataType="core:CommitDiffViewModel"
        Title="{Binding Title}" Width="717" Height="529" MinWidth="150" MinHeight="148"
        WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormCommitDiff: its CommitDiff filling the window, the window titled as the control (bound to the
       control's CommitDiffViewModel, PLAN.md principle 6). -->
  <local:CommitDiffView x:Name="CommitDiff" />
</Window>
