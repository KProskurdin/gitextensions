<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.ResetChangesWindow"
        x:DataType="vm:ResetChangesViewModel"
        Title="Reset changes"
        Width="420" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormResetChanges, bound to ResetChangesViewModel (PLAN.md principle 6). -->
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Text="{Binding Message}" />
    <CheckBox x:Name="DeleteNewFilesCheck" Content="Also delete _new files and/or directories"
              IsChecked="{Binding DeleteNewFiles}" IsEnabled="{Binding CanChooseDeleteNewFiles}" />
    <TextBlock x:Name="DeleteHintText" Text="This will delete any uncommitted work." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="ResetButton" Content="R_eset" Command="{Binding ResetCommand}" />
      <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
