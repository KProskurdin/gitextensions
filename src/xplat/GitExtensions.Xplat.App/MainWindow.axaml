<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        xmlns:repo="using:GitExtensions.Xplat.Core.Repository"
        x:Class="GitExtensions.Xplat.App.MainWindow"
        Title="Git Extensions"
        Width="1360" Height="820">
  <!-- Layout follows upstream FormBrowse: menu and toolbar on top, repository objects on the left, the revision grid,
       and the selected commit's tabs below it. -->
  <DockPanel LastChildFill="True">
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_Start">
        <MenuItem x:Name="OpenMenuItem" Header="_Open..." />
        <MenuItem x:Name="CloneMenuItem" Header="_Clone repository..." />
        <MenuItem x:Name="InitMenuItem" Header="Create _new repository..." />
        <MenuItem x:Name="RecentMenu" Header="_Recent repositories" />
        <Separator />
        <MenuItem x:Name="CloseRepositoryMenuItem" Header="Close repository" />
        <MenuItem x:Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Repository">
        <MenuItem x:Name="RefreshMenuItem" Header="_Refresh" />
        <MenuItem x:Name="FileExplorerMenuItem" Header="File _explorer" />
        <MenuItem x:Name="TerminalMenuItem" Header="Open _terminal" />
        <Separator />
        <MenuItem x:Name="FilesMenuItem" Header="_Browse files..." />
        <MenuItem x:Name="ReflogMenuItem" Header="Show _reflog..." />
        <MenuItem x:Name="GitIgnoreMenuItem" Header="Edit ._gitignore..." />
        <MenuItem x:Name="WorktreesMenuItem" Header="_Worktrees..." />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ShowAuthorDateMenuItem" Header="Sho_w author date" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowRelativeDateMenuItem" Header="Show relati_ve date" ToggleType="CheckBox" />
        <Separator />
        <!-- Upstream's graph styles: gray lanes for commits that are not relatives of the checked-out one, and the selected
             commit's ancestry in color until the next refresh (also Alt+click). -->
        <MenuItem x:Name="DrawNonRelativesGrayMenuItem" Header="Draw non relatives gra_y" ToggleType="CheckBox" />
        <MenuItem x:Name="HighlightSelectedBranchMenuItem" Header="Highlight selected branch (until refresh)" />
        <MenuItem x:Name="ShowArtificialCommitsMenuItem" Header="Show artificial commits" ToggleType="CheckBox" />
        <Separator />
        <!-- Upstream's "Grid info" toggles for the build status column. -->
        <MenuItem x:Name="ShowBuildStatusIconMenuItem" Header="Show build status _icon" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowBuildStatusTextMenuItem" Header="Show build status te_xt" ToggleType="CheckBox" />
      </MenuItem>
      <MenuItem Header="_Commands">
        <MenuItem x:Name="CommitMenuItem" Header="_Commit..." />
        <MenuItem x:Name="PullDialogMenuItem" Header="_Pull/Fetch..." />
        <MenuItem x:Name="PushDialogMenuItem" Header="P_ush..." />
        <MenuItem x:Name="PullMenuItem" Header="Quick pull" />
        <MenuItem x:Name="PushMenuItem" Header="Quick push" />
        <MenuItem x:Name="FetchMenuItem" Header="Quick _fetch" />
        <MenuItem x:Name="PushTagsMenuItem" Header="Push _tags" />
        <Separator />
        <MenuItem x:Name="StashMenuItem" Header="_Stash changes" />
        <MenuItem x:Name="StashPopMenuItem" Header="Stash p_op" />
        <Separator />
        <MenuItem x:Name="CreateBranchMenuItem" Header="Create _branch..." />
        <MenuItem x:Name="MergeMenuItem" Header="_Merge selected branch" />
        <MenuItem x:Name="RebaseMenuItem" Header="Re_base onto selected branch" />
        <MenuItem x:Name="CreateTagMenuItem" Header="Create _tag..." />
        <MenuItem x:Name="BisectMenuItem" Header="B_isect..." />
        <Separator />
        <MenuItem x:Name="ResolveConflictsMenuItem" Header="Solve _conflicts..." />
      </MenuItem>
      <!-- Upstream's "(Repository hosts)" menu: named after the repository host plugin, shown when one is loaded. -->
      <MenuItem x:Name="RepositoryHostsMenu" Header="(Repository hosts)" IsVisible="False">
        <MenuItem x:Name="ForkCloneRepositoryMenuItem" Header="_Fork/Clone repository..." />
        <MenuItem x:Name="ViewPullRequestsMenuItem" Header="View _pull requests..." />
        <MenuItem x:Name="CreatePullRequestsMenuItem" Header="_Create pull requests..." />
        <MenuItem x:Name="AddUpstreamRemoteMenuItem" Header="_Add upstream remote" />
      </MenuItem>
      <MenuItem x:Name="PluginsMenu" Header="_Plugins">
        <MenuItem x:Name="PluginsLoadingMenuItem" Header="Loading..." IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="PluginSettingsMenuItem" Header="Plugins _settings..." />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="CommandLogMenuItem" Header="Git _command log..." />
        <MenuItem x:Name="SettingsMenuItem" Header="_Settings..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="AboutMenuItem" Header="_About" />
      </MenuItem>
    </Menu>

    <!-- Upstream's toolstrips (FormBrowse.Designer: ToolStripMain, then the filter toolstrip and the scripts' toolstrip),
         in its order, with its images and tooltips. -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="2,1">
      <WrapPanel>
        <StackPanel x:Name="MainToolStrip" Classes="toolStrip">
          <local:ToolButton x:Name="RefreshButton" Image="ReloadRevisions" ToolTip.Tip="Refresh" />
          <Rectangle Classes="toolSeparator" />
          <local:ToolButton x:Name="ToggleLeftPanelButton" Image="LayoutSidebarLeft" ToolTip.Tip="Toggle left panel" />
          <local:ToolButton x:Name="ToggleSplitViewButton" Image="LayoutFooter" ToolTip.Tip="Toggle split view layout" />
          <Rectangle Classes="toolSeparator" />
          <local:ToolDropDownButton x:Name="SubmodulesButton" Image="SubmodulesManage" ToolTip.Tip="Submodules">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <local:ToolDropDownButton x:Name="WorktreesButton" Image="WorkTree" ToolTip.Tip="Worktrees">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <!-- Upstream's working directory drop-down: the repository's name, the recent repositories to switch to. -->
          <local:ToolDropDownButton x:Name="WorkingDirButton" Text="WorkingDir">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <local:ToolDropDownButton x:Name="BranchSelectButton" Image="Branch" Text="Branch" ToolTip.Tip="Change current branch">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <Rectangle Classes="toolSeparator" />
          <!-- The image and tooltip follow the default pull action, as upstream's RefreshDefaultPullAction sets them. -->
          <local:ToolSplitButton x:Name="PullButton" Image="Pull" ToolTip.Tip="Pull">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="PullMergeMenuItem" Header="Pull - _merge" Icon="{local:UpstreamIcon PullMerge}" />
                <MenuItem x:Name="PullRebaseMenuItem" Header="Pull - _rebase" Icon="{local:UpstreamIcon PullRebase}" />
                <MenuItem x:Name="PullFetchMenuItem" Header="_Fetch" Icon="{local:UpstreamIcon PullFetch}" ToolTip.Tip="Fetch branches and tags" />
                <MenuItem x:Name="PullOpenDialogMenuItem" Header="Open _pull dialog..." Icon="{local:UpstreamIcon Pull}" />
                <MenuItem x:Name="PullFetchAllMenuItem" Header="Fetch _all" Icon="{local:UpstreamIcon PullFetchAll}" ToolTip.Tip="Fetch branches and tags from all remote repositories" />
                <MenuItem x:Name="PullFetchPruneAllMenuItem" Header="F_etch and prune all" Icon="{local:UpstreamIcon PullFetchPruneAll}" ToolTip.Tip="Fetch branches and tags from all remote repositories also prune deleted branches" />
                <Separator />
                <MenuItem x:Name="SetDefaultPullActionMenuItem" Header="Set _default Pull button action" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <!-- Upstream shows the ahead and behind counts as the push button's text. -->
          <local:ToolButton x:Name="PushButton" Image="Push" ToolTip.Tip="Push" />
          <local:ToolButton x:Name="CommitDialogButton" Image="RepoStateClean" Text="Commit" />
          <local:ToolSplitButton x:Name="StashToolButton" Image="Stash" ToolTip.Tip="Manage stashes">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="StashChangesMenuItem" Header="_Stash" ToolTip.Tip="Stash changes" />
                <MenuItem x:Name="StashStagedMenuItem" Header="S_tash staged" ToolTip.Tip="Stash staged changes" />
                <MenuItem x:Name="StashPopToolMenuItem" Header="Stash _pop" ToolTip.Tip="Apply and drop single stash" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <Rectangle Classes="toolSeparator" />
          <local:ToolButton x:Name="OpenFolderButton" Image="BrowseFileExplorer" ToolTip.Tip="File Explorer" />
          <local:ToolButton x:Name="TerminalButton" Image="Console" ToolTip.Tip="Terminal" />
          <local:ToolButton x:Name="EditSettingsButton" Image="Settings" ToolTip.Tip="Settings" />
        </StackPanel>
        <StackPanel x:Name="FilterToolStrip" Classes="toolStrip" Spacing="4">
          <ComboBox x:Name="BranchScopeBox" SelectedIndex="0" ToolTip.Tip="Which branches the grid shows">
            <ComboBoxItem Content="All branches" />
            <ComboBoxItem Content="Current branch" />
          </ComboBox>
          <TextBox x:Name="FilterBox" Width="180" PlaceholderText="Filter loaded commits (Ctrl+E)" />
          <TextBox x:Name="SearchBox" Width="180" PlaceholderText="Search history (Enter)" />
          <local:ToolButton x:Name="RevisionFilterButton" Image="EditFilter" Text="Filter..." ToolTip.Tip="Filter by author, committer, message, date or path" />
        </StackPanel>
        <!-- Upstream's user menu bar: the enabled scripts whose event is "show in user menu bar". -->
        <StackPanel x:Name="UserScriptsPanel" Classes="toolStrip" Spacing="4" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="BranchText" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,16,0" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="0,0,16,0" />
        <Button x:Name="LoadMoreButton" DockPanel.Dock="Left" Content="Load more" IsVisible="False" Padding="6,0" MinHeight="0" Margin="0,0,16,0" />
        <!-- Upstream's stash count (Settings > General, "Show stash count on status bar in browse window"). -->
        <TextBlock x:Name="StashCountText" DockPanel.Dock="Left" Margin="0,0,16,0" IsVisible="False" />
        <TextBlock x:Name="OperationStatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <TextBlock x:Name="GitProblemText" DockPanel.Dock="Top" Foreground="Firebrick" Margin="8,4" IsVisible="False" TextWrapping="Wrap" />

    <!-- Upstream's two notification bars above the grid (InteractiveGitActionControl): a bisect in progress, and a stopped
         rebase, merge or patch or unresolved conflicts. Texts, buttons and their order come from the core's GitActionBanner. -->
    <Border x:Name="BisectBanner" DockPanel.Dock="Top" IsVisible="False" Padding="8,4" Margin="6,4,6,0" CornerRadius="3">
      <DockPanel>
        <Button x:Name="BisectMoreButton" DockPanel.Dock="Right" Content="M_ore..." />
        <TextBlock x:Name="BisectBannerText" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border x:Name="StateBanner" DockPanel.Dock="Top" IsVisible="False" Padding="8,4" Margin="6,4,6,0" CornerRadius="3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="ResolveConflictsButton" Content="Resolve..." />
          <Button x:Name="ContinueActionButton" Content="Continue" />
          <Button x:Name="AbortActionButton" Content="Abort" />
          <!-- Upstream's More... opens FormRebase or FormApplyPatch; the new shell offers their extra steps here. -->
          <Button x:Name="MoreActionButton" Content="M_ore...">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="SkipRebaseMenuItem" Header="_Skip commit" ToolTip.Tip="Leave out the commit the rebase stopped at" />
                <MenuItem x:Name="EditRebaseTodoMenuItem" Header="_Edit todo" ToolTip.Tip="Edit the steps the rebase has not done yet" />
                <MenuItem x:Name="SkipPatchMenuItem" Header="_Skip patch" ToolTip.Tip="Leave out the patch git am stopped at" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock x:Name="StateBannerText" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid x:Name="MainSplitGrid" ColumnDefinitions="280,5,*" Margin="6">
      <!-- Repository objects: upstream's left panel (RepoObjectsTree) as sections. -->
      <ScrollViewer x:Name="LeftPanel" Grid.Column="0">
        <StackPanel Spacing="4">
          <Expander Header="Branches and remotes" IsExpanded="True" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <TreeView x:Name="BranchTreeView" Height="220">
                <!-- Upstream's left panel sort menus (GitRefsSortByContextMenuItem, GitRefsSortOrderContextMenuItem). -->
                <TreeView.ContextMenu>
                  <ContextMenu x:Name="BranchTreeContextMenu">
                    <MenuItem x:Name="SortByMenuItem" Header="_Sort by" />
                    <MenuItem x:Name="SortOrderMenuItem" Header="Sort _order" />
                  </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="repo:BranchTreeNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="22" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="repo:BranchTreeNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <WrapPanel>
                <Button x:Name="CheckoutButton" Content="Checkout" Margin="0,0,4,4" />
                <Button x:Name="MergeButton" Content="Merge into current" Margin="0,0,4,4" ToolTip.Tip="Merge the selected branch into the current one (Ctrl+M)" />
                <Button x:Name="RebaseButton" Content="Rebase onto" Margin="0,0,4,4" ToolTip.Tip="Rebase the current branch onto the selected one (Ctrl+Shift+E)" />
                <Button x:Name="DeleteBranchButton" Content="Delete" Margin="0,0,4,4" />
                <Button x:Name="ForceDeleteBranchButton" Content="Force delete" Margin="0,0,4,4" />
              </WrapPanel>
              <TextBox x:Name="NewBranchBox" PlaceholderText="New branch name (Ctrl+B)" />
              <WrapPanel>
                <Button x:Name="CreateBranchButton" Content="Create" Margin="0,0,4,4" ToolTip.Tip="Create the branch at HEAD and check it out" />
                <Button x:Name="CreateBranchAtCommitButton" Content="Create at selected commit" Margin="0,0,4,4" />
                <Button x:Name="RenameBranchButton" Content="Rename selected" Margin="0,0,4,4" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Tags" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <ListBox x:Name="TagList" Height="110" />
              <TextBox x:Name="NewTagBox" PlaceholderText="New tag name (Ctrl+T)" />
              <TextBox x:Name="TagMessageBox" PlaceholderText="Message (optional: makes an annotated tag)" />
              <WrapPanel>
                <Button x:Name="CreateTagButton" Content="Create" Margin="0,0,4,4" ToolTip.Tip="Tag the selected commit, or HEAD" />
                <Button x:Name="DeleteTagButton" Content="Delete" Margin="0,0,4,4" />
                <Button x:Name="DeleteRemoteTagButton" Content="Delete on remote..." Margin="0,0,4,4" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Stashes" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <ListBox x:Name="StashList" Height="110">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="repo:StashInfo">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button x:Name="ApplyStashButton" Content="Apply" Margin="0,0,4,4" />
                <Button x:Name="PopStashButton" Content="Pop" Margin="0,0,4,4" />
                <Button x:Name="DropStashButton" Content="Drop" Margin="0,0,4,4" />
                <Button x:Name="StashDiffButton" Content="Show diff" Margin="0,0,4,4" />
              </WrapPanel>
              <TextBox x:Name="StashMessageBox" PlaceholderText="Stash message (optional)" />
              <WrapPanel>
                <Button x:Name="StashButton" Content="Stash changes" Margin="0,0,6,4" ToolTip.Tip="Ctrl+Alt+Up" />
                <CheckBox x:Name="IncludeUntrackedCheck" Content="Untracked" Margin="0,0,6,4" />
                <CheckBox x:Name="KeepIndexCheck" Content="Keep index" Margin="0,0,6,4" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <Expander x:Name="SubmodulesExpander" Header="Submodules" HorizontalAlignment="Stretch" IsVisible="False">
            <StackPanel Spacing="4">
              <ListBox x:Name="SubmoduleList" Height="100">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="repo:SubmoduleInfo">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button x:Name="OpenSubmoduleButton" Content="Open" Margin="0,0,4,4" ToolTip.Tip="Open the selected submodule in this window" />
                <Button x:Name="UpdateSubmoduleButton" Content="Update" Margin="0,0,4,4" ToolTip.Tip="Initialize and update the selected submodule" />
                <Button x:Name="UpdateSubmodulesButton" Content="Update all" Margin="0,0,4,4" />
                <Button x:Name="SyncSubmodulesButton" Content="Sync" Margin="0,0,4,4" ToolTip.Tip="Copy the URLs from .gitmodules to the repository config" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Remotes" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <ListBox x:Name="RemoteList" Height="80" />
              <TextBox x:Name="NewRemoteNameBox" PlaceholderText="Name" />
              <TextBox x:Name="NewRemoteUrlBox" PlaceholderText="URL or path" />
              <WrapPanel>
                <Button x:Name="AddRemoteButton" Content="Add" Margin="0,0,4,4" />
                <Button x:Name="RemoveRemoteButton" Content="Remove" Margin="0,0,4,4" />
                <Button x:Name="RenameRemoteButton" Content="Rename..." Margin="0,0,4,4" />
                <Button x:Name="SetRemoteUrlButton" Content="Set URL..." Margin="0,0,4,4" />
              </WrapPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2">
        <!-- Dashboard: recent repositories, shown while no repository is open (upstream's Dashboard). -->
        <DockPanel x:Name="DashboardPanel" LastChildFill="True" Margin="24,16">
          <TextBlock DockPanel.Dock="Top" Text="Recent repositories" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Top" Text="Double-click or press Enter to open. Start > Open, Clone or Create to begin with another one."
                     Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.75" />
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="RemoveRecentButton" Content="Remove from list" Margin="0,0,6,0" />
          </WrapPanel>
          <ListBox x:Name="RecentList" MaxWidth="900" HorizontalAlignment="Left">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="repo:RecentRepository">
                <StackPanel Margin="2,3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <!-- Upstream's branch name beside the repository (ShowRepoCurrentBranch). -->
                    <TextBlock Text="{Binding Branch}" IsVisible="{Binding HasBranch}" Opacity="0.8"
                               Foreground="{DynamicResource SystemAccentColor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Path}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Grid x:Name="BrowsePanel" RowDefinitions="Auto,*,5,300" IsVisible="False">
          <!-- Column headers of the revision grid; the widths match the row template below. -->
          <Grid Grid.Row="0" ColumnDefinitions="*,160,140,90,Auto" Margin="12,0,12,2">
            <TextBlock Grid.Column="0" Text="Message" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Author" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Commit" FontWeight="SemiBold" />
            <!-- Upstream's last column. As wide as BuildStatusColumnWidth: 0 while no build server shows results. -->
            <TextBlock x:Name="BuildStatusHeader" Grid.Column="4" Text="Build Status" FontWeight="SemiBold" ClipToBounds="True"
                       TextTrimming="CharacterEllipsis" Width="{DynamicResource BuildStatusColumnWidth}" />
          </Grid>
          <ListBox x:Name="CommitList" Grid.Row="1">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinHeight" Value="22" />
              </Style>
            </ListBox.Styles>
            <ListBox.ContextMenu>
              <ContextMenu x:Name="CommitContextMenu">
                <!-- Upstream's bisect items, at the top and shown only while a bisect runs. -->
                <MenuItem x:Name="MarkBadMenuItem" Header="Mark revision as bad" IsVisible="False" />
                <MenuItem x:Name="MarkGoodMenuItem" Header="Mark revision as good" IsVisible="False" />
                <MenuItem x:Name="BisectSkipMenuItem" Header="Skip revision" IsVisible="False" />
                <MenuItem x:Name="StopBisectMenuItem" Header="Stop bisect" IsVisible="False" />
                <Separator x:Name="BisectSeparator" IsVisible="False" />
                <MenuItem x:Name="CopyHashMenuItem" Header="Copy commit hash" />
                <MenuItem x:Name="CopyMessageMenuItem" Header="Copy commit message" />
                <Separator />
                <MenuItem x:Name="CreateBranchHereMenuItem" Header="Create branch here..." />
                <MenuItem x:Name="CreateTagHereMenuItem" Header="Create tag here..." />
                <MenuItem x:Name="BrowseFilesHereMenuItem" Header="Browse files at this commit..." />
                <MenuItem x:Name="CheckoutCommitMenuItem" Header="Checkout this commit (detached HEAD)" />
                <Separator />
                <MenuItem x:Name="CherryPickMenuItem" Header="Cherry-pick this commit" />
                <MenuItem x:Name="RevertMenuItem" Header="Revert this commit" />
                <MenuItem x:Name="RunScriptMenuItem" Header="Run script" />
                <MenuItem x:Name="OpenBuildReportMenuItem" Header="View _build report in a browser" />
                <MenuItem x:Name="OpenPullRequestPageMenuItem" Header="Vie_w pull request in a browser" />
                <MenuItem Header="Rebase current branch on">
                  <MenuItem x:Name="RebaseOnCommitMenuItem" Header="Selected commit" />
                  <MenuItem x:Name="RebaseInteractiveMenuItem" Header="Selected commit interactively..." />
                </MenuItem>
                <MenuItem Header="Reset current branch to here">
                  <MenuItem x:Name="ResetSoftMenuItem" Header="Soft: keep index and working tree" />
                  <MenuItem x:Name="ResetMixedMenuItem" Header="Mixed: keep working tree, reset index" />
                  <MenuItem x:Name="ResetHardMenuItem" Header="Hard: discard all changes..." />
                </MenuItem>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:CommitListItem">
                <Grid ColumnDefinitions="Auto,*,160,140,90,Auto">
                  <local:GraphCell Grid.Column="0" Graph="{Binding Graph}" VerticalAlignment="Stretch" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"
                              ToolTip.Tip="{Binding Row.Tooltip.Message}">
                    <ItemsControl Classes="refLabels" ItemsSource="{Binding Labels}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:RefLabel">
                          <Border BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,4,0"
                                  BorderBrush="{Binding Kind, Converter={x:Static local:RefLabelBrushConverter.Instance}}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{Binding Kind, Converter={x:Static local:RefLabelBrushConverter.Instance}}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Row.Subject}" VerticalAlignment="Center" />
                    <!-- Upstream's change counts of the artificial rows (ShowGitStatusForArtificialCommits). -->
                    <TextBlock Text="{Binding Badge}" Opacity="0.7" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Upstream's author avatar column (ShowAuthorAvatarColumn), here at the start of the author cell. -->
                  <DockPanel Grid.Column="2" Margin="0,0,6,0">
                    <local:AvatarView Classes="gridAvatar" DockPanel.Dock="Left" Width="16" Height="16" ImageSize="32" Margin="0,0,4,0"
                                      VerticalAlignment="Center" IsVisible="{DynamicResource ShowAuthorAvatarColumn}"
                                      Email="{Binding Row.AuthorEmail}" AuthorName="{Binding Row.Author}" />
                    <TextBlock Text="{Binding Row.Author}" ToolTip.Tip="{Binding Row.Tooltip.Author}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Row.Date}" ToolTip.Tip="{Binding Row.Tooltip.Date}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="4" Text="{Binding Row.ShortHash}" ToolTip.Tip="{Binding Row.Tooltip.Hash}" FontFamily="{DynamicResource MonospaceFontFamily}" FontWeight="{DynamicResource MonospaceFontWeight}" FontStyle="{DynamicResource MonospaceFontStyle}" FontSize="{DynamicResource MonospaceFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <!-- Upstream's build status cell: the symbol and/or the description in the status color; a click opens the
                       build report. -->
                  <StackPanel Grid.Column="5" Classes="buildStatus" Orientation="Horizontal" Spacing="4" ClipToBounds="True"
                              Background="Transparent" Width="{DynamicResource BuildStatusColumnWidth}"
                              ToolTip.Tip="{Binding Build.Tooltip}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Build.Symbol}" IsVisible="{DynamicResource BuildStatusShowIcon}"
                               Foreground="{Binding Build.Status, Converter={x:Static local:BuildStatusBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Build.Text}" IsVisible="{DynamicResource BuildStatusShowText}" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Build.Status, Converter={x:Static local:BuildStatusBrushConverter.Instance}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Upstream's quick search label: what was typed into the grid, red when nothing matches. -->
          <Border x:Name="QuickSearchPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="7,5,5,5" IsHitTestVisible="False">
            <TextBlock x:Name="QuickSearchText" FontWeight="Bold" FontSize="14" />
          </Border>

          <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

          <TabControl x:Name="DetailTabs" Grid.Row="3" Padding="0,4,0,0">
            <TabItem x:Name="CommitInfoTab" Header="Commit">
              <Grid ColumnDefinitions="*,8,Auto">
                <ScrollViewer Grid.Column="0">
                  <DockPanel>
                  <!-- Upstream's commit info avatar (ShowAuthorAvatarInCommitInfo), 80 pixels as upstream asks. -->
                  <local:AvatarView x:Name="DetailAvatar" DockPanel.Dock="Left" Width="80" Height="80" ImageSize="80"
                                    VerticalAlignment="Top" Margin="4,2,4,0" IsVisible="False" />
                  <StackPanel Spacing="3" Margin="4,0">
                    <TextBlock x:Name="DetailHash" FontFamily="{DynamicResource MonospaceFontFamily}" FontWeight="{DynamicResource MonospaceFontWeight}" FontStyle="{DynamicResource MonospaceFontStyle}" FontSize="{DynamicResource MonospaceFontSize}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailAuthor" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailAuthorDate" />
                    <TextBlock x:Name="DetailCommitDate" />
                    <TextBlock x:Name="DetailParents" FontFamily="{DynamicResource MonospaceFontFamily}" FontWeight="{DynamicResource MonospaceFontWeight}" FontStyle="{DynamicResource MonospaceFontStyle}" FontSize="{DynamicResource MonospaceFontSize}" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="DetailMessage" FontFamily="{DynamicResource CommitFontFamily}" FontWeight="{DynamicResource CommitFontWeight}" FontStyle="{DynamicResource CommitFontStyle}" FontSize="{DynamicResource CommitFontSize}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <!-- Upstream's commit info "Related links": the revision links defined in the settings. -->
                    <StackPanel x:Name="DetailLinksPanel" Spacing="2" Margin="0,8,0,0" IsVisible="False">
                      <TextBlock Text="Related links:" FontWeight="SemiBold" />
                      <WrapPanel x:Name="DetailLinks" />
                    </StackPanel>
                  </StackPanel>
                  </DockPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Spacing="4">
                  <Button x:Name="CopyHashButton" Content="Copy hash" HorizontalAlignment="Stretch" />
                  <Button x:Name="CopyMessageButton" Content="Copy message" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem x:Name="DiffTab" Header="Diff">
              <Grid ColumnDefinitions="300,5,*">
                <DockPanel Grid.Column="0" LastChildFill="True">
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <!-- Upstream's list of all diff tools (difftools.showavailable). -->
                    <Button x:Name="CommitDiffToolChoiceButton" DockPanel.Dock="Right" Content="&#x25BE;" Padding="4,2"
                            ToolTip.Tip="Open in another diff tool" IsEnabled="{Binding #CommitDiffToolButton.IsEnabled}" />
                    <Button x:Name="CommitDiffToolButton" Content="Open in diff tool" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Show the selected file's change in the diff tool configured in Settings (diff.tool)" />
                  </DockPanel>
                  <Button x:Name="ShowCommitDiffButton" DockPanel.Dock="Bottom" Content="Open in window" Margin="0,4,0,0"
                          ToolTip.Tip="Show the selected file's diff in its own window" />
                  <ListBox x:Name="CommitFilesList">
                    <!-- Upstream's file list menu: the user scripts, those shown in file lists directly. -->
                    <ListBox.ContextMenu>
                      <ContextMenu x:Name="CommitFilesContextMenu">
                        <MenuItem x:Name="CommitFilesRunScriptMenuItem" Header="Run script" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:CommitFile">
                        <!-- The path follows upstream's "Truncate long filenames" (FilePathTrimming). -->
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Margin="0,0,4,0" />
                          <TextBlock Text="{Binding Path, Converter={x:Static local:FilePathTrimming.Text}}"
                                     TextTrimming="{DynamicResource FilePathTrimming}" ToolTip.Tip="{Binding Path}" />
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <local:DiffView x:Name="CommitDiff" Grid.Column="2" />
              </Grid>
            </TabItem>
            <TabItem x:Name="FileTreeTab" Header="File tree">
              <Grid ColumnDefinitions="300,5,*">
                <TreeView x:Name="FileTreeView" Grid.Column="0">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="core:FileTreeNode" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <local:DiffView x:Name="FileContentView" Grid.Column="2" />
              </Grid>
            </TabItem>
            <!-- Upstream's build report tab (BuildReportTabPageExtension), shown when the repository's "Show build result
                 page" is on and the selected commit's build has a report. Upstream embeds a browser for some servers; the
                 new shell has none, so it shows upstream's "Open report" link, as upstream does for the other servers. -->
            <TabItem x:Name="BuildReportTab" Header="Build Report" IsVisible="False">
              <HyperlinkButton x:Name="OpenBuildReportLink" Content="Open report" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
