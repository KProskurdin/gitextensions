<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:ops="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.StashWindow"
        x:DataType="ops:StashViewModel"
        Title="Stash"
        Width="900" Height="620" MinWidth="627" MinHeight="443" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormStash: on the left the stash choice, its files, the message and the buttons; on the right the selected
       file's diff. -->
  <Grid x:Name="SplitGrid" ColumnDefinitions="280,5,*">
    <Grid RowDefinitions="Auto,*,Auto,75,Auto">
      <!-- Upstream's toolStrip1: "Show:" and the stashes, the working directory's changes first. -->
      <DockPanel Classes="toolStrip" Margin="2">
        <AccessText DockPanel.Dock="Left" Text="S_how:" VerticalAlignment="Center" Margin="2,0,5,0" />
        <ComboBox x:Name="StashesBox" ItemsSource="{Binding Stashes}" SelectedIndex="{Binding SelectedStashIndex}" IsEnabled="{Binding !IsLoadingFiles}" HorizontalAlignment="Stretch" ToolTip.Tip="Select a stash">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="ops:StashChoice">
              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
      <!-- Upstream's Stashed file list: grouped by commit index and working directory for the working directory's changes;
           above it upstream FileStatusList's toolbar (collapse, tree and group-by buttons) and filter box. -->
      <DockPanel Grid.Row="1">
        <StackPanel DockPanel.Dock="Top" Classes="toolStrip">
          <local:ToolButton x:Name="FilesCollapseGroupsButton" Image="CollapseAll"
                            ToolTip.Tip="Collapse all groups, otherwise expand the selected group" />
          <Rectangle Classes="toolSeparator" IsVisible="{Binding #FilesCollapseGroupsButton.IsVisible}" />
          <local:ToolSplitButton x:Name="FilesAsTreeButton" Image="FileTree" ToolTip.Tip="Toggle flat list / tree">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="FilesPathTreeMenuItem" Header="Group by file _path - tree" ToggleType="CheckBox"
                          Icon="{local:UpstreamIcon FolderClosed}" />
                <MenuItem x:Name="FilesPathFlatMenuItem" Header="Group by _file path - flat" ToggleType="CheckBox" />
                <MenuItem x:Name="FilesExtensionTreeMenuItem" Header="Group by file _extension - tree" ToggleType="CheckBox"
                          Icon="{local:UpstreamIcon File}" />
                <MenuItem x:Name="FilesExtensionFlatMenuItem" Header="Group by file e_xtension - flat" ToggleType="CheckBox" />
                <MenuItem x:Name="FilesStatusTreeMenuItem" Header="Group by file _status - tree" ToggleType="CheckBox"
                          Icon="{local:UpstreamIcon FileStatusModified}" />
                <MenuItem x:Name="FilesStatusFlatMenuItem" Header="Group by file s_tatus - flat" ToggleType="CheckBox" />
                <Separator />
                <MenuItem x:Name="FilesDenseTreeMenuItem" Header="_Dense tree (merge single item with its folder node)"
                          ToggleType="CheckBox" />
                <MenuItem x:Name="FilesGroupNodesInFlatListMenuItem" Header="Show _group nodes in flat list (if multiple)"
                          ToggleType="CheckBox" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <Rectangle Classes="toolSeparator" />
          <local:ToolToggleButton x:Name="FilesByPathButton" Image="FolderClosed" ToolTip.Tip="Group by file path" />
          <local:ToolToggleButton x:Name="FilesByExtensionButton" Image="File" ToolTip.Tip="Group by file type (extension)" />
          <local:ToolToggleButton x:Name="FilesByStatusButton" Image="FileStatusModified" ToolTip.Tip="Group by diff status" />
        </StackPanel>
        <local:FileFilterBox x:Name="FilesFilterBox" DockPanel.Dock="Top" Margin="0,0,0,2" />
      <Panel>
        <ListBox x:Name="FilesList" SelectionMode="Multiple">
          <!-- Upstream FileStatusList's item menu as FormStash binds it (no file tree or grid filter items). -->
          <ListBox.ContextMenu>
            <local:FileStatusListMenu x:Name="FilesMenu" />
          </ListBox.ContextMenu>
          <ListBox.Styles>
            <!-- A group's header is not a file: it cannot be selected (a folder row toggles on a click). -->
            <Style Selector="ListBoxItem">
              <Setter Property="IsHitTestVisible" Value="{ReflectionBinding IsSelectable, FallbackValue=True}" />
              <Setter Property="Padding" Value="4,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.DataTemplates>
            <!-- Upstream's folder node, or an extension or status group node. -->
            <DataTemplate x:DataType="local:FileTreeRow">
              <DockPanel Background="Transparent" Margin="{Binding Indent}">
                <TextBlock DockPanel.Dock="Left" Classes="expander" Background="Transparent" Text="{Binding Expander}" Width="12" VerticalAlignment="Center" />
                <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,4,0"
                       Source="{Binding Image, Converter={x:Static local:UpstreamImageConverter.Instance}}" />
                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
            <DataTemplate x:DataType="local:StashFileRow">
              <!-- A file's name below its folder (FileRows), a group's header as it is. -->
              <DockPanel Margin="{Binding $parent[ListBoxItem].(local:FileRows.Indent)}">
                <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,4,0" IsVisible="{Binding IsFile}"
                       Source="{Binding Image, Converter={x:Static local:UpstreamImageConverter.Instance}}" />
                <TextBlock Text="{Binding Text}" FontWeight="Bold" IsVisible="{Binding IsHeader}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                <TextBlock Text="{Binding $parent[ListBoxItem].(local:FileRows.Text)}" IsVisible="{Binding IsFile}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <!-- Upstream's Loading control, over the list while the files are read. -->
        <ProgressBar x:Name="Loading" IsVisible="{Binding IsLoadingFiles}" IsIndeterminate="True" Width="120" MinWidth="120"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
      </DockPanel>
      <AccessText Grid.Row="2" Text="_Message:" Margin="0,6,0,3" />
      <TextBox x:Name="MessageBox" Text="{Binding Message}" IsReadOnly="{Binding IsMessageReadOnly}" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" />
      <!-- Upstream's tableLayoutPanel1: the two options, then a button per row. -->
      <Grid x:Name="OptionsGrid" Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <CheckBox x:Name="KeepIndexCheck" IsChecked="{Binding KeepIndex}" Content="_Keep index" Margin="3" HorizontalAlignment="Left"
                  ToolTip.Tip="All changes already added to the index are left intact" />
        <CheckBox x:Name="IncludeUntrackedCheck" IsChecked="{Binding IncludeUntracked}" Grid.Column="1" Content="_Include untracked files" Margin="3"
                  HorizontalAlignment="Right" ToolTip.Tip="All untracked files are also stashed and then cleaned" />
        <Button x:Name="StashAllButton" Command="{Binding StashAllCommand}" Grid.Row="1" Grid.ColumnSpan="2" Content="S_tash all changes" Margin="3,3,0,3"
                MinHeight="25" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Save local changes to a new stash, then revert local changes" />
        <Button x:Name="StashSelectedButton" Command="{Binding StashSelectedCommand}" IsEnabled="{Binding CanStashSelected}" Grid.Row="2" Grid.ColumnSpan="2" Content="Stash _selected changes"
                Margin="3,3,0,3" MinHeight="25" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Stash changes for the selected files, then revert them to the original state" />
        <Button x:Name="DropButton" Command="{Binding DropCommand}" IsEnabled="{Binding CanApplyOrDrop}" Grid.Row="3" Grid.ColumnSpan="2" Content="_Drop Selected Stash" Margin="3,3,0,3"
                MinHeight="25" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Remove the selected stash from the list" />
        <Button x:Name="ApplyButton" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApplyOrDrop}" Grid.Row="4" Grid.ColumnSpan="2" Content="_Apply Selected Stash" Margin="3,3,0,3"
                MinHeight="25" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Apply the selected stash on top of the current working directory state" />
      </Grid>
    </Grid>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <local:DiffView x:Name="Diff" Grid.Column="2" />
  </Grid>
</Window>
