<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.CommitHistory"
        x:Class="GitExtensions.Xplat.App.ChooseCommitWindow"
        x:DataType="vm:ChooseCommitViewModel"
        Title="Choose commit"
        Width="1105" Height="515" MinWidth="400" MinHeight="250" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormChooseCommit: the revision grid, "Go to commit..." and the selected commit's parents below it, and
       OK. Bound to ChooseCommitViewModel (PLAN.md principle 6). -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto" Margin="4">
    <ListBox x:Name="revisionGrid" Grid.ColumnSpan="3" Classes="revisionGrid" ItemTemplate="{StaticResource RevisionRowTemplate}"
             ItemsSource="{Binding Commits.VisibleRows}" SelectedIndex="{Binding SelectedIndex}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
      <TextBlock x:Name="label1" Text="Find specific commit:" VerticalAlignment="Center" />
      <Button x:Name="buttonGotoCommit" Content="Go to commit..." MinWidth="162" HorizontalContentAlignment="Center"
              Command="{Binding GoToCommitCommand}" />
    </StackPanel>
    <StackPanel x:Name="flowLayoutPanelParents" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                Margin="12,6,0,0" IsVisible="{Binding HasParents}">
      <TextBlock x:Name="labelParents" Text="Parent(s):" VerticalAlignment="Center" />
      <HyperlinkButton x:Name="linkLabelParent" Padding="0" VerticalAlignment="Center" Content="{Binding Parent1Text}"
                       IsVisible="{Binding Parent1, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Command="{Binding SelectOrTellCommand}" CommandParameter="{Binding Parent1}" />
      <HyperlinkButton x:Name="linkLabelParent2" Padding="0" VerticalAlignment="Center" Content="{Binding Parent2Text}"
                       IsVisible="{Binding Parent2, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Command="{Binding SelectOrTellCommand}" CommandParameter="{Binding Parent2}" />
    </StackPanel>
    <Button x:Name="btnOK" Grid.Row="1" Grid.Column="2" Content="OK" MinWidth="138" HorizontalContentAlignment="Center"
            Margin="0,6,0,0" IsDefault="True" Command="{Binding ChooseCommand}" />
  </Grid>
</Window>
