<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.ProcessWindow"
        x:DataType="vm:ProcessViewModel"
        Title="{Binding Title}"
        Width="760" Height="420" WindowStartupLocation="CenterOwner">
  <!-- Mirrors upstream FormRemoteProcess: git's output while it runs, "Show password input" with upstream's PasswordInput
       for git's input, "Keep dialog open", Abort while it runs, Close when it is done. Bound to ProcessViewModel (PLAN.md
       principle 6). -->
  <DockPanel Margin="10" LastChildFill="True">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <CheckBox x:Name="ShowPassword" Content="Show _password input" Margin="0,0,6,0"
                  IsChecked="{Binding ShowPasswordInput}" IsVisible="{Binding IsRunning}" />
        <CheckBox x:Name="KeepDialogOpen" Content="_Keep dialog open" Margin="0,0,6,0" IsChecked="{Binding KeepDialogOpen}"
                  IsVisible="{Binding ShowsKeepDialogOpen}" />
        <!-- Upstream's CancelButton: Escape aborts while git runs. -->
        <Button x:Name="AbortButton" Content="Abort" Command="{Binding AbortCommand}" IsCancel="True" />
        <Button x:Name="CloseButton" Content="Close" IsDefault="True" Command="{Binding CloseCommand}" />
      </StackPanel>
      <TextBlock x:Name="StateText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding StateText}" />
    </DockPanel>
    <!-- Upstream's PasswordInput: the text for git, hidden unless the eye shows it; Enter or "Send input" sends it. -->
    <Grid x:Name="PasswordInput" DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="6" IsVisible="{Binding IsPasswordInputVisible}">
      <TextBox x:Name="Password" Text="{Binding Password}" PasswordChar="&#x25CF;"
               RevealPassword="{Binding IsPasswordRevealed}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendInputCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button x:Name="ShowPasswordButton" Grid.Column="1" Command="{Binding RevealPasswordCommand}" Padding="4,2">
        <Panel>
          <Image Source="{local:UpstreamImage EyeClosed, Adapt=True}" Width="16" Height="16"
                 IsVisible="{Binding !IsPasswordRevealed}" />
          <Image Source="{local:UpstreamImage EyeOpened, Adapt=True}" Width="16" Height="16"
                 IsVisible="{Binding IsPasswordRevealed}" />
        </Panel>
      </Button>
      <Button x:Name="SendInput" Grid.Column="2" Content="Send input" Command="{Binding SendInputCommand}" />
    </Grid>
    <ListBox x:Name="OutputList" ItemsSource="{Binding OutputLines}" FontFamily="{DynamicResource DiffFontFamily}" FontWeight="{DynamicResource DiffFontWeight}" FontStyle="{DynamicResource DiffFontStyle}" FontSize="{DynamicResource DiffFontSize}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</Window>
