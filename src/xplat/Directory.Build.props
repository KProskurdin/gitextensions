<Project>
  <!-- Shadow projects share their name with the upstream project they compile, so keep their outputs apart. -->
  <PropertyGroup>
    <OutDirName>xplat\$(MSBuildProjectName)</OutDirName>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <SolutionTargetFramework>net10.0</SolutionTargetFramework>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- Spike: upstream is warning-clean only for net10.0-windows (e.g. CA1416); tighten once the seams are known. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Upstream sources rely on the implicit usings that UseWindowsForms adds. -->
  <ItemGroup>
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)eng\SupportedOSPlatforms.cs" Link="Properties\SupportedOSPlatforms.cs" />
  </ItemGroup>
</Project>
