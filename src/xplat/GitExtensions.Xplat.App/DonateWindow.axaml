<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        x:Class="GitExtensions.Xplat.App.DonateWindow"
        Title="Donate"
        Width="508" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormDonate: its text, and the donate badge, which opens the donation page. -->
  <Grid x:Name="tableLayoutPanel" RowDefinitions="Auto,80" Margin="16">
    <TextBlock x:Name="lblText" Margin="10" TextWrapping="Wrap" />
    <Button x:Name="pbxDonate" Grid.Row="1" Classes="tool" Padding="0" MinWidth="90" MinHeight="35" Margin="12,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
      <Image Source="{local:UpstreamImage DonateBadge}" Stretch="Uniform" />
    </Button>
  </Grid>
</Window>
