<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.BuildServer"
        xmlns:bs="using:GitUIPluginInterfaces.BuildServerIntegration"
        x:Class="GitExtensions.Xplat.App.BuildServerCredentialsWindow"
        x:DataType="vm:BuildServerCredentialsViewModel"
        Title="Enter credentials"
        Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- Upstream FormBuildServerCredentials: guest access, a user name and password, or a bearer token. Texts are named as
       the form's fields, for its translations. Bound to BuildServerCredentialsViewModel (PLAN.md principle 6). -->
  <StackPanel Margin="12" Spacing="8">
    <TextBlock x:Name="labelHeader" TextWrapping="Wrap" Text="{Binding Header}" />
    <RadioButton x:Name="radioButtonGuestAccess" GroupName="Access" Content="Guest access"
                 IsChecked="{Binding CredentialsType, Converter={x:Static local:EnumEqualsConverter.Instance},
                             ConverterParameter={x:Static bs:BuildServerCredentialsType.Guest}}" />
    <RadioButton x:Name="radioButtonAuthenticatedUser" GroupName="Access" Content="Authenticated user"
                 IsChecked="{Binding CredentialsType, Converter={x:Static local:EnumEqualsConverter.Instance},
                             ConverterParameter={x:Static bs:BuildServerCredentialsType.UsernameAndPassword}}" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8" Margin="24,0,0,0">
      <TextBlock x:Name="label2" Text="Username:" VerticalAlignment="Center" />
      <TextBox x:Name="textBoxUserName" Grid.Column="1" Text="{Binding UserName}" IsEnabled="{Binding UsesUserName}" />
      <TextBlock x:Name="label3" Grid.Row="1" Text="Password:" VerticalAlignment="Center" />
      <TextBox x:Name="textBoxPassword" Grid.Row="1" Grid.Column="1" PasswordChar="*" Text="{Binding Password}"
               IsEnabled="{Binding UsesUserName}" />
    </Grid>
    <RadioButton x:Name="radioButtonBearerToken" GroupName="Access" Content="Bearer token"
                 IsChecked="{Binding CredentialsType, Converter={x:Static local:EnumEqualsConverter.Instance},
                             ConverterParameter={x:Static bs:BuildServerCredentialsType.BearerToken}}" />
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="24,0,0,0">
      <TextBlock x:Name="label4" Text="Bearer token:" VerticalAlignment="Center" />
      <TextBox x:Name="textBoxBearerToken" Grid.Column="1" PasswordChar="*" Text="{Binding BearerToken}"
               IsEnabled="{Binding UsesBearerToken}" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="buttonOK" Content="OK" IsDefault="True" MinWidth="80" Command="{Binding OkCommand}" />
      <Button x:Name="buttonCancel" Content="Cancel" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
