<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The shared xplat props add the WinForms namespace to every project; the core must not depend on it. System.Drawing
         stays: the linked upstream theming files use its Color and KnownColor, which are cross-platform. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's CSS theme loading, compiled as is (it has no WinForms code), so the new shell reads the same theme files,
         user themes and variations as the WinForms app. ThemeModule, which applies a theme to WinForms, is not linked. -->
    <Compile Include="..\..\app\GitUI\Theming\ThemeLoader.cs" Link="Upstream\Theming\ThemeLoader.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemeCssUrlResolver.cs" Link="Upstream\Theming\ThemeCssUrlResolver.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemeCssUrlResolverException.cs" Link="Upstream\Theming\ThemeCssUrlResolverException.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemeException.cs" Link="Upstream\Theming\ThemeException.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemeFileReader.cs" Link="Upstream\Theming\ThemeFileReader.cs" />
    <!-- For IThemePathProvider. Its ThemePathProvider is not used: in Debug builds it asserts that the app is GitExtensions.exe,
         which fails on Linux and macOS; AppThemePaths takes its place. -->
    <Compile Include="..\..\app\GitUI\Theming\ThemePathProvider.cs" Link="Upstream\Theming\ThemePathProvider.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemePersistence.cs" Link="Upstream\Theming\ThemePersistence.cs" />
    <Compile Include="..\..\app\GitUI\Theming\ThemeRepository.cs" Link="Upstream\Theming\ThemeRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's script events, so the stored OnEvent values are read as upstream writes them. The rest of upstream's
         scripts engine uses WinForms and IGitUICommands; Scripts/ reimplements it (PORTING-MAP.md). -->
    <Compile Include="..\..\app\GitUI\ScriptsEngine\ScriptEvent.cs" Link="Upstream\ScriptsEngine\ScriptEvent.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's plugin settings keys ("<plugin id>.<name>", and the older "<description><name>"), so plugins read the
         values the WinForms app stored. The rest of upstream's PluginRegistry uses WinForms; Plugins/ reimplements it. -->
    <Compile Include="..\..\app\GitUI\Plugin\GitPluginSettingsContainer.cs" Link="Upstream\Plugin\GitPluginSettingsContainer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's revision graph model (lanes, segments, straightening), unchanged. Its renderer draws with WinForms
         (System.Drawing.Graphics); CommitHistory/GraphPainter.cs ports it, and Settings/UpstreamGraphLaneColor.cs stands in
         for the lane colors, which upstream reads from the WinForms theme. -->
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\RevisionGraph.cs" Link="Upstream\Graph\RevisionGraph.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\RevisionGraphRow.cs" Link="Upstream\Graph\RevisionGraphRow.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\RevisionGraphRevision.cs" Link="Upstream\Graph\RevisionGraphRevision.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\RevisionGraphSegment.cs" Link="Upstream\Graph\RevisionGraphSegment.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\RevisionGraphConfig.cs" Link="Upstream\Graph\RevisionGraphConfig.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\Lane.cs" Link="Upstream\Graph\Lane.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\LaneInfo.cs" Link="Upstream\Graph\LaneInfo.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\LaneSharing.cs" Link="Upstream\Graph\LaneSharing.cs" />
    <Compile Include="..\..\app\GitUI\UserControls\RevisionGrid\Graph\LaneNodeLocator.cs" Link="Upstream\Graph\LaneNodeLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's revision link templates (GitHub, Azure DevOps), unchanged; Settings/UpstreamImages.cs stands in for the
         WinForms images they name as icons. -->
    <Compile Include="..\..\app\GitUI\CommandsDialogs\SettingsDialog\RevisionLinks\*.cs" Link="Upstream\RevisionLinks\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExCSS" />
    <!-- Upstream's encrypted build server credentials on Windows (BuildServer/BuildServerCredentialStore.cs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitCommands\GitCommands.csproj" />
    <!-- Upstream's translated texts (relative dates) and TranslationString, which upstream plugins use too, so the app ships it. -->
    <ProjectReference Include="..\ResourceManager\ResourceManager.csproj" />
  </ItemGroup>

</Project>
