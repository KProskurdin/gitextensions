<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.AvailableEncodingsWindow"
        Title="Available encodings" Width="592" Height="372" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormAvailableEncodings: the encodings offered on the left, the others on the right, a button each way. -->
  <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*,Auto" Margin="8">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected:" Margin="0,0,0,4" />
    <TextBlock Grid.Row="0" Grid.Column="2" Text="Available:" Margin="0,0,0,4" />
    <ListBox x:Name="ListIncludedEncodings" Grid.Row="1" Grid.Column="0" />
    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Spacing="6">
      <Button x:Name="ToRight" Content="&gt;" IsEnabled="False" />
      <Button x:Name="ToLeft" Content="&lt;" IsEnabled="False" />
    </StackPanel>
    <ListBox x:Name="ListAvailableEncodings" Grid.Row="1" Grid.Column="2" />
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
      <Button x:Name="ButtonOk" Content="OK" MinWidth="75" />
      <Button x:Name="ButtonCancel" Content="Cancel" MinWidth="75" />
    </StackPanel>
  </Grid>
</Window>
