<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.CompareToBranchWindow"
        Title="Compare to branch"
        Width="434" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormCompareToBranch: its BranchSelector (local or remote branches, the branch and the count of commits
       against the compared commit), and Compare at the bottom right. -->
  <StackPanel Margin="8" Spacing="6">
    <Grid x:Name="branchSelector" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
      <RadioButton x:Name="LocalBranch" GroupName="Kind" Content="Local branch" Margin="3" />
      <RadioButton x:Name="Remotebranch" Grid.Column="1" GroupName="Kind" Content="Remote branch" Margin="3" />
      <Label x:Name="label1" Grid.Row="1" Content="Select branch" Target="Branches" VerticalAlignment="Center"
             Margin="3,3,12,3" Padding="0" />
      <ComboBox x:Name="Branches" Grid.Row="1" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" Margin="3" />
      <TextBlock x:Name="lbChanges" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="3" MinWidth="40" />
    </Grid>
    <Button x:Name="btnCompare" Content="Compare" HorizontalAlignment="Right" MinWidth="60" IsDefault="True" />
  </StackPanel>
</Window>
