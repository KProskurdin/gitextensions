<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="using:System.Text"
        xmlns:vm="using:GitExtensions.Xplat.Core.Settings"
        x:Class="GitExtensions.Xplat.App.AvailableEncodingsWindow"
        x:DataType="vm:AvailableEncodingsViewModel"
        Title="Available encodings" Width="592" Height="372" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormAvailableEncodings: the encodings offered on the left, the others on the right, a button each way.
       Bound to AvailableEncodingsViewModel (PLAN.md principle 6). -->
  <Window.DataTemplates>
    <DataTemplate x:DataType="text:Encoding">
      <TextBlock Text="{Binding EncodingName}" />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*,Auto" Margin="8">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected:" Margin="0,0,0,4" />
    <TextBlock Grid.Row="0" Grid.Column="2" Text="Available:" Margin="0,0,0,4" />
    <ListBox x:Name="ListIncludedEncodings" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Included}"
             SelectedItem="{Binding SelectedIncluded}" />
    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Spacing="6">
      <Button x:Name="ToRight" Content="&gt;" Command="{Binding ToRightCommand}" />
      <Button x:Name="ToLeft" Content="&lt;" Command="{Binding ToLeftCommand}" />
    </StackPanel>
    <ListBox x:Name="ListAvailableEncodings" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Available}"
             SelectedItem="{Binding SelectedAvailable}" />
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
      <Button x:Name="ButtonOk" Content="OK" MinWidth="75" IsDefault="True" Command="{Binding OkCommand}" />
      <Button x:Name="ButtonCancel" Content="Cancel" MinWidth="75" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
