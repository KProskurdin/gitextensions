<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.ChooseWindow"
        Title="Select"
        Width="360" Height="300" WindowStartupLocation="CenterOwner">
  <!-- Mirrors upstream's FormQuickGitRefSelector and FormQuickStringSelector: pick one of several refs or remotes. -->
  <DockPanel Margin="12" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
      <Button x:Name="OkButton" Content="Select" IsDefault="True" />
    </StackPanel>
    <ListBox x:Name="OptionList" />
  </DockPanel>
</Window>
