<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.AboutWindow"
        Title="About Git Extensions"
        Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image x:Name="LogoImage" Width="64" Height="64" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Git Extensions" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Cross-platform shell (preview)" Opacity="0.75" />
      </StackPanel>
    </StackPanel>
    <SelectableTextBlock x:Name="VersionText" TextWrapping="Wrap" />
    <TextBlock TextWrapping="Wrap"
               Text="A fork of Git Extensions that runs the same git engine with an Avalonia user interface on Windows, Linux and macOS. Licensed under the GNU GPL, like Git Extensions." />
    <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
