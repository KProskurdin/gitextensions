<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Xplat.Core.Presentation"
        x:Class="GitExtensions.Xplat.App.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Caption}"
        Width="480" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <!-- A question before an action that cannot be undone, bound to ConfirmViewModel (PLAN.md principle 6). -->
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Text="{Binding Message}" />
    <CheckBox x:Name="DontShowAgainCheck" Content="{Binding DontShowAgainText}" IsVisible="{Binding OfferDontShowAgain}"
              IsChecked="{Binding DontShowAgain}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
      <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
