<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..\'))" />

  <!-- After the project body, so the upstream files that SharedSources.targets added can be removed. -->
  <ItemGroup>
    <!-- Image resources are System.Drawing bitmaps, which throw off Windows; Properties\Resources.cs stands in for them.
         The icon is embedded as a plain PNG instead, under one name for every plugin, so the app can show it. -->
    <Compile Remove="$(UpstreamDir)Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="$(UpstreamDir)Properties\Resources.resx" />
    <EmbeddedResource Include="$(UpstreamDir)Resources\*.png" LogicalName="GitExtensions.Xplat.PluginIcon.png" />
  </ItemGroup>

  <!--
    A plugin with a WinForms form sets XplatPluginUi: the upstream plugin class is compiled unchanged, and the project removes
    the upstream form and adds a stand-in of the same name (a GitExtensions.Xplat.Ui.PluginDialog) whose Avalonia window
    reimplements it (docs/xplat/PORTING-MAP.md). Avalonia and the UI helpers ship with the app, so they are not copied.
  -->
  <PropertyGroup Condition="'$(XplatPluginUi)' == 'true'">
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(XplatPluginUi)' == 'true'">
    <PackageReference Include="Avalonia" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\GitExtensions.Xplat.Ui\GitExtensions.Xplat.Ui.csproj" Private="false" />
  </ItemGroup>
</Project>
