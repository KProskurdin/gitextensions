<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        xmlns:repo="using:GitExtensions.Xplat.Core.Repository"
        x:Class="GitExtensions.Xplat.App.MainWindow"
        Title="Git Extensions"
        Width="1360" Height="820">
  <!-- Layout follows upstream FormBrowse: menu and toolbar on top, repository objects on the left, the revision grid,
       and the selected commit's tabs below it. -->
  <DockPanel LastChildFill="True">
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_Start">
        <MenuItem x:Name="OpenMenuItem" Header="_Open..." />
        <MenuItem x:Name="CloneMenuItem" Header="_Clone repository..." />
        <MenuItem x:Name="InitMenuItem" Header="Create _new repository..." />
        <MenuItem x:Name="RecentMenu" Header="_Recent repositories" />
        <Separator />
        <MenuItem x:Name="CloseRepositoryMenuItem" Header="Close repository" />
        <MenuItem x:Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Repository">
        <MenuItem x:Name="RefreshMenuItem" Header="_Refresh" />
        <MenuItem x:Name="FileExplorerMenuItem" Header="File _explorer" />
        <MenuItem x:Name="TerminalMenuItem" Header="Open _terminal" />
        <Separator />
        <MenuItem x:Name="FilesMenuItem" Header="_Browse files..." />
        <MenuItem x:Name="ReflogMenuItem" Header="Show _reflog..." />
        <MenuItem x:Name="GitIgnoreMenuItem" Header="Edit ._gitignore..." />
        <MenuItem x:Name="WorktreesMenuItem" Header="_Worktrees..." />
      </MenuItem>
      <!-- Upstream's View menu (RevisionGridMenuCommands.GetViewMenuCommands) in its order and groups, with the items the new
           shell has. -->
      <MenuItem Header="_View">
        <MenuItem Classes="groupHeader" Header="Branches" IsEnabled="False" />
        <MenuItem x:Name="ShowAllBranchesMenuItem" Header="Show _all branches" ToggleType="Radio" Icon="{local:UpstreamIcon BranchLocal}" />
        <MenuItem x:Name="ShowCurrentBranchOnlyMenuItem" Header="Show _current branch only" ToggleType="Radio" Icon="{local:UpstreamIcon BranchFilter}" />
        <MenuItem x:Name="ShowFilteredBranchesMenuItem" Header="Show _filtered branches" ToggleType="Radio" Icon="{local:UpstreamIcon BranchFilter}" />
        <MenuItem x:Name="ShowReflogReferencesMenuItem" Header="Show _reflog references" ToggleType="CheckBox" Icon="{local:UpstreamIcon Book}" />
        <Separator />
        <MenuItem x:Name="AdvancedFilterViewMenuItem" Header="Advanced filter..." Icon="{local:UpstreamIcon EditFilter}" />
        <Separator />
        <!-- Upstream's graph styles: gray lanes for commits that are not relatives of the checked-out one, and the selected
             commit's ancestry in color until the next refresh (also Alt+click). -->
        <MenuItem x:Name="DrawNonRelativesGrayMenuItem" Header="Draw non relatives gra_y" ToggleType="CheckBox" />
        <MenuItem x:Name="HighlightSelectedBranchMenuItem" Header="Highlight selected branch (until refresh)" />
        <Separator />
        <MenuItem Classes="groupHeader" Header="Commits" IsEnabled="False" />
        <MenuItem x:Name="ShowArtificialCommitsMenuItem" Header="Show artificial commits" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Classes="groupHeader" Header="Grid labels" IsEnabled="False" />
        <MenuItem x:Name="ShowRemoteBranchesMenuItem" Header="Show remote _branches" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowTagsMenuItem" Header="Show _tags" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Classes="groupHeader" Header="Grid info" IsEnabled="False" />
        <MenuItem x:Name="ShowBuildStatusIconMenuItem" Header="Show build status _icon" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowBuildStatusTextMenuItem" Header="Show build status te_xt" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowCommitBodyMenuItem" Header="Show commit message body" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowAuthorDateMenuItem" Header="Sho_w author date" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowRelativeDateMenuItem" Header="Show relati_ve date" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Classes="groupHeader" Header="Columns" IsEnabled="False" />
        <MenuItem x:Name="ShowGraphColumnMenuItem" Header="Show revision _graph column" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowAvatarColumnMenuItem" Header="Show aut_hor avatar column" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowAuthorNameColumnMenuItem" Header="Show a_uthor name column" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowDateColumnMenuItem" Header="Show _date column" ToggleType="CheckBox" />
        <MenuItem x:Name="ShowObjectIdColumnMenuItem" Header="Show SHA_-1 column" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Classes="groupHeader" Header="Sorting" IsEnabled="False" />
        <MenuItem x:Name="AuthorDateSortMenuItem" Header="_Sort commits by author date" ToggleType="CheckBox" />
        <MenuItem x:Name="TopoOrderMenuItem" Header="Arrange c_ommits by topo order (ancestor order)" ToggleType="CheckBox" />
      </MenuItem>
      <MenuItem Header="_Commands">
        <MenuItem x:Name="CommitMenuItem" Header="_Commit..." />
        <MenuItem x:Name="PullDialogMenuItem" Header="_Pull/Fetch..." />
        <MenuItem x:Name="PushDialogMenuItem" Header="P_ush..." />
        <MenuItem x:Name="PullMenuItem" Header="Quick pull" />
        <MenuItem x:Name="PushMenuItem" Header="Quick push" />
        <MenuItem x:Name="FetchMenuItem" Header="Quick _fetch" />
        <MenuItem x:Name="PushTagsMenuItem" Header="Push _tags" />
        <Separator />
        <MenuItem x:Name="StashMenuItem" Header="_Stash changes" />
        <MenuItem x:Name="StashPopMenuItem" Header="Stash p_op" />
        <Separator />
        <MenuItem x:Name="CreateBranchMenuItem" Header="Create _branch..." />
        <MenuItem x:Name="MergeMenuItem" Header="_Merge selected branch" />
        <MenuItem x:Name="RebaseMenuItem" Header="Re_base onto selected branch" />
        <MenuItem x:Name="CreateTagMenuItem" Header="Create _tag..." />
        <MenuItem x:Name="BisectMenuItem" Header="B_isect..." />
        <Separator />
        <MenuItem x:Name="ResolveConflictsMenuItem" Header="Solve _conflicts..." />
      </MenuItem>
      <!-- Upstream's "(Repository hosts)" menu: named after the repository host plugin, shown when one is loaded. -->
      <MenuItem x:Name="RepositoryHostsMenu" Header="(Repository hosts)" IsVisible="False">
        <MenuItem x:Name="ForkCloneRepositoryMenuItem" Header="_Fork/Clone repository..." />
        <MenuItem x:Name="ViewPullRequestsMenuItem" Header="View _pull requests..." />
        <MenuItem x:Name="CreatePullRequestsMenuItem" Header="_Create pull requests..." />
        <MenuItem x:Name="AddUpstreamRemoteMenuItem" Header="_Add upstream remote" />
      </MenuItem>
      <MenuItem x:Name="PluginsMenu" Header="_Plugins">
        <MenuItem x:Name="PluginsLoadingMenuItem" Header="Loading..." IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="PluginSettingsMenuItem" Header="Plugins _settings..." />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="CommandLogMenuItem" Header="Git _command log..." />
        <MenuItem x:Name="SettingsMenuItem" Header="_Settings..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="AboutMenuItem" Header="_About" />
      </MenuItem>
    </Menu>

    <!-- Upstream's toolstrips (FormBrowse.Designer: ToolStripMain, then the filter toolstrip and the scripts' toolstrip),
         in its order, with its images and tooltips. -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="2,1">
      <WrapPanel>
        <StackPanel x:Name="MainToolStrip" Classes="toolStrip">
          <local:ToolButton x:Name="RefreshButton" Image="ReloadRevisions" ToolTip.Tip="Refresh" />
          <Rectangle Classes="toolSeparator" />
          <local:ToolToggleButton x:Name="ToggleLeftPanelButton" Image="LayoutSidebarLeft" ToolTip.Tip="Toggle left panel" IsChecked="True" />
          <local:ToolToggleButton x:Name="ToggleSplitViewButton" Image="LayoutFooter" ToolTip.Tip="Toggle split view layout" />
          <!-- The image and tooltip follow the chosen position, as upstream's RefreshLayoutToggleButtonStates sets them. -->
          <local:ToolSplitButton x:Name="CommitInfoPositionButton" Image="LayoutFooterTab" ToolTip.Tip="Commit info position">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="CommitInfoBelowMenuItem" Header="Commit info _below graph" Icon="{local:UpstreamIcon LayoutFooterTab}" />
                <MenuItem x:Name="CommitInfoLeftwardMenuItem" Header="Commit info _left of graph" Icon="{local:UpstreamIcon LayoutSidebarTopLeft}" />
                <MenuItem x:Name="CommitInfoRightwardMenuItem" Header="Commit info _right of graph" Icon="{local:UpstreamIcon LayoutSidebarTopRight}" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <Rectangle Classes="toolSeparator" />
          <local:ToolDropDownButton x:Name="SubmodulesButton" Image="SubmodulesManage" ToolTip.Tip="Submodules">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <local:ToolDropDownButton x:Name="WorktreesButton" Image="WorkTree" ToolTip.Tip="Worktrees">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <!-- Upstream's working directory drop-down: the repository's name, the recent repositories to switch to. -->
          <local:ToolDropDownButton x:Name="WorkingDirButton" Text="WorkingDir">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <local:ToolDropDownButton x:Name="BranchSelectButton" Image="Branch" Text="Branch" ToolTip.Tip="Change current branch">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout />
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <Rectangle Classes="toolSeparator" />
          <!-- The image and tooltip follow the default pull action, as upstream's RefreshDefaultPullAction sets them. -->
          <local:ToolSplitButton x:Name="PullButton" Image="Pull" ToolTip.Tip="Pull">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="PullMergeMenuItem" Header="Pull - _merge" Icon="{local:UpstreamIcon PullMerge}" />
                <MenuItem x:Name="PullRebaseMenuItem" Header="Pull - _rebase" Icon="{local:UpstreamIcon PullRebase}" />
                <MenuItem x:Name="PullFetchMenuItem" Header="_Fetch" Icon="{local:UpstreamIcon PullFetch}" ToolTip.Tip="Fetch branches and tags" />
                <MenuItem x:Name="PullOpenDialogMenuItem" Header="Open _pull dialog..." Icon="{local:UpstreamIcon Pull}" />
                <MenuItem x:Name="PullFetchAllMenuItem" Header="Fetch _all" Icon="{local:UpstreamIcon PullFetchAll}" ToolTip.Tip="Fetch branches and tags from all remote repositories" />
                <MenuItem x:Name="PullFetchPruneAllMenuItem" Header="F_etch and prune all" Icon="{local:UpstreamIcon PullFetchPruneAll}" ToolTip.Tip="Fetch branches and tags from all remote repositories also prune deleted branches" />
                <Separator />
                <MenuItem x:Name="SetDefaultPullActionMenuItem" Header="Set _default Pull button action" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <!-- Upstream shows the ahead and behind counts as the push button's text. -->
          <local:ToolButton x:Name="PushButton" Image="Push" ToolTip.Tip="Push" />
          <local:ToolButton x:Name="CommitDialogButton" Image="RepoStateClean" Text="Commit" />
          <local:ToolSplitButton x:Name="StashToolButton" Image="Stash" ToolTip.Tip="Manage stashes">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="StashChangesMenuItem" Header="_Stash" ToolTip.Tip="Stash changes" />
                <MenuItem x:Name="StashStagedMenuItem" Header="S_tash staged" ToolTip.Tip="Stash staged changes" />
                <MenuItem x:Name="StashPopToolMenuItem" Header="Stash _pop" ToolTip.Tip="Apply and drop single stash" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <Rectangle Classes="toolSeparator" />
          <local:ToolButton x:Name="OpenFolderButton" Image="BrowseFileExplorer" ToolTip.Tip="File Explorer" />
          <!-- Upstream's userShell: the default terminal, the others in the drop-down (FillUserShells). -->
          <local:ToolSplitButton x:Name="TerminalButton" Image="GitForWindows" ToolTip.Tip="Git bash">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout />
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <local:ToolButton x:Name="EditSettingsButton" Image="Settings" ToolTip.Tip="Settings" />
        </StackPanel>
        <!-- Upstream's FilterToolBar (FilterToolBar.Designer), in its order. -->
        <StackPanel x:Name="FilterToolStrip" Classes="toolStrip">
          <!-- The image and tooltip say whether a filter is on, as upstream's revisionGridFilter_FilterChanged sets them. -->
          <local:ToolSplitButton x:Name="AdvancedFilterButton" Image="FunnelPencil" ToolTip.Tip="Advanced filter">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="ResetPathFilterMenuItem" Header="Reset _path filter" />
                <MenuItem x:Name="ResetRevisionFiltersMenuItem" Header="_Reset revision filters" />
                <Separator />
                <MenuItem x:Name="AdvancedFilterMenuItem" Header="_Advanced filter" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <local:ToolToggleButton x:Name="ShowReflogButton" Image="Book" ToolTip.Tip="Show all reflog references" />
          <!-- The image, text and tooltip are the chosen item's, as upstream's SelectShowBranchesFilterOption sets them. -->
          <local:ToolSplitButton x:Name="ShowBranchesButton" Image="BranchLocal" Text="All branches" ToolTip.Tip="Show all branches">
            <local:ToolSplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="ShowBranchesAllMenuItem" Header="_All branches" Icon="{local:UpstreamIcon BranchLocal}" ToolTip.Tip="Show all branches" />
                <MenuItem x:Name="ShowBranchesCurrentMenuItem" Header="_Current branch only" Icon="{local:UpstreamIcon BranchFilter}" ToolTip.Tip="Show current branch only" />
                <MenuItem x:Name="ShowBranchesFilteredMenuItem" Header="_Filtered branches" Icon="{local:UpstreamIcon BranchFilter}" ToolTip.Tip="Show filtered branches" />
              </MenuFlyout>
            </local:ToolSplitButton.Flyout>
          </local:ToolSplitButton>
          <Label x:Name="BranchFilterLabel" Content="_Branches:" Target="{Binding #BranchFilterBox}" ToolTip.Tip="Branch filter"
                 VerticalAlignment="Center" Padding="4,0,2,0" />
          <AutoCompleteBox x:Name="BranchFilterBox" Width="100" MinimumPrefixLength="0" FilterMode="ContainsOrdinal"
                           VerticalAlignment="Center" />
          <local:ToolDropDownButton x:Name="BranchTypeButton" Image="EditFilter" ToolTip.Tip="Branch type">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="BranchLocalMenuItem" Header="_Local" ToggleType="CheckBox" IsChecked="True" />
                <MenuItem x:Name="BranchRemoteMenuItem" Header="_Remote" ToggleType="CheckBox" />
                <MenuItem x:Name="BranchTagMenuItem" Header="_Tag" ToggleType="CheckBox" />
              </MenuFlyout>
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <Rectangle Classes="toolSeparator" />
          <Label x:Name="RevisionFilterLabel" Content="_Filter:" Target="{Binding #RevisionFilterBox}" ToolTip.Tip="Text filter"
                 VerticalAlignment="Center" Padding="4,0,2,0" />
          <ComboBox x:Name="RevisionFilterBox" IsEditable="True" Width="100" VerticalAlignment="Center" />
          <local:ToolDropDownButton x:Name="RevisionFilterTypeButton" Image="EditFilter" ToolTip.Tip="Filter type">
            <local:ToolDropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="CommitFilterMenuItem" Header="Commit _message" ToggleType="CheckBox" IsChecked="True" />
                <MenuItem x:Name="CommitterFilterMenuItem" Header="_Committer" ToggleType="CheckBox" />
                <MenuItem x:Name="AuthorFilterMenuItem" Header="_Author" ToggleType="CheckBox" />
                <MenuItem x:Name="DiffContainsFilterMenuItem" Header="_Diff contains (SLOW)" ToggleType="CheckBox" />
              </MenuFlyout>
            </local:ToolDropDownButton.Flyout>
          </local:ToolDropDownButton>
          <local:ToolToggleButton x:Name="ShowFirstParentButton" Image="ShowOnlyFirstParent" ToolTip.Tip="Show only first parent" />
        </StackPanel>
        <!-- Upstream's user menu bar: the enabled scripts whose event is "show in user menu bar". -->
        <StackPanel x:Name="UserScriptsPanel" Classes="toolStrip" Spacing="4" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="BranchText" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,16,0" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="0,0,16,0" />
        <Button x:Name="LoadMoreButton" DockPanel.Dock="Left" Content="Load more" IsVisible="False" Padding="6,0" MinHeight="0" Margin="0,0,16,0" />
        <!-- Upstream's stash count (Settings > General, "Show stash count on status bar in browse window"). -->
        <TextBlock x:Name="StashCountText" DockPanel.Dock="Left" Margin="0,0,16,0" IsVisible="False" />
        <TextBlock x:Name="OperationStatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <TextBlock x:Name="GitProblemText" DockPanel.Dock="Top" Foreground="Firebrick" Margin="8,4" IsVisible="False" TextWrapping="Wrap" />

    <!-- Upstream's two notification bars above the grid (InteractiveGitActionControl): a bisect in progress, and a stopped
         rebase, merge or patch or unresolved conflicts. Texts, buttons and their order come from the core's GitActionBanner. -->
    <Border x:Name="BisectBanner" DockPanel.Dock="Top" IsVisible="False" Padding="8,4" Margin="6,4,6,0" CornerRadius="3">
      <DockPanel>
        <Button x:Name="BisectMoreButton" DockPanel.Dock="Right" Content="M_ore..." />
        <TextBlock x:Name="BisectBannerText" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border x:Name="StateBanner" DockPanel.Dock="Top" IsVisible="False" Padding="8,4" Margin="6,4,6,0" CornerRadius="3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="ResolveConflictsButton" Content="Resolve..." />
          <Button x:Name="ContinueActionButton" Content="Continue" />
          <Button x:Name="AbortActionButton" Content="Abort" />
          <!-- Upstream's More... opens FormRebase or FormApplyPatch; the new shell offers their extra steps here. -->
          <Button x:Name="MoreActionButton" Content="M_ore...">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="SkipRebaseMenuItem" Header="_Skip commit" ToolTip.Tip="Leave out the commit the rebase stopped at" />
                <MenuItem x:Name="EditRebaseTodoMenuItem" Header="_Edit todo" ToolTip.Tip="Edit the steps the rebase has not done yet" />
                <MenuItem x:Name="SkipPatchMenuItem" Header="_Skip patch" ToolTip.Tip="Leave out the patch git am stopped at" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock x:Name="StateBannerText" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid x:Name="MainSplitGrid" ColumnDefinitions="280,5,*" Margin="6">
      <!-- Upstream's left panel (RepoObjectsTree.Designer): the toolstrip that collapses the tree and shows or hides each of
           its trees, the search box, and one tree. Its context menu is filled for the node it opens on (upstream's
           contextMenu_Opening), from RepoObjectsTree.ContextActions. -->
      <DockPanel x:Name="LeftPanel" Grid.Column="0">
        <StackPanel x:Name="LeftPanelToolStrip" DockPanel.Dock="Top" Classes="toolStrip">
          <local:ToolButton x:Name="CollapseAllButton" Image="CollapseAll" ToolTip.Tip="Collapse all subnodes" />
          <local:ToolToggleButton x:Name="ShowBranchesTreeButton" Image="BranchLocalRoot" ToolTip.Tip="Branches" />
          <local:ToolToggleButton x:Name="ShowRemotesTreeButton" Image="BranchRemoteRoot" ToolTip.Tip="Remotes" />
          <local:ToolToggleButton x:Name="ShowWorktreesTreeButton" Image="WorkTree" ToolTip.Tip="Worktrees" />
          <local:ToolToggleButton x:Name="ShowTagsTreeButton" Image="TagHorizontal" ToolTip.Tip="Tags" />
          <local:ToolToggleButton x:Name="ShowSubmodulesTreeButton" Image="FolderSubmodule" ToolTip.Tip="Submodules" />
          <local:ToolToggleButton x:Name="ShowStashesTreeButton" Image="Stash" ToolTip.Tip="Stashes" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,2">
          <local:ToolButton x:Name="LeftPanelSearchButton" DockPanel.Dock="Right" Image="Preview" ToolTip.Tip="Search" />
          <AutoCompleteBox x:Name="LeftPanelSearchBox" FilterMode="ContainsOrdinal" MinimumPrefixLength="1" />
        </DockPanel>
        <TreeView x:Name="BranchTreeView">
          <TreeView.ContextMenu>
            <!-- Upstream's menuMain in its order; MainWindow.LeftPanel shows the items that apply to the node. -->
            <ContextMenu x:Name="BranchTreeContextMenu">
              <MenuItem x:Name="TreeFilterMenuItem" Header="_Filter for selected" Icon="{local:UpstreamIcon ShowThisBranchOnly}"
                        ToolTip.Tip="Filter the revision grid to show the selected ref only." />
              <Separator />
              <MenuItem x:Name="TreeCheckoutMenuItem" Icon="{local:UpstreamIcon BranchCheckout}" />
              <MenuItem x:Name="TreeMergeMenuItem" Header="_Merge into current branch..." Icon="{local:UpstreamIcon Merge}" />
              <MenuItem x:Name="TreeRebaseMenuItem" Icon="{local:UpstreamIcon Rebase}" />
              <MenuItem x:Name="TreeCreateBranchMenuItem" Header="Create _branch..." Icon="{local:UpstreamIcon Branch}" />
              <MenuItem x:Name="TreeResetMenuItem" Header="Re_set current branch to here..." Icon="{local:UpstreamIcon ResetCurrentBranchToHere}"
                        ToolTip.Tip="Reset current branch to here" />
              <Separator />
              <MenuItem x:Name="TreeRenameBranchMenuItem" Header="R_ename branch..." Icon="{local:UpstreamIcon Renamed}"
                        ToolTip.Tip="Rename this branch" />
              <MenuItem x:Name="TreeDeleteMenuItem" Icon="{local:UpstreamIcon BranchDelete}" />
              <!-- The new shell's: upstream deletes a remote tag from its push dialog, which the new shell does not have. -->
              <MenuItem x:Name="TreeDeleteRemoteTagMenuItem" Header="Delete on _remote..." Icon="{local:UpstreamIcon BranchDelete}" />
              <Separator />
              <MenuItem x:Name="TreeAddRemoteMenuItem" Header="_Add remote..." Icon="{local:UpstreamIcon Remotes}" />
              <MenuItem x:Name="TreeFetchAllRemotesMenuItem" Header="Fetch all remotes" Icon="{local:UpstreamIcon PullFetchAll}" />
              <MenuItem x:Name="TreePruneAllRemotesMenuItem" Header="Fetch and prune all remotes" Icon="{local:UpstreamIcon PullFetchPruneAll}" />
              <Separator />
              <MenuItem x:Name="TreeRenameRemoteMenuItem" Header="Re_name..." Icon="{local:UpstreamIcon Remotes}" />
              <MenuItem x:Name="TreeSetRemoteUrlMenuItem" Header="Set _URL..." Icon="{local:UpstreamIcon Remotes}" />
              <MenuItem x:Name="TreeRemoveRemoteMenuItem" Header="Re_move..." Icon="{local:UpstreamIcon Remotes}" />
              <MenuItem x:Name="TreeFetchRemoteMenuItem" Header="_Fetch" Icon="{local:UpstreamIcon PullFetch}" />
              <MenuItem x:Name="TreePruneRemoteMenuItem" Header="Fetch and _prune" Icon="{local:UpstreamIcon PullFetchPrune}" />
              <MenuItem x:Name="TreeOpenRemoteUrlMenuItem" Header="Open remote Url" Icon="{local:UpstreamIcon Globe}"
                        ToolTip.Tip="Redirects you to the actual repository page" />
              <Separator />
              <MenuItem x:Name="TreeOpenSubmoduleMenuItem" Header="_Open" Icon="{local:UpstreamIcon FolderOpen}"
                        ToolTip.Tip="Open selected submodule" />
              <MenuItem x:Name="TreeOpenSubmoduleNewInstanceMenuItem" Header="O_pen" Icon="{local:UpstreamIcon GitExtensionsLogo16}"
                        ToolTip.Tip="Open selected submodule in a new instance" />
              <MenuItem x:Name="TreeUpdateSubmoduleMenuItem" Header="_Update" Icon="{local:UpstreamIcon SubmodulesUpdate}"
                        ToolTip.Tip="Update selected submodule recursively" />
              <MenuItem x:Name="TreeSynchronizeSubmoduleMenuItem" Header="Synchronize" Icon="{local:UpstreamIcon SubmodulesSync}"
                        ToolTip.Tip="Synchronize selected submodule recursively" />
              <Separator />
              <MenuItem x:Name="TreeFetchAndCheckoutMenuItem" Header="_Fetch &amp; Checkout" Icon="{local:UpstreamIcon BranchCheckout}"
                        ToolTip.Tip="Fetch then checkout this remote branch" />
              <MenuItem x:Name="TreeFetchAndMergeMenuItem" Header="Fetch &amp; Merge (_Pull)" Icon="{local:UpstreamIcon Pull}"
                        ToolTip.Tip="Fetch then merge this remote branch into current branch" />
              <MenuItem x:Name="TreeFetchAndRebaseMenuItem" Header="Fetch &amp; Re_base" Icon="{local:UpstreamIcon Rebase}"
                        ToolTip.Tip="Fetch then rebase current branch on this remote branch" />
              <MenuItem x:Name="TreeFetchAndCreateBranchMenuItem" Header="Fetc_h &amp; Create Branch" Icon="{local:UpstreamIcon Branch}"
                        ToolTip.Tip="Fetch then create a local branch from the remote branch" />
              <MenuItem x:Name="TreeFetchBranchMenuItem" Header="Fe_tch" Icon="{local:UpstreamIcon Stage}"
                        ToolTip.Tip="Fetch this remote branch" />
              <Separator />
              <MenuItem x:Name="TreeCreateBranchInFolderMenuItem" Header="Create Branch..." Icon="{local:UpstreamIcon BranchCreate}"
                        ToolTip.Tip="Create a local branch" />
              <MenuItem x:Name="TreeDeleteAllBranchesMenuItem" Header="Delete All" Icon="{local:UpstreamIcon BranchDelete}"
                        ToolTip.Tip="Delete all child branches, which must all be fully merged in its upstream branch or in HEAD" />
              <Separator />
              <MenuItem x:Name="TreeStashAllMenuItem" Header="_Stash" />
              <MenuItem x:Name="TreeStashStagedMenuItem" Header="S_tash staged" />
              <Separator />
              <MenuItem x:Name="TreeOpenStashMenuItem" Header="_Open stash" ToolTip.Tip="Open this stash" />
              <MenuItem x:Name="TreeApplyStashMenuItem" Header="_Apply stash" ToolTip.Tip="Apply this stash" />
              <MenuItem x:Name="TreePopStashMenuItem" Header="_Pop stash" ToolTip.Tip="Pop this stash" />
              <MenuItem x:Name="TreeDropStashMenuItem" Header="_Drop stash..." ToolTip.Tip="Drop this stash" />
              <Separator />
              <MenuItem x:Name="TreeCreateWorktreeMenuItem" Header="_Create worktree..." />
              <MenuItem x:Name="TreePruneWorktreesMenuItem" Header="_Prune worktrees" />
              <MenuItem x:Name="TreeManageWorktreesMenuItem" Header="_Manage worktrees..." />
              <Separator />
              <MenuItem x:Name="TreeOpenWorktreeMenuItem" Header="_Open worktree" Icon="{local:UpstreamIcon FolderOpen}"
                        ToolTip.Tip="Open this worktree" />
              <MenuItem x:Name="TreeDeleteWorktreeMenuItem" Header="_Delete worktree..." ToolTip.Tip="Delete this worktree" />
              <Separator />
              <MenuItem x:Name="TreeCopyWorktreePathMenuItem" Header="Copy _path" Icon="{local:UpstreamIcon CopyToClipboard}"
                        ToolTip.Tip="Copy the worktree path to clipboard" />
              <MenuItem x:Name="TreeShowWorktreeInFolderMenuItem" Header="Show _in folder" Icon="{local:UpstreamIcon BrowseFileExplorer}"
                        ToolTip.Tip="Show the worktree in File Explorer" />
              <Separator />
              <MenuItem x:Name="TreeCollapseMenuItem" Header="Collapse" Icon="{local:UpstreamIcon CollapseAll}" ToolTip.Tip="Collapse all subnodes" />
              <MenuItem x:Name="TreeExpandMenuItem" Header="Expand" Icon="{local:UpstreamIcon ExpandAll}" ToolTip.Tip="Expand all subnodes" />
              <Separator />
              <MenuItem x:Name="TreeMoveUpMenuItem" Header="Move Up" Icon="{local:UpstreamIcon ArrowUp}" ToolTip.Tip="Move node up" />
              <MenuItem x:Name="TreeMoveDownMenuItem" Header="Move Down" Icon="{local:UpstreamIcon ArrowDown}" ToolTip.Tip="Move node down" />
              <Separator />
              <!-- Upstream's left panel sort menus (GitRefsSortByContextMenuItem, GitRefsSortOrderContextMenuItem). -->
              <MenuItem x:Name="SortByMenuItem" Header="_Sort by" />
              <MenuItem x:Name="SortOrderMenuItem" Header="Sort _order" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="repo:RepoObjectNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="MinHeight" Value="20" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="repo:RepoObjectNode" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                <Image Source="{Binding Image, Converter={x:Static local:UpstreamImageConverter.Instance}}" Width="16" Height="16"
                       VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                           FontWeight="{Binding IsBold, Converter={x:Static local:BoldConverter.Instance}}" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2">
        <!-- Dashboard: recent repositories, shown while no repository is open (upstream's Dashboard). -->
        <!-- Upstream's Dashboard: on the window color with its background picture, a fixed left column (the logo, the Start
             links, the Contribute links at the bottom) and the repository list (UserRepositoriesList: a header with the
             title, the search box, the recent repositories and the favourites grouped by category, as tiles), with 7%
             margins on both sides. Colors as upstream's DashboardTheme, light or dark (ThemeApplier). -->
        <Grid x:Name="DashboardPanel" Background="{DynamicResource CommitInfoBackgroundBrush}">
          <Grid.Styles>
            <Style Selector="TextBlock.dashboardHeading">
              <Setter Property="FontSize" Value="19" />
              <Setter Property="Foreground" Value="{DynamicResource DashboardHeadingBrush}" />
            </Style>
            <!-- Upstream's dashboard links (LinkLabel): the image, then the text in the primary text color, the accented color
                 under the pointer, never underlined. -->
            <Style Selector="Button.dashboardLink">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="3" />
              <Setter Property="Margin" Value="3,0,3,8" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{DynamicResource DashboardPrimaryTextBrush}" />
            </Style>
            <Style Selector="Button.dashboardLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource DashboardAccentBrush}" />
            </Style>
            <Style Selector="Button.dashboardLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <!-- Upstream's repository tiles: the folder image (with a star for a repository in a category), the path, and the
                 branch below in a smaller font and the branch color; the hover color under the pointer. -->
            <Style Selector="Button.dashboardTile">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="CornerRadius" Value="0" />
              <Setter Property="Padding" Value="4,6" />
              <Setter Property="Margin" Value="0,0,2,2" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="VerticalContentAlignment" Value="Top" />
              <Setter Property="Foreground" Value="{DynamicResource DashboardPrimaryTextBrush}" />
            </Style>
            <Style Selector="Button.dashboardTile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.dashboardTile:focus /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource DashboardStartBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource DashboardPrimaryTextBrush}" />
            </Style>
            <Style Selector="Button.dashboardTile TextBlock.branch">
              <Setter Property="Foreground" Value="{DynamicResource DashboardBranchBrush}" />
            </Style>
            <Style Selector="TextBlock.dashboardGroup">
              <Setter Property="Foreground" Value="{DynamicResource SystemControlHyperlinkTextBrush}" />
            </Style>
          </Grid.Styles>
          <Border Background="{DynamicResource DashboardBackgroundBrush}" />
          <!-- Upstream's left column is 213 pixels for its 9-point font; here it grows with a larger font so the links fit. -->
          <Grid ColumnDefinitions="7*,Auto,86*,7*">
            <DockPanel Grid.Column="1" MinWidth="213">
              <Border DockPanel.Dock="Top" Height="68" Background="{DynamicResource DashboardLogoBrush}" Padding="14,15,14,9">
                <Image Source="{local:UpstreamImage GitExtensionsLogoWide}" Width="185" Height="44" Stretch="Uniform"
                       HorizontalAlignment="Left" />
              </Border>
              <Border DockPanel.Dock="Bottom" Background="{DynamicResource DashboardContributeBrush}" Margin="2"
                      Padding="20,20,20,30">
                <StackPanel x:Name="DashboardContribute">
                  <TextBlock Classes="dashboardHeading" Text="Contribute" Margin="2,0,2,8" />
                  <Button x:Name="DashboardDevelopLink" Classes="dashboardLink" Tag="Develop" Content="Develop" />
                  <Button x:Name="DashboardDonateLink" Classes="dashboardLink" Tag="DollarSign" Content="Donate" />
                  <Button x:Name="DashboardTranslateLink" Classes="dashboardLink" Tag="Translate" Content="Translate" />
                  <Button x:Name="DashboardIssuesLink" Classes="dashboardLink" Tag="Bug" Content="Issues" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource DashboardStartBrush}" Margin="2" Padding="20">
                <StackPanel x:Name="DashboardStart">
                  <Button x:Name="DashboardCreateLink" Classes="dashboardLink" Tag="RepoCreate" Content="Create new repository" />
                  <Button x:Name="DashboardOpenLink" Classes="dashboardLink" Tag="RepoOpen" Content="Open repository" />
                  <Button x:Name="DashboardCloneLink" Classes="dashboardLink" Tag="CloneRepoGit" Content="Clone repository" />
                </StackPanel>
              </Border>
            </DockPanel>
            <DockPanel Grid.Column="2" MinWidth="450">
              <Border DockPanel.Dock="Top" Height="68" Background="{DynamicResource DashboardHeaderBrush}" Padding="20,0,20,11">
                <TextBlock Classes="dashboardHeading" Text="Recent repositories" VerticalAlignment="Bottom" />
              </Border>
              <DockPanel Margin="20,18,20,3">
                <TextBox x:Name="DashboardSearchBox" DockPanel.Dock="Top" Watermark="Search repositories..." Margin="0,0,0,12"
                         Background="{DynamicResource DashboardSearchBrush}" />
                <ScrollViewer>
                  <StackPanel x:Name="DashboardGroups" Spacing="8" />
                </ScrollViewer>
              </DockPanel>
            </DockPanel>
          </Grid>
        </Grid>

        <Grid x:Name="BrowsePanel" RowDefinitions="*,5,300" IsVisible="False">
          <!-- Upstream's RevisionsSplitContainer: the grid, and the commit info beside it when CommitInfoPosition puts it
               left or right of the grid (LayoutRevisionInfo sets the columns). -->
          <Grid x:Name="RevisionsSplitGrid" Grid.Row="0" ColumnDefinitions="*,0,0">
            <Grid x:Name="RevisionGridContainer" Grid.Column="0" RowDefinitions="Auto,*">
              <ListBox x:Name="CommitList" Grid.Row="1">
                <!-- Upstream's RevisionDataGridView rows: no hover color, every other row a shade darker
                     (RevisionGraphDrawAlternateBackColor), the selected commit's author's rows tinted (HighlightAuthoredRevisions),
                     the selection in the system highlight with its text color, or in InactiveSelectionHighlight while the grid
                     has no focus, and the commit body in the gray text color. Later styles win. -->
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="22" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBox.alternate ListBoxItem:nth-child(2n+1) /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
                  </Style>
                  <Style Selector="ListBoxItem.authored /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AuthoredHighlightBrush}" />
                  </Style>
                  <Style Selector="TextBlock.commitBody">
                    <Setter Property="Foreground" Value="{DynamicResource GridBodyBrush}" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource GridSelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource GridSelectionTextBrush}" />
                  </Style>
                  <Style Selector="ListBoxItem:selected TextBlock.commitBody">
                    <Setter Property="Foreground" Value="{DynamicResource GridSelectionTextBrush}" />
                    <Setter Property="Opacity" Value="0.75" />
                  </Style>
                  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource GridInactiveSelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                  </Style>
                  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected TextBlock.commitBody">
                    <Setter Property="Foreground" Value="{DynamicResource GridBodyBrush}" />
                    <Setter Property="Opacity" Value="1" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="CommitContextMenu">
                    <!-- Upstream's bisect items, at the top and shown only while a bisect runs. -->
                    <MenuItem x:Name="MarkBadMenuItem" Header="Mark revision as bad" IsVisible="False" />
                    <MenuItem x:Name="MarkGoodMenuItem" Header="Mark revision as good" IsVisible="False" />
                    <MenuItem x:Name="BisectSkipMenuItem" Header="Skip revision" IsVisible="False" />
                    <MenuItem x:Name="StopBisectMenuItem" Header="Stop bisect" IsVisible="False" />
                    <Separator x:Name="BisectSeparator" IsVisible="False" />
                    <MenuItem x:Name="CopyHashMenuItem" Header="Copy commit hash" />
                    <MenuItem x:Name="CopyMessageMenuItem" Header="Copy commit message" />
                    <Separator />
                    <MenuItem x:Name="CreateBranchHereMenuItem" Header="Create branch here..." />
                    <MenuItem x:Name="CreateTagHereMenuItem" Header="Create tag here..." />
                    <MenuItem x:Name="BrowseFilesHereMenuItem" Header="Browse files at this commit..." />
                    <MenuItem x:Name="CheckoutCommitMenuItem" Header="Checkout this commit (detached HEAD)" />
                    <Separator />
                    <MenuItem x:Name="CherryPickMenuItem" Header="Cherry-pick this commit" />
                    <MenuItem x:Name="RevertMenuItem" Header="Revert this commit" />
                    <MenuItem x:Name="RunScriptMenuItem" Header="Run script" />
                    <MenuItem x:Name="OpenBuildReportMenuItem" Header="View _build report in a browser" />
                    <MenuItem x:Name="OpenPullRequestPageMenuItem" Header="Vie_w pull request in a browser" />
                    <MenuItem Header="Rebase current branch on">
                      <MenuItem x:Name="RebaseOnCommitMenuItem" Header="Selected commit" />
                      <MenuItem x:Name="RebaseInteractiveMenuItem" Header="Selected commit interactively..." />
                    </MenuItem>
                    <MenuItem Header="Reset current branch to here">
                      <MenuItem x:Name="ResetSoftMenuItem" Header="Soft: keep index and working tree" />
                      <MenuItem x:Name="ResetMixedMenuItem" Header="Mixed: keep working tree, reset index" />
                      <MenuItem x:Name="ResetHardMenuItem" Header="Hard: discard all changes..." />
                    </MenuItem>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <!-- Upstream's columns in its order (graph, message, avatar, author, date, SHA-1, build status), each shown as the
                       View menu's Columns say (MainWindow.GridView sets the Show*Column resources). -->
                  <DataTemplate x:DataType="core:CommitListItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                      <local:GraphCell Grid.Column="0" Graph="{Binding Graph}" VerticalAlignment="Stretch"
                                       IsVisible="{DynamicResource ShowGraphColumn}" />
                      <!-- Upstream's MessageColumnProvider: the ref labels, the fixup marker, the subject (bold for the checked-out
                           commit) and the body in gray; an artificial row's label and its change counts. -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"
                                  Background="Transparent" ToolTip.Tip="{Binding Row.Tooltip.Message}">
                        <ItemsControl Classes="refLabels" ItemsSource="{Binding GridLabels}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:GridLabel">
                              <local:RefLabelView Label="{Binding}" Fill="{DynamicResource FillRefLabels}"
                                                  IsRowSelected="{Binding $parent[ListBoxItem].IsSelected}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Changes.Parts, FallbackValue={x:Null}}" Margin="1,0,0,0" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:ArtificialChangePart">
                              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,4,0">
                                <Image Source="{Binding Image, Converter={x:Static local:UpstreamImageConverter.Instance}}" Width="12" Height="12"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" MinWidth="14" VerticalAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Image Source="{local:UpstreamImage FixupAndSquashMessageMarker}" Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" IsVisible="{Binding IsFixup}" />
                        <TextBlock Text="{Binding Row.Subject}" VerticalAlignment="Center" IsVisible="{Binding !IsArtificial}"
                                   FontWeight="{Binding IsCheckedOut, Converter={x:Static local:BoldConverter.Instance}}" />
                        <TextBlock Classes="commitBody" Text="{Binding BodyText}" VerticalAlignment="Center"
                                   FontWeight="{Binding IsCheckedOut, Converter={x:Static local:BoldConverter.Instance}}" />
                      </StackPanel>
                      <local:AvatarView Grid.Column="2" Classes="gridAvatar" Width="16" Height="16" ImageSize="32" Margin="0,0,4,0"
                                        VerticalAlignment="Center" IsVisible="{DynamicResource ShowAuthorAvatarColumn}"
                                        Email="{Binding Row.AuthorEmail}" AuthorName="{Binding Row.Author}" />
                      <TextBlock Grid.Column="3" Width="150" Margin="0,0,6,0" Text="{Binding Row.Author}" ToolTip.Tip="{Binding Row.Tooltip.Author}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{DynamicResource ShowAuthorNameColumn}" />
                      <TextBlock Grid.Column="4" Width="134" Margin="0,0,6,0" Text="{Binding Row.Date}" ToolTip.Tip="{Binding Row.Tooltip.Date}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{DynamicResource ShowDateColumn}" />
                      <TextBlock Grid.Column="5" Width="84" Text="{Binding Row.ShortHash}" ToolTip.Tip="{Binding Row.Tooltip.Hash}"
                                 FontFamily="{DynamicResource MonospaceFontFamily}" FontWeight="{DynamicResource MonospaceFontWeight}"
                                 FontStyle="{DynamicResource MonospaceFontStyle}" FontSize="{DynamicResource MonospaceFontSize}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{DynamicResource ShowObjectIdColumn}" />
                      <!-- Upstream's build status cell: the symbol and/or the description in the status color; a click opens the
                           build report. -->
                      <StackPanel Grid.Column="6" Classes="buildStatus" Orientation="Horizontal" Spacing="4" ClipToBounds="True"
                                  Background="Transparent" Width="{DynamicResource BuildStatusColumnWidth}"
                                  ToolTip.Tip="{Binding Build.Tooltip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Build.Symbol}" IsVisible="{DynamicResource BuildStatusShowIcon}"
                                   Foreground="{Binding Build.Status, Converter={x:Static local:BuildStatusBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Build.Text}" IsVisible="{DynamicResource BuildStatusShowText}" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Build.Status, Converter={x:Static local:BuildStatusBrushConverter.Instance}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- Upstream's quick search label: what was typed into the grid, red when nothing matches. -->
              <Border x:Name="QuickSearchPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="7,5,5,5" IsHitTestVisible="False">
                <TextBlock x:Name="QuickSearchText" FontWeight="Bold" FontSize="14" />
              </Border>
            </Grid>
            <GridSplitter x:Name="RevisionInfoSplitter" Grid.Column="1" ResizeDirection="Columns" IsVisible="False" />
            <Border x:Name="RevisionInfoHost" Grid.Column="2" IsVisible="False" Padding="0,4,0,0" />
          </Grid>

          <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

          <TabControl x:Name="DetailTabs" Grid.Row="2" Padding="0,4,0,0">
            <TabItem x:Name="CommitInfoTab">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <Image Source="{local:UpstreamImage CommitSummary}" />
                  <TextBlock Text="Commit" />
                </StackPanel>
              </TabItem.Header>
              <!-- Upstream's RevisionInfo (CommitInfo): in this tab, or beside the grid (RevisionInfoHost). On the window color:
                   the header (CommitInfoHeader: the avatar and the author, date, hash, child and parent lines), the message on
                   a slightly darker panel, then the annotated tags' messages, related links, branches and tags containing the
                   commit, and the tag it derives from. Links select commits or open addresses. -->
              <ScrollViewer x:Name="RevisionInfo" Background="{DynamicResource CommitInfoBackgroundBrush}"
                            HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.ContextMenu>
                  <ContextMenu x:Name="CommitInfoContextMenu">
                    <MenuItem x:Name="CopyCommitInfoLinkMenuItem" Header="Copy link" IsVisible="False" />
                    <MenuItem x:Name="CopyCommitInfoMenuItem" Header="_Copy commit info" />
                    <Separator />
                    <MenuItem x:Name="ShowContainedInBranchesMenuItem" Header="Show local branches containing this commit" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowContainedInBranchesRemoteMenuItem" Header="Show remote branches containing this commit" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowContainedInBranchesRemoteIfNoLocalMenuItem" Header="Show remote branches only when no local branch contains this commit" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowContainedInTagsMenuItem" Header="Show tags containing this commit" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowAnnotatedTagsMessagesMenuItem" Header="Show messages of annotated tags" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowDerivesFromTagMenuItem" Header="Show the most recent tag this commit derives from" ToggleType="CheckBox" />
                  </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel x:Name="RevisionInfoPanel">
                  <DockPanel Margin="8,8,16,8">
                    <!-- Upstream's commit info avatar (ShowAuthorAvatarInCommitInfo), 80 pixels as upstream asks. -->
                    <local:AvatarView x:Name="DetailAvatar" DockPanel.Dock="Left" Width="80" Height="80" ImageSize="80"
                                      VerticalAlignment="Top" Margin="0,0,8,0" IsVisible="False" />
                    <Grid x:Name="DetailHeader" ColumnDefinitions="Auto,*" />
                  </DockPanel>
                  <Border x:Name="DetailMessagePanel" Background="{DynamicResource CommitMessageBackgroundBrush}">
                    <local:InfoTextBlock x:Name="DetailMessage" Margin="8" TextWrapping="Wrap"
                                         FontFamily="{DynamicResource CommitFontFamily}" FontWeight="{DynamicResource CommitFontWeight}"
                                         FontStyle="{DynamicResource CommitFontStyle}" FontSize="{DynamicResource CommitFontSize}" />
                  </Border>
                  <local:InfoTextBlock x:Name="DetailRevisionInfo" Margin="8,8,16,8" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DiffTab">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <Image Source="{local:UpstreamImage Diff}" />
                  <TextBlock Text="Diff" />
                </StackPanel>
              </TabItem.Header>
              <Grid ColumnDefinitions="300,5,*">
                <DockPanel Grid.Column="0" LastChildFill="True">
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <!-- Upstream's list of all diff tools (difftools.showavailable). -->
                    <Button x:Name="CommitDiffToolChoiceButton" DockPanel.Dock="Right" Content="&#x25BE;" Padding="4,2"
                            ToolTip.Tip="Open in another diff tool" IsEnabled="{Binding #CommitDiffToolButton.IsEnabled}" />
                    <Button x:Name="CommitDiffToolButton" Content="Open in diff tool" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Show the selected file's change in the diff tool configured in Settings (diff.tool)" />
                  </DockPanel>
                  <Button x:Name="ShowCommitDiffButton" DockPanel.Dock="Bottom" Content="Open in window" Margin="0,4,0,0"
                          ToolTip.Tip="Show the selected file's diff in its own window" />
                  <ListBox x:Name="CommitFilesList">
                    <!-- Upstream's file list menu: the user scripts, those shown in file lists directly. -->
                    <ListBox.ContextMenu>
                      <ContextMenu x:Name="CommitFilesContextMenu">
                        <MenuItem x:Name="CommitFilesRunScriptMenuItem" Header="Run script" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:CommitFile">
                        <!-- The path follows upstream's "Truncate long filenames" (FilePathTrimming). -->
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Margin="0,0,4,0" />
                          <TextBlock Text="{Binding Path, Converter={x:Static local:FilePathTrimming.Text}}"
                                     TextTrimming="{DynamicResource FilePathTrimming}" ToolTip.Tip="{Binding Path}" />
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <local:DiffView x:Name="CommitDiff" Grid.Column="2" />
              </Grid>
            </TabItem>
            <TabItem x:Name="FileTreeTab">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <Image Source="{local:UpstreamImage FileTree}" />
                  <TextBlock Text="File tree" />
                </StackPanel>
              </TabItem.Header>
              <Grid ColumnDefinitions="300,5,*">
                <TreeView x:Name="FileTreeView" Grid.Column="0">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="core:FileTreeNode" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <local:DiffView x:Name="FileContentView" Grid.Column="2" />
              </Grid>
            </TabItem>
            <!-- Upstream's GPG tab (RevisionGpgInfoControl), shown for real commits while ShowGpgInformation is on: the
                 commit's signature and, when the commit has tags, theirs, each with upstream's status image. -->
            <TabItem x:Name="GpgInfoTab" IsVisible="False">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <Image Source="{local:UpstreamImage Key}" />
                  <TextBlock Text="GPG" />
                </StackPanel>
              </TabItem.Header>
              <Grid x:Name="GpgInfo" ColumnDefinitions="38,*" RowDefinitions="*,*">
                <Image x:Name="CommitSignImage" Width="32" Height="32" VerticalAlignment="Top" Margin="0,3" />
                <TextBox x:Name="CommitGpgText" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent" />
                <Image x:Name="TagSignImage" Grid.Row="1" Width="32" Height="32" VerticalAlignment="Top" Margin="0,3" />
                <TextBox x:Name="TagGpgText" Grid.Row="1" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" BorderThickness="0" Background="Transparent" />
              </Grid>
            </TabItem>
            <!-- Upstream's build report tab (BuildReportTabPageExtension), shown when the repository's "Show build result
                 page" is on and the selected commit's build has a report. Upstream embeds a browser for some servers; the
                 new shell has none, so it shows upstream's "Open report" link, as upstream does for the other servers. -->
            <TabItem x:Name="BuildReportTab" Header="Build Report" IsVisible="False">
              <HyperlinkButton x:Name="OpenBuildReportLink" Content="Open report" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
