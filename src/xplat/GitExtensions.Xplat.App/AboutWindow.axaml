<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.Platform"
        x:Class="GitExtensions.Xplat.App.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title=" "
        Width="601" SizeToContent="Height" MinHeight="318" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormAbout: the logo, "get involved" and the donate badge on the left; the product name and description,
       the team, the contributor thanked this second, the icons' credit, the environment information with its copy
       button between two lines, and the warranty note on the right. Bound to AboutViewModel (PLAN.md principle 6). -->
  <DockPanel>
    <StackPanel x:Name="flowLayoutPanel1" DockPanel.Dock="Left" Width="157">
      <Image x:Name="logoPictureBox" Width="128" Height="128"
             Margin="12" Stretch="Uniform" />
      <TextBlock x:Name="label2" Text="Git Extensions is open source. Get involved!" TextWrapping="Wrap"
                 TextAlignment="Center" MaxWidth="133" Margin="12,4" />
      <Button x:Name="pictureDonate" Width="145" Height="32" Margin="6,12,6,4" Padding="0" Background="Transparent"
              BorderThickness="0" Cursor="Hand">
        <Image Source="{local:UpstreamImage DonateBadge}" Stretch="Uniform" />
      </Button>
    </StackPanel>
    <StackPanel x:Name="tableLayoutPanel1" Margin="12,24,12,12">
      <HyperlinkButton x:Name="_NO_TRANSLATE_labelProductName" HorizontalAlignment="Center" Padding="0"
                       FontSize="16" FontWeight="Bold" Content="{Binding ProductName}" />
      <TextBlock x:Name="_NO_TRANSLATE_labelProductDescription" HorizontalAlignment="Center" FontWeight="Bold"
                 FontSize="11" Text="Visual Studio and Shell Explorer Extensions for Git" />
      <TextBlock x:Name="_NO_TRANSLATE_labelCopyright" Margin="0,8,0,0" Text="Proudly presented by Git Extensions team" />
      <HyperlinkButton x:Name="_NO_TRANSLATE_ThanksTo" Padding="0" FontSize="11" HorizontalAlignment="Left">
        <TextBlock x:Name="ThanksToText" TextTrimming="CharacterEllipsis" Text="{Binding ThanksText}" />
      </HyperlinkButton>
      <HyperlinkButton x:Name="linkLabelIcons" Padding="0" FontSize="11" HorizontalAlignment="Left"
                       Content="Some icons by Yusuke Kamiyamane (CCA3)" />
      <DockPanel x:Name="environmentInfo" Margin="3,12,3,4">
        <Separator x:Name="lblSeparatorTop" DockPanel.Dock="Top" Margin="0" />
        <Separator x:Name="lblSeparatorBottom" DockPanel.Dock="Bottom" Margin="0" />
        <Button x:Name="copyButton" DockPanel.Dock="Right" Width="25" Height="26" Padding="0" VerticalAlignment="Top"
                Margin="6,3,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Image Source="{local:UpstreamImage CopyToClipboard}" Width="16" Height="16" />
        </Button>
        <SelectableTextBlock x:Name="environmentIssueInfo" Margin="8,2,0,2" TextWrapping="Wrap" Text="{Binding EnvironmentInfo}" />
      </DockPanel>
      <TextBlock x:Name="label1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"
                 Text="This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY of FITNESS FOR A PARTICULAR PURPOSE." />
    </StackPanel>
  </DockPanel>
</Window>
