<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.AskPassWindow"
        Title="Git Extensions"
        Width="480" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterScreen" Topmost="True">
  <!-- Mirrors upstream's native GitExtSshAskPass dialog: git's or ssh's prompt, one answer, OK and Cancel. -->
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
    <TextBox x:Name="AnswerBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
