<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:GitExtensions.Xplat.Core.CommitHistory"
        x:Class="GitExtensions.Xplat.App.FileBrowserWindow"
        Title="Files"
        Width="960" Height="620">
  <DockPanel Margin="12" LastChildFill="True">
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Firebrick" Margin="0,0,0,8" />
    <Grid ColumnDefinitions="*,12,*">
      <DockPanel Grid.Column="0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="Files in this commit" FontWeight="Bold" VerticalAlignment="Center" />
          <Button x:Name="BlameButton" Content="Blame" IsEnabled="False" />
        </StackPanel>
        <ListBox x:Name="FileList" />
      </DockPanel>
      <DockPanel Grid.Column="2" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="History of the selected file" FontWeight="Bold" VerticalAlignment="Center" />
          <Button x:Name="ShowHistoryDiffButton" Content="Show diff" />
        </StackPanel>
        <ListBox x:Name="HistoryList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:CommitRow">
              <Grid ColumnDefinitions="90,*,160,140" Margin="4,2">
                <TextBlock Grid.Column="0" Text="{Binding ShortHash}" FontFamily="monospace" />
                <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Date}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
