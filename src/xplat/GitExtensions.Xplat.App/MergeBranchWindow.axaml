<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Xplat.App"
        xmlns:vm="using:GitExtensions.Xplat.Core.Operations"
        x:Class="GitExtensions.Xplat.App.MergeBranchWindow"
        x:DataType="vm:MergeBranchViewModel"
        Title="Merge branches"
        SizeToContent="WidthAndHeight" MinWidth="560" WindowStartupLocation="CenterOwner">
  <!-- Upstream's FormMergeBranch: the help picture on the left, the "Merge" group on the right and Merge below it. Bound
       to MergeBranchViewModel and its MergeBranchDialog (PLAN.md principle 6). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>
  <Grid Margin="9" ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
    <local:HelpImageView x:Name="HelpImage" Grid.RowSpan="2" Margin="3" />
    <HeaderedContentControl Grid.Column="1" Classes="groupBox" Header="Merge" Margin="3" MinWidth="460">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <AccessText Text="Merge branch" VerticalAlignment="Center" Margin="3,3,12,3" />
        <ComboBox x:Name="BranchesBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" Margin="3"
                  ItemsSource="{Binding Refs}" Text="{Binding Dialog.Branch, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" Text="Into current branch" VerticalAlignment="Center" Margin="3,3,12,3" />
        <TextBlock x:Name="CurrentBranchText" Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBranch}" FontWeight="Bold" VerticalAlignment="Center"
                   Margin="3" />
        <RadioButton x:Name="FastForwardRadio" Grid.Row="2" Grid.ColumnSpan="2" GroupName="FastForward"
                     IsChecked="{Binding Dialog.NoFastForward, Converter={x:Static local:EnumEqualsConverter.Instance},
                                 ConverterParameter={x:False}}"
                     Content="Keep a single branch line if possible (fast forward)" Margin="3" />
        <RadioButton x:Name="NoFastForwardRadio" Grid.Row="3" Grid.ColumnSpan="2" GroupName="FastForward"
                     IsChecked="{Binding Dialog.NoFastForward, Converter={x:Static local:EnumEqualsConverter.Instance},
                                 ConverterParameter={x:True}}"
                     Content="Always create a new merge commit" Margin="3" />
        <CheckBox x:Name="NoCommitCheck" Grid.Row="4" Grid.ColumnSpan="2" Content="Do not commit" Margin="3"
                  IsChecked="{Binding Dialog.NoCommit}" />
        <CheckBox x:Name="AdvancedCheck" Grid.Row="5" Grid.ColumnSpan="2" Content="Show advanced options" Margin="3"
                  IsChecked="{Binding Dialog.Advanced}" />
        <!-- Upstream's advancedPanel. -->
        <Grid x:Name="AdvancedPanel" Grid.Row="6" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding Dialog.Advanced}">
          <CheckBox x:Name="UseStrategyCheck" Content="Use non-default merge strategy" Margin="3"
                    IsChecked="{Binding Dialog.UseStrategy}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="3">
            <ComboBox x:Name="StrategyBox" MinWidth="120" IsVisible="{Binding Dialog.UseStrategy}"
                      ItemsSource="{x:Static vm:MergeBranchViewModel.Strategies}" SelectedItem="{Binding Dialog.Strategy}" />
            <HyperlinkButton x:Name="StrategyHelpLink" Content="Help" IsVisible="{Binding Dialog.UseStrategy}"
                             VerticalAlignment="Center" />
          </StackPanel>
          <CheckBox x:Name="SquashCheck" Grid.Row="1" Grid.ColumnSpan="2" Content="Squash commits" Margin="3"
                    IsChecked="{Binding Dialog.Squash}" IsEnabled="{Binding Dialog.CanSquash}" />
          <CheckBox x:Name="AllowUnrelatedCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="Allow unrelated histories" Margin="3"
                    IsChecked="{Binding Dialog.AllowUnrelatedHistories}" />
          <CheckBox x:Name="AddLogMessagesCheck" Grid.Row="3" Content="Add log messages" Margin="3"
                    IsChecked="{Binding Dialog.AddLogMessages}" />
          <NumericUpDown x:Name="LogMessagesCountBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1000" Increment="1"
                         FormatString="0" Width="110" HorizontalAlignment="Left" Margin="3"
                         Value="{Binding Dialog.LogMessagesCount}" IsEnabled="{Binding Dialog.AddLogMessages}" />
          <CheckBox x:Name="AddMergeMessageCheck" Grid.Row="4" Grid.ColumnSpan="2" Content="Specify merge message" Margin="3"
                    IsChecked="{Binding Dialog.AddMergeMessage}" />
          <TextBox x:Name="MergeMessageBox" Grid.Row="5" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" Height="77"
                   Text="{Binding Dialog.MergeMessage}" IsEnabled="{Binding Dialog.AddMergeMessage}" Margin="3" />
        </Grid>
      </Grid>
    </HeaderedContentControl>
    <Button x:Name="MergeButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" MinWidth="104" IsDefault="True"
            Content="_Merge" Margin="3" Command="{Binding MergeCommand}" />
  </Grid>
</Window>
