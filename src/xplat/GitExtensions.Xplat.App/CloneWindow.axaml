<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Xplat.App.CloneWindow"
        Title="Clone repository"
        Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Repository URL or local path" />
    <TextBox x:Name="UrlBox" PlaceholderText="https://github.com/owner/repo.git" />
    <TextBlock Text="Clone into folder" />
    <DockPanel LastChildFill="True">
      <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" />
      <TextBox x:Name="TargetBox" PlaceholderText="Folder to create" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Cancel" />
      <Button x:Name="CloneButton" Content="Clone" />
    </StackPanel>
  </StackPanel>
</Window>
