<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Upstream's spelling engine (externals/NetSpell.SpellChecker, a submodule), compiled unchanged as net10.0. Its only WinForms
    use is a "using System.Windows.Forms.Design;" for a designer attribute upstream does not compile; DesignerStandIns.cs gives
    that namespace a type.
  -->
  <PropertyGroup>
    <UpstreamDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'externals', 'NetSpell.SpellChecker'))</UpstreamDir>
    <AssemblyName>SpellChecker</AssemblyName>
    <RootNamespace>NetSpell.SpellChecker</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn),1573,1591,1696,1712</NoWarn>
    <!-- Upstream's settings for this project: it does not follow the repository's style rules. -->
    <Nullable>disable</Nullable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <Import Project="..\eng\SharedSources.targets" />

  <ItemGroup>
    <!-- The repository's CommonAssemblyInfo.cs, which the shared props add, already describes the assembly. -->
    <Compile Remove="$(UpstreamDir)Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not WinForms code: the namespaces the shared xplat props add are not needed. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolboxBitmapAttribute; only an attribute, never read. -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
